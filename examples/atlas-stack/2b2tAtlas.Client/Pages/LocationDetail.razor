@page "/location/{Id:int}"
@using Atlas
@using Radzen
@using Radzen.Blazor
@using Microsoft.JSInterop
@inject _2b2tAtlas.Client.Services.LocationService LocationService
@inject _2b2tAtlas.Client.Services.HighwayService HighwayService
@inject _2b2tAtlas.Client.Services.MapRenderService MapRenderService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@implements IAsyncDisposable

<PageTitle>@(location?.Name ?? "Location") - 2b2t Atlas</PageTitle>
@if (location is not null)
{
    <HeadContent>
        <meta name="description" content="@LocationMetaDescription" />
        <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
        <link rel="canonical" href="@EntityCanonicalUrl" />
        <link rel="alternate" type="application/json" href="@($"{Http.BaseAddress}api/locations/{location.Rowid}")" title="Location API record" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="2b2t Atlas" />
        <meta property="og:title" content="@($"{location.Name} - {location.DimensionName} 2b2t Location")" />
        <meta property="og:description" content="@LocationMetaDescription" />
        <meta property="og:url" content="@EntityCanonicalUrl" />
        <meta property="og:image" content="@LocationSocialImageUrl" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content="@LocationSocialImageUrl" />
    </HeadContent>
}

<div class="loc-page">
    @if (loading)
    {
        <div class="loc-loading">
            <div class="lds-ring"><div></div><div></div><div></div><div></div></div>
        </div>
    }
    else if (location == null)
    {
        <RadzenCard class="loc-missing">
            <RadzenText TextStyle="TextStyle.H5">Location not found</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" class="rz-mt-2 rz-mb-3">
                This location may have been removed, or the link is invalid.
            </RadzenText>
            <RadzenButton Text="Back to Directory" Icon="arrow_back" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => NavigationManager.NavigateTo(""))" />
        </RadzenCard>
    }
    else
    {
        <div class="loc-header">
            <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                          Click="@GoBack" title="Back" />
            <div class="loc-title">
                <h1>@location.Name</h1>
                <RadzenBadge BadgeStyle="@DimBadge(location.Dimension)" Text="@location.DimensionName" />
            </div>
            @if (location.Dimension != 2)
            {
                <div class="loc-dimension-switch" role="group" aria-label="Map dimension">
                    <button type="button" class="@(selectedMapDimension == 0 ? "active" : "")"
                            aria-pressed="@(selectedMapDimension == 0)" @onclick="@(() => SelectMapDimension(0))">
                        Overworld
                    </button>
                    <button type="button" class="@(selectedMapDimension == 1 ? "active" : "")"
                            aria-pressed="@(selectedMapDimension == 1)" @onclick="@(() => SelectMapDimension(1))">
                        Nether
                    </button>
                </div>
            }
            <RadzenButton Text="Open in map" Icon="map" ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small" Click="@OpenInMap" />
        </div>

        <RadzenSplitter Orientation="Orientation.Vertical" Resize="@OnSplitterResize" class="loc-workspace">
            <RadzenSplitterPane Size="@MainPaneSize" Min="360px" Resizable="@HasBaseRenders" BarVisible="@HasBaseRenders">
        <RadzenSplitter Orientation="Orientation.Horizontal" Resize="@OnSplitterResize" class="loc-body loc-main-splitter">
            <RadzenSplitterPane Size="60%" Min="360px" Resizable="true" ResizeAriaLabel="Resize map and location details">
                <RadzenCard class="loc-map-card">
                    <div class="loc-map-wrap">
                        <div id="@InsetId" class="loc-inset-map @(showThreeD ? "loc-view-hidden" : "")"></div>
                        @if (showThreeD)
                        {
                            <section class="loc-3d-view" aria-label="3D render view">
                                @if (threeDRenderOptions.Count > 0)
                                {
                                    <div class="loc-3d-toolbar">
                                        <span class="loc-3d-label">Loaded 3D renders</span>
                                        <div class="loc-3d-tabs" role="tablist" aria-label="Visible 3D renders">
                                            @foreach (var option in threeDRenderOptions)
                                            {
                                                <button type="button" role="tab"
                                                        aria-selected="@(activeThreeDRenderId == option.RenderId)"
                                                        class="@(activeThreeDRenderId == option.RenderId ? "active" : "")"
                                                        @onclick="@(() => activeThreeDRenderId = option.RenderId)">
                                                    @option.Label
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <iframe @key="ThreeDFrameKey" id="@ThreeDFrameId" class="loc-3d-frame" src="@ActiveThreeDUrl"
                                            title="@ActiveThreeDTitle" allow="fullscreen" loading="eager"></iframe>
                                }
                                else
                                {
                                    <div class="loc-3d-empty">
                                        <RadzenIcon Icon="view_in_ar" />
                                        <strong>No finished 3D derivative is visible here yet</strong>
                                        <span>Select a rendered WDL in this viewport, or return to 2D while its 3D generation is prepared.</span>
                                    </div>
                                }
                            </section>
                        }
                        @if (mapReady)
                        {
                            <div class="loc-3d-control-wrap" title="@ThreeDControlTooltip">
                                <button type="button" class="loc-ctrl loc-3d-ctrl @(showThreeD ? "active" : "")" @onclick="ToggleThreeD"
                                        aria-pressed="@showThreeD" aria-label="@ThreeDControlTooltip"
                                        disabled="@ThreeDControlDisabled">
                                    <RadzenIcon Icon="view_in_ar" /><span>3D</span>
                                </button>
                            </div>
                            <div class="loc-map-ctrls">
                                @if (!showThreeD)
                                {
                                <button class="loc-ctrl @(showPrimaryRenderPanel ? "active" : "")" @onclick="TogglePrimaryRenderPanel"
                                        title="Primary renders">
                                    <RadzenIcon Icon="map" />
                                </button>
                                <button class="loc-ctrl @(showOthers ? "active" : "")" @onclick="ToggleOthers"
                                        title="@(showOthers ? "Hide other locations" : "Show other locations")">
                                    <RadzenIcon Icon="pin_drop" />
                                </button>
                                @if (location.Renders is { Count: > 0 })
                                {
                                    <button class="loc-ctrl @(showBaseRenders ? "active" : "")" @onclick="ToggleBaseRenders"
                                            title="@(showBaseRenders ? "Hide location renders" : "Show location renders")">
                                        <RadzenIcon Icon="layers" />
                                    </button>
                                }
                                <button class="loc-ctrl @(showHighways ? "active" : "")" @onclick="ToggleHighways"
                                        title="Highways">
                                    <RadzenIcon Icon="route" />
                                </button>
                                <button class="loc-ctrl @(showAxes ? "active" : "")" @onclick="ToggleAxes"
                                        title="Axes">
                                    <RadzenIcon Icon="grid_3x3" />
                                </button>
                                <button class="loc-ctrl @(showBorders ? "active" : "")" @onclick="ToggleBorders"
                                        title="World border">
                                    <RadzenIcon Icon="crop_square" />
                                </button>
                                <button class="loc-ctrl @(showEndPortals ? "active" : "")" @onclick="ToggleEndPortals"
                                        title="End portals">
                                    <RadzenIcon Icon="blur_circular" />
                                </button>
                                <button class="loc-ctrl @(isDay ? "" : "active")" @onclick="ToggleDay"
                                        disabled="@(!currentPrimaryRenderDayNight)"
                                        title="@(currentPrimaryRenderDayNight ? (isDay ? "Switch to night" : "Switch to day") : "Day/night not available for active primary renders")">
                                    <RadzenIcon Icon="@(isDay ? "dark_mode" : "light_mode")" />
                                </button>
                                }
                            </div>

                            @if (showPrimaryRenderPanel && !showThreeD)
                            {
                                <div class="loc-primary-render-panel">
                                    <div class="loc-primary-panel-header">
                                        <span>Primary renders</span>
                                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                      Size="ButtonSize.Small" Click="TogglePrimaryRenderPanel" />
                                    </div>
                                    <div class="loc-primary-master-row">
                                        <RadzenCheckBox @bind-Value="@showPrimaryRenders" TValue="bool"
                                                        Change="@OnPrimaryRendersChanged" Name="locPrimaryToggle" />
                                        <RadzenLabel Text="Show primary renders" Component="locPrimaryToggle" />
                                        <span class="loc-primary-count">@orderedPrimaryRenders.Count</span>
                                    </div>

                                    <div class="loc-primary-section-label">Active</div>
                                    <div class="loc-primary-order @(showPrimaryRenders ? "" : "renders-disabled")">
                                        @if (orderedPrimaryRenders.Count == 0)
                                        {
                                            <div class="loc-primary-empty">No active renders</div>
                                        }
                                        @for (var i = 0; i < orderedPrimaryRenders.Count; i++)
                                        {
                                            var renderId = orderedPrimaryRenders[i];
                                            var index = i;
                                            <div class="loc-primary-row @(primaryRenderDraggingIndex == index ? "dragging" : "")"
                                                 draggable="true"
                                                 @ondragstart="() => OnPrimaryRenderDragStart(index)"
                                                 @ondragenter="() => OnPrimaryRenderDragEnter(index)"
                                                 @ondragover:preventDefault="true"
                                                 @ondrop:preventDefault="true"
                                                 @ondragend="OnPrimaryRenderDragEnd">
                                                <RadzenIcon Icon="drag_indicator" class="loc-primary-drag" />
                                                <span class="loc-primary-label" title="@PrimaryRenderLabel(renderId)">@PrimaryRenderLabel(renderId)</span>
                                                <RadzenButton Icon="remove" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                                              Size="ButtonSize.ExtraSmall" class="loc-primary-action"
                                                              title="@($"Remove {PrimaryRenderLabel(renderId)}")"
                                                              Click="@(() => RemovePrimaryRender(renderId))" />
                                            </div>
                                        }
                                    </div>
                                    <div class="loc-primary-hint">Top layer is in front · drag to reorder</div>

                                    <div class="loc-primary-section-label loc-primary-available-label">Available</div>
                                    <div class="loc-primary-available">
                                        @if (!AvailablePrimaryRenders.Any())
                                        {
                                            <div class="loc-primary-empty">All renders are active</div>
                                        }
                                        @foreach (var render in AvailablePrimaryRenders)
                                        {
                                            <div class="loc-primary-row">
                                                <span class="loc-primary-label" title="@render.Label">@render.Label</span>
                                                <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text"
                                                              Size="ButtonSize.ExtraSmall" class="loc-primary-action"
                                                              title="@($"Add {render.Label}")" Click="@(() => AddPrimaryRender(render.Id))" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }

                        @if (insetLocationSelected && selectedInsetLocation != null && !showThreeD)
                        {
                            <div class="loc-map-popup">
                                <div class="loc-popup-header">
                                    <span>@selectedInsetLocation.Name</span>
                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                  Size="ButtonSize.Small" Click="@CloseInsetLocationInfo" />
                                </div>

                                <span class="loc-popup-badge">@selectedInsetLocation.DimensionName</span>

                                <div class="loc-popup-coords">
                                    @selectedInsetLocation.X, @selectedInsetLocation.Z
                                    @if (selectedInsetLocation.Dimension == 0)
                                    {
                                        <span class="alt">N: @(selectedInsetLocation.X / 8), @(selectedInsetLocation.Z / 8)</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(selectedInsetLocation.Description))
                                {
                                    <div class="loc-popup-desc">@DisplayText.NormalizeDescription(selectedInsetLocation.Description)</div>
                                }

                                @if (!string.IsNullOrWhiteSpace(selectedInsetLocation.Tags))
                                {
                                    <div class="loc-popup-tags">@selectedInsetLocation.Tags</div>
                                }

                                @if (selectedInsetLocation.Warps is { Count: > 0 })
                                {
                                    <div class="loc-popup-section-label">Warps</div>
                                    @foreach (var warp in selectedInsetLocation.Warps)
                                    {
                                        <div class="loc-popup-warp-row">
                                            <code>/warp @warp.Name</code>
                                            <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                          Size="ButtonSize.Small" Click="@(() => CopyText($"/warp {warp.Name}"))" title="Copy warp" />
                                        </div>
                                    }
                                }

                                @if (OrderedInsetRenders(selectedInsetLocation).Any())
                                {
                                    <div class="loc-popup-section-label">Base renders</div>
                                    <div class="loc-popup-render-choices">
                                        <button class="loc-popup-render-choice @(!HasSelectedInsetBaseRenders(selectedInsetLocation) ? "active" : "")"
                                                aria-pressed="@(!HasSelectedInsetBaseRenders(selectedInsetLocation))"
                                                @onclick="@(() => SelectInsetBaseRender(selectedInsetLocation.Rowid, null))">
                                            Off
                                        </button>
                                        @foreach (var render in OrderedInsetRenders(selectedInsetLocation))
                                        {
                                            <div class="loc-popup-render-row">
                                                <button class="loc-popup-render-choice @(IsInsetBaseRenderSelected(selectedInsetLocation, render.Id) ? "active" : "")"
                                                        aria-pressed="@(IsInsetBaseRenderSelected(selectedInsetLocation, render.Id))"
                                                        @onclick="@(() => SelectInsetBaseRender(selectedInsetLocation.Rowid, render.Id))">
                                                    <span>@(string.IsNullOrWhiteSpace(render.Name) ? $"Render {render.Id}" : render.Name)</span>
                                                    <small>@(string.IsNullOrWhiteSpace(render.WorldDownloadDate) ? "Date unknown" : render.WorldDownloadDate)</small>
                                                </button>
                                                <button type="button" class="loc-popup-render-focus"
                                                        aria-label="Show and zoom to @(string.IsNullOrWhiteSpace(render.Name) ? $"render {render.Id}" : render.Name)"
                                                        title="Show and zoom to this render's full footprint"
                                                        @onclick="@(() => FocusBaseRender(selectedInsetLocation, render))">
                                                    <RadzenIcon Icon="zoom_in" />
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <div class="loc-popup-render-hint">Select one or more.</div>
                                }

                                <div class="loc-popup-actions">
                                    <RadzenButton Text="Go to" Icon="my_location" ButtonStyle="ButtonStyle.Primary"
                                                  Size="ButtonSize.Small" Click="@GoToInsetLocation" />
                                    <RadzenButton Text="Details" Icon="open_in_new" ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.Small" Click="@OpenInsetLocationDetails" />
                                    <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                  Size="ButtonSize.Small" Click="@CopyInsetLocationCoords" title="Copy coordinates" />
                                    @if (!string.IsNullOrWhiteSpace(selectedInsetLocation.Wiki))
                                    {
                                        <a href="@selectedInsetLocation.Wiki" target="_blank" rel="noopener" class="loc-popup-link">Wiki</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(selectedInsetLocation.VideoUrl))
                                    {
                                        <a href="@selectedInsetLocation.VideoUrl" target="_blank" rel="noopener" class="loc-popup-link">Video</a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </RadzenCard>
            </RadzenSplitterPane>

            <RadzenSplitterPane Min="320px" Resizable="true">
                <RadzenCard class="loc-info-card">
                    <div class="loc-coords-grid">
                        <div class="loc-coord">
                            <span class="lc-label">X</span><span class="lc-val">@location.X</span>
                        </div>
                        @if (location.Y is int y)
                        {
                            <div class="loc-coord">
                                <span class="lc-label">Y</span><span class="lc-val">@y</span>
                            </div>
                        }
                        <div class="loc-coord">
                            <span class="lc-label">Z</span><span class="lc-val">@location.Z</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(AltCoordLabel))
                    {
                        <div class="loc-alt-coords">
                            <RadzenIcon Icon="swap_horiz" /> <strong>@AltCoordLabel</strong> @AltCoordText
                        </div>
                    }

                    <div class="loc-actions">
                        <RadzenButton Text="Copy coords" Icon="content_copy" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small" Click="@CopyCoords" />
                        @if (!string.IsNullOrWhiteSpace(location.Wiki))
                        {
                            <RadzenButton Text="Wiki" Icon="menu_book" ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small" Click="@(() => OpenLink(location.Wiki!))" />
                        }
                        @if (!string.IsNullOrWhiteSpace(location.VideoUrl))
                        {
                            <RadzenButton Text="Video" Icon="play_circle" ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small" Click="@(() => OpenLink(location.VideoUrl!))" />
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(location.Description))
                    {
                        <div class="loc-section">
                            <div class="loc-section-title">Description</div>
                            <p class="loc-desc">@DisplayText.NormalizeDescription(location.Description)</p>
                        </div>
                    }

                    @if (location.Groups is { Count: > 0 })
                    {
                        <div class="loc-section">
                            <div class="loc-section-title">Built by</div>
                            <div class="loc-groups">
                                @foreach (var group in location.Groups.OrderBy(group => group.GroupName))
                                {
                                    <a class="loc-group-link" href="@(string.IsNullOrWhiteSpace(group.GroupInteractiveUrl) ? $"group/{group.GroupId}" : group.GroupInteractiveUrl)"
                                       style="--group-color: @(string.IsNullOrWhiteSpace(group.Color) ? "#4da3ff" : group.Color)">
                                        @if (!string.IsNullOrWhiteSpace(group.LogoUrl))
                                        {
                                            <img src="@group.LogoUrl" alt="" loading="lazy" onerror="this.style.display='none'" />
                                        }
                                        <span>@group.GroupName</span><small>@group.Role</small>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(location.Tags))
                    {
                        <div class="loc-section">
                            <div class="loc-section-title">Tags</div>
                            <div class="loc-tags">
                                @foreach (var tag in location.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="loc-tag">@tag</span>
                                }
                            </div>
                        </div>
                    }

                    @if (location.Warps is { Count: > 0 })
                    {
                        <div class="loc-section">
                            <div class="loc-section-title">Archive warps (@location.Warps.Count)</div>
                            @foreach (var w in location.Warps)
                            {
                                <div class="warp-row">
                                    <a href="@(string.IsNullOrWhiteSpace(w.ApiUrl) ? $"http://127.0.0.1:5297/api/warps/{w.Id}" : w.ApiUrl)"
                                       target="_blank" rel="noopener" title="Open this warp's public API record"><code>/warp @w.Name</code></a>
                                    @if (w.IsSinglePlayerConcept)
                                    {
                                        <span class="loc-concept-badge" title="Preserved single-player concept; not a live 2b2t snapshot">Singleplayer concept</span>
                                    }
                                    <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                  Size="ButtonSize.Small" Click="@(() => CopyText($"/warp {w.Name}"))" title="Copy warp" />
                                </div>
                            }
                        </div>
                    }

                    @if (location.Attachments is { Count: > 0 })
                    {
                        <div class="loc-section">
                            <div class="loc-section-title">Attachments (@location.Attachments.Count)</div>
                            <div class="loc-gallery">
                                @foreach (var a in location.Attachments)
                                {
                                    <AttachmentCard @key="a.Id" Item="a" />
                                }
                            </div>
                        </div>
                    }

                    <div class="loc-meta">Added @location.DateAddedUtc.ToString("MMM d, yyyy") · ID @location.Rowid</div>
                </RadzenCard>
            </RadzenSplitterPane>
        </RadzenSplitter>
            </RadzenSplitterPane>

            <RadzenSplitterPane Size="@RenderPaneSize" Min="@RenderPaneMin" Max="360px"
                                Resizable="@HasBaseRenders" BarVisible="@HasBaseRenders">
                @if (HasBaseRenders)
                {
                    <RadzenCard class="loc-render-panel">
                        <div class="loc-section-title">@MapDimensionLabel renders (@OrderedRenders.Count())</div>
                        <div class="loc-render-hint">Select any combination. The latest render is selected by default.</div>
                        <div class="loc-renders">
                            <button type="button" class="loc-render loc-render-off @(selectedRenderIds.Count == 0 ? "active" : "")"
                                    aria-pressed="@(selectedRenderIds.Count == 0)"
                                    @onclick="@(() => SelectLocationRender(null))">
                                <strong>Off</strong>
                            </button>
                            @foreach (var r in OrderedRenders)
                            {
                                var renderIsSelected = showBaseRenders && selectedRenderIds.Contains(r.Id);
                                var renderDownloadUrl = r.ArchiveWarp?.WorldDownloadUrl ?? r.WorldDownloadUrl;
                                var renderDownloadLocationName = r.IsSinglePlayerConcept
                                    ? $"{location?.Name} singleplayer concept"
                                    : location?.Name;
                                var renderDownloadName = r.ArchiveWarp is { } sourceWarp
                                    ? DownloadFileNames.WorldDownload(renderDownloadLocationName, sourceWarp.Id)
                                    : DownloadFileNames.RenderWorldDownload(renderDownloadLocationName, r.Id);
                                <div class="loc-render @(renderIsSelected ? "active" : "")">
                                    <button type="button" class="loc-render-select"
                                            aria-pressed="@renderIsSelected"
                                            @onclick="@(() => SelectLocationRender(r.Id))">
                                        <span class="loc-render-checkbox @(renderIsSelected ? "checked" : "")" aria-hidden="true">
                                            <RadzenIcon Icon="@(renderIsSelected ? "check" : "")" />
                                        </span>
                                        <span class="loc-render-selection-copy">
                                            <strong>@(string.IsNullOrWhiteSpace(r.Name) ? r.Scale : r.Name)</strong>
                                            @if (r.IsSinglePlayerConcept)
                                            {
                                                <span class="loc-concept-badge">Singleplayer concept — not live 2b2t</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(r.WorldDownloadDate))
                                            {
                                                <span class="loc-render-date">@r.WorldDownloadDate</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(r.Description))
                                            {
                                                <span class="loc-render-desc">@DisplayText.NormalizeDescription(r.Description)</span>
                                            }
                                        </span>
                                    </button>
                                    <div class="loc-render-provenance">
                                        <div class="loc-render-provenance-head">
                                            <span class="loc-render-source">@RenderSourceLabel(r.Source)</span>
                                            <a class="loc-resource-api" href="@(string.IsNullOrWhiteSpace(r.ApiUrl) ? $"http://127.0.0.1:5297/api/renders/{r.Id}" : r.ApiUrl)"
                                               target="_blank" rel="noopener">Data</a>
                                            <RadzenButton Text="Zoom" Icon="zoom_in" ButtonStyle="ButtonStyle.Light"
                                                          Variant="Variant.Text" Size="ButtonSize.Small"
                                                          Click="@(() => FocusBaseRender(location!, r))"
                                                          title="Show and zoom to this render's full footprint" />
                                        </div>
                                        @if (r.ArchiveWarp is { } warp)
                                        {
                                            <div class="loc-render-warp">
                                                <code>/warp @warp.Name</code>
                                                <div class="loc-render-warp-actions">
                                                    <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                                  Size="ButtonSize.Small"
                                                                  Click="@(() => CopyRenderWarp(warp.Name))" title="Copy this render's warp" />
                                                    @if (!string.IsNullOrWhiteSpace(renderDownloadUrl))
                                                    {
                                                        <a class="loc-wdl-download" href="@renderDownloadUrl"
                                                           download="@renderDownloadName"
                                                           title="Download the preserved source world for this render"
                                                           aria-label="Download source WDL for @r.Name">
                                                            <RadzenIcon Icon="download" /><span>WDL</span>
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(renderDownloadUrl))
                                        {
                                            <div class="loc-render-warp">
                                                <span>Preserved source WDL</span>
                                                <div class="loc-render-warp-actions">
                                                    <a class="loc-wdl-download" href="@renderDownloadUrl"
                                                       download="@renderDownloadName"
                                                       title="Download the preserved source world used for this render"
                                                       aria-label="Download source WDL for @r.Name">
                                                        <RadzenIcon Icon="download" /><span>WDL</span>
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (!OrderedRenders.Any())
                            {
                                <div class="loc-render-empty">No @MapDimensionLabel.ToLowerInvariant() renders for this location.</div>
                            }
                        </div>
                    </RadzenCard>
                }
            </RadzenSplitterPane>
        </RadzenSplitter>

    }
</div>

@code {
    /// <summary>The location's row id from the route.</summary>
    [Parameter] public int Id { get; set; }

    private const string InsetId = "loc-inset-map";
    private Location? location;
    private bool loading = true;
    private IJSObjectReference? mapModule;
    private DotNetObjectReference<LocationDetail>? mapDotNetRef;
    private bool mapReady;
    private bool HasBaseRenders => location?.Renders is { Count: > 0 };
    private string MainPaneSize => HasBaseRenders ? "72%" : "100%";
    private string RenderPaneSize => HasBaseRenders ? "28%" : "0px";
    private string RenderPaneMin => HasBaseRenders ? "140px" : "0px";

    // Inset-map layer toggles (mirror the main map's defaults).
    private List<Location>? allLocations;
    private List<Location> displayedLocations = [];
    private Location? selectedInsetLocation;
    private bool insetLocationSelected;
    private int? ignoredInsetSelectionIndex;
    private readonly Dictionary<int, HashSet<int>> insetBaseRenderIds = [];
    private bool showOthers;
    private bool showHighways = true;
    private bool showAxes = true;
    private bool showBorders = true;
    private bool showEndPortals;
    private bool showBaseRenders = true;
    private bool showThreeD;
    private readonly List<ThreeDRenderOption> threeDRenderOptions = [];
    private int? activeThreeDRenderId;
    private readonly HashSet<int> selectedRenderIds = [];
    private bool isDay = true;
    private bool showPrimaryRenderPanel;
    private bool showPrimaryRenders = true;
    private bool currentPrimaryRenderDayNight = true;
    private List<PrimaryRenderInfo> primaryRenderOptions = [];
    private List<string> orderedPrimaryRenders = [];
    private int primaryRenderDraggingIndex = -1;
    private int selectedMapDimension;
    private IEnumerable<PrimaryRenderInfo> AvailablePrimaryRenders =>
        primaryRenderOptions.Where(render => !orderedPrimaryRenders.Contains(render.Id));

    private string DimName => selectedMapDimension switch { 1 => "nether", 2 => "end", _ => "overworld" };
    private string MapDimensionLabel => selectedMapDimension switch { 1 => "Nether", 2 => "End", _ => "Overworld" };
    private ThreeDRenderOption? ActiveThreeDRender =>
        threeDRenderOptions.FirstOrDefault(option => option.RenderId == activeThreeDRenderId);
    private string? ActiveThreeDUrl => ActiveThreeDRender is { } option
        ? $"{option.Url}?atlas-controls=1"
        : null;
    private string ThreeDFrameKey => $"render-{activeThreeDRenderId}";
    private string ThreeDFrameId => $"{InsetId}-bluemap";
    private string ActiveThreeDTitle => threeDRenderOptions.FirstOrDefault(option => option.RenderId == activeThreeDRenderId)?.Label is { } label
        ? $"3D view of {label}" : "3D location render";
    private bool HasSelectedBlueMapRender
    {
        get
        {
            if (location is null) return false;
            var sourceLocations = displayedLocations.Count > 0 ? displayedLocations : [location];
            return sourceLocations.Any(sourceLocation =>
                insetBaseRenderIds.TryGetValue(sourceLocation.Rowid, out var selectedIds) &&
                (sourceLocation.Renders ?? []).Any(render =>
                    selectedIds.Contains(render.Id) &&
                    render.Dimension == selectedMapDimension &&
                    !string.IsNullOrWhiteSpace(render.BlueMapPath)));
        }
    }
    private bool CanEnterThreeD => showBaseRenders && HasSelectedBlueMapRender;
    private bool ThreeDControlDisabled => !showThreeD && !CanEnterThreeD;
    private string ThreeDControlTooltip => showThreeD
        ? "Return to the 2D atlas"
        : !HasSelectedBlueMapRender
            ? "3D view unavailable: the selected render has not finished BlueMap generation yet."
            : !showBaseRenders
                ? "3D view unavailable: show a location render first."
                : "View visible selected renders in 3D";

    private string EntityCanonicalUrl => $"https://atlas.example/entities/locations/{Id}/";

    private string LocationSocialImageUrl =>
        location?.Attachments.FirstOrDefault(attachment => IsImageUrl(attachment.Path))?.Path ??
        location?.Renders.FirstOrDefault(render => !string.IsNullOrWhiteSpace(render.PreviewImagePath))?.PreviewImagePath ??
        "https://atlas.example/Images/banner_web.png";

    private string LocationMetaDescription
    {
        get
        {
            if (location is null) return "Documented 2b2t location in the public 2b2t Atlas.";
            var context = $"{location.Name} is a documented 2b2t {location.DimensionName} location at X {location.X}, Z {location.Z}.";
            var description = string.IsNullOrWhiteSpace(location.Description)
                ? context
                : $"{context} {DisplayText.CompactDescription(location.Description)}";
            return description.Length <= 160 ? description : $"{description[..157].TrimEnd()}...";
        }
    }

    private string AltCoordLabel => location?.Dimension switch
    {
        0 => "Nether:",
        1 => "Overworld:",
        _ => ""
    };

    private string AltCoordText => location?.Dimension switch
    {
        0 => $"{location.X / 8}, {location.Z / 8}",
        1 => $"{location.X * 8}, {location.Z * 8}",
        _ => ""
    };

    /// <summary>Reloads the route-selected location and resets its base-render set to the latest capture when <see cref="Id"/> changes.</summary>
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        location = await LocationService.GetLocationAsync(Id);
        selectedMapDimension = DefaultMapDimension();
        showThreeD = false;
        threeDRenderOptions.Clear();
        activeThreeDRenderId = null;
        SelectLatestLocationRender();
        insetBaseRenderIds.Clear();
        if (location is not null)
            insetBaseRenderIds[location.Rowid] = [.. selectedRenderIds];
        selectedInsetLocation = null;
        insetLocationSelected = false;
        showBaseRenders = selectedRenderIds.Count > 0;
        loading = false;
    }

    /// <summary>Imports and initializes the inset browser map once, registers world renders, and loads its location and highway overlays.</summary>
    /// <param name="firstRender">Whether this is the component's first completed render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (location == null || mapReady) return;
        mapReady = true;
        try
        {
            mapModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", MapModuleAsset.Url);
            mapDotNetRef ??= DotNetObjectReference.Create(this);
            await mapModule.InvokeVoidAsync("setApiBase", Http.BaseAddress?.ToString());
            var worldRenders = await MapRenderService.GetPublishedAsync();
            if (worldRenders.Count > 0)
                await mapModule.InvokeVoidAsync("registerWorldRenders", worldRenders);
            await mapModule.InvokeVoidAsync("initialize", InsetId, DimName, isDay, mapDotNetRef);
            await RefreshPrimaryRenders();

            await LoadLocationRenders();
            await ApplyLocationSet(focus: true);
            var highways = await HighwayService.GetHighwaysAsync();
            if (highways.Count > 0)
                await mapModule.InvokeVoidAsync("loadHighways", InsetId, highways);
            await mapModule.InvokeVoidAsync("setHighways", InsetId, showHighways);
            await mapModule.InvokeVoidAsync("setAxes", InsetId, showAxes);
            await mapModule.InvokeVoidAsync("setBorders", InsetId, showBorders);

            // Re-render so the overlay control buttons appear now the map is ready.
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Inset map failed: {ex.Message}");
        }
    }

    /// <summary>
    /// Loads either just this location (default) or every location (when
    /// "other locations" is enabled). Only re-centres the view when
    /// <paramref name="focus"/> is true (initial load); toggles preserve the
    /// user's current pan/zoom and just re-highlight this location.
    /// </summary>
    private async Task ApplyLocationSet(bool focus)
    {
        if (mapModule == null || location == null) return;

        List<Location> set;
        if (showOthers)
        {
            allLocations ??= await LocationService.GetLocationsAsync();
            var found = allLocations.FindIndex(l => l.Rowid == location.Rowid);
            // Ensure this location is present even if the list endpoint omits it.
            set = found >= 0 ? allLocations : new List<Location>(allLocations) { location };
        }
        else
        {
            set = new List<Location> { location };
        }

        var focusIndex = set.FindIndex(l => l.Rowid == location.Rowid);
        if (focusIndex < 0) focusIndex = 0;
        displayedLocations = set;
        selectedInsetLocation = null;
        insetLocationSelected = false;
        ignoredInsetSelectionIndex = focusIndex;

        var payload = set
            .Select((l, i) => new { index = i, name = l.Name, x = l.X, z = l.Z, dimension = l.Dimension, description = DisplayText.NormalizeDescription(l.Description) })
            .ToArray();

        await mapModule.InvokeVoidAsync("loadLocations", InsetId, payload);
        await mapModule.InvokeVoidAsync("setLocations", InsetId, true);
        await mapModule.InvokeVoidAsync("setEndPortals", InsetId, showEndPortals);
        if (focus)
            await mapModule.InvokeVoidAsync("focusLocation", InsetId, focusIndex, 7);
        else
            await mapModule.InvokeVoidAsync("highlightLocation", InsetId, focusIndex);
    }

    private async Task ToggleOthers()
    {
        showOthers = !showOthers;
        await ApplyLocationSet(focus: false);
        await LoadLocationRenders();
    }

    private void TogglePrimaryRenderPanel() => showPrimaryRenderPanel = !showPrimaryRenderPanel;

    private async Task RefreshPrimaryRenders()
    {
        if (mapModule == null) return;
        var result = await mapModule.InvokeAsync<PrimaryRendersResult>("getRenders", InsetId);
        primaryRenderOptions = result.Renders;
        orderedPrimaryRenders = result.Current.ToList();
        UpdatePrimaryRenderCapabilities();
    }

    private async Task AddPrimaryRender(string renderId)
    {
        if (!orderedPrimaryRenders.Contains(renderId)) orderedPrimaryRenders.Insert(0, renderId);
        await ApplyPrimaryRenders();
    }

    private async Task RemovePrimaryRender(string renderId)
    {
        orderedPrimaryRenders.Remove(renderId);
        await ApplyPrimaryRenders();
    }

    private async Task OnPrimaryRendersChanged(bool value)
    {
        showPrimaryRenders = value;
        await ApplyPrimaryRenders();
    }

    private async Task ApplyPrimaryRenders()
    {
        if (mapModule == null) return;
        await mapModule.InvokeVoidAsync("setRenders", InsetId,
            showPrimaryRenders ? orderedPrimaryRenders : Array.Empty<string>());
        UpdatePrimaryRenderCapabilities();
    }

    private void UpdatePrimaryRenderCapabilities()
    {
        currentPrimaryRenderDayNight =
            showPrimaryRenders && orderedPrimaryRenders.Any(renderId =>
                primaryRenderOptions.FirstOrDefault(render => render.Id == renderId)?.DayNight == true) ||
            showBaseRenders && (location?.Renders ?? []).Any(render => selectedRenderIds.Contains(render.Id) && render.HasDayNight);
    }

    private void OnPrimaryRenderDragStart(int index) => primaryRenderDraggingIndex = index;

    private void OnPrimaryRenderDragEnter(int index)
    {
        if (primaryRenderDraggingIndex < 0 || primaryRenderDraggingIndex == index ||
            index < 0 || index >= orderedPrimaryRenders.Count) return;
        var renderId = orderedPrimaryRenders[primaryRenderDraggingIndex];
        orderedPrimaryRenders.RemoveAt(primaryRenderDraggingIndex);
        orderedPrimaryRenders.Insert(index, renderId);
        primaryRenderDraggingIndex = index;
    }

    private async Task OnPrimaryRenderDragEnd()
    {
        if (primaryRenderDraggingIndex < 0) return;
        primaryRenderDraggingIndex = -1;
        await ApplyPrimaryRenders();
    }

    private string PrimaryRenderLabel(string renderId) =>
        primaryRenderOptions.FirstOrDefault(render => render.Id == renderId)?.Label ?? renderId;

    private async Task OnSplitterResize(RadzenSplitterResizeEventArgs args)
    {
        if (mapModule != null)
            await mapModule.InvokeVoidAsync("invalidateSize", InsetId);
    }

    private async Task LoadLocationRenders()
    {
        if (mapModule == null || location == null) return;
        var sourceLocations = displayedLocations.Count > 0 ? displayedLocations : [location];
        var renders = sourceLocations
            .SelectMany(sourceLocation => (sourceLocation.Renders ?? [])
                .Where(render => insetBaseRenderIds.TryGetValue(sourceLocation.Rowid, out var selectedIds) &&
                    selectedIds.Contains(render.Id) && !string.IsNullOrWhiteSpace(render.TilesPath))
                .OrderBy(render => render.WorldDownloadDate)
                .ThenBy(render => render.Id)
                .Select(render => new
                {
                    id = render.Id,
                    locationId = sourceLocation.Rowid,
                    tilesPath = render.TilesPath,
                    x = sourceLocation.X,
                    z = sourceLocation.Z,
                    scale = render.Scale,
                    dimension = render.Dimension,
                    name = render.Name,
                    date = render.WorldDownloadDate,
                    minX = render.MinX,
                    minZ = render.MinZ,
                    maxXExclusive = render.MaxXExclusive,
                    maxZExclusive = render.MaxZExclusive,
                    maxNativeZoom = render.MaxNativeZoom,
                    coordinateScheme = render.CoordinateScheme,
                    hasDayNight = render.HasDayNight,
                }))
            .ToArray();
        await mapModule.InvokeVoidAsync("loadBaseRenders", InsetId, renders);
        await mapModule.InvokeVoidAsync("setBaseRenders", InsetId, showBaseRenders);
        if (showThreeD)
            await RefreshThreeDOptions();
    }

    private async Task ToggleThreeD()
    {
        if (!showThreeD && !CanEnterThreeD) return;
        showThreeD = !showThreeD;
        if (showThreeD)
            await RefreshThreeDOptions();
        else if (mapModule is not null)
            await mapModule.InvokeVoidAsync("invalidateSize", InsetId);
    }

    private async Task RefreshThreeDOptions()
    {
        threeDRenderOptions.Clear();
        if (mapModule is null || location is null || !showBaseRenders) return;

        var visibleIds = await mapModule.InvokeAsync<int[]>("getVisibleBaseRenderIds", InsetId);
        var visible = visibleIds.ToHashSet();
        var sourceLocations = displayedLocations.Count > 0 ? displayedLocations : [location];
        foreach (var sourceLocation in sourceLocations)
        {
            if (!insetBaseRenderIds.TryGetValue(sourceLocation.Rowid, out var selectedIds)) continue;
            foreach (var render in (sourceLocation.Renders ?? [])
                .Where(render => visible.Contains(render.Id) && selectedIds.Contains(render.Id) &&
                    render.Dimension == selectedMapDimension && !string.IsNullOrWhiteSpace(render.BlueMapPath))
                .OrderByDescending(render => render.WorldDownloadDate).ThenByDescending(render => render.Id))
            {
                var url = new Uri(Http.BaseAddress!, render.BlueMapPath!.TrimStart('/')).ToString();
                var date = string.IsNullOrWhiteSpace(render.WorldDownloadDate) ? null : $" ({render.WorldDownloadDate})";
                threeDRenderOptions.Add(new ThreeDRenderOption(
                    render.Id, $"{sourceLocation.Name}{date}", url));
            }
        }

        if (!threeDRenderOptions.Any(option => option.RenderId == activeThreeDRenderId))
            activeThreeDRenderId = threeDRenderOptions.FirstOrDefault()?.RenderId;
    }

    private async Task ToggleBaseRenders()
    {
        showBaseRenders = !showBaseRenders;
        if (mapModule != null)
            await mapModule.InvokeVoidAsync("setBaseRenders", InsetId, showBaseRenders);
        UpdatePrimaryRenderCapabilities();
        StateHasChanged();
    }

    private IEnumerable<Atlas.Locations.Render> OrderedRenders =>
        (location?.Renders ?? [])
            .Where(render => render.Dimension == selectedMapDimension)
            .OrderByDescending(render => render.WorldDownloadDate)
            .ThenByDescending(render => render.Id);

    private int DefaultMapDimension()
    {
        if (location is null) return 0;
        if ((location.Renders ?? []).Any(render => render.Dimension == location.Dimension))
            return location.Dimension;
        return (location.Renders ?? [])
            .OrderByDescending(render => render.WorldDownloadDate)
            .ThenByDescending(render => render.Id)
            .Select(render => render.Dimension)
            .FirstOrDefault(location.Dimension);
    }

    private async Task SelectMapDimension(int dimension)
    {
        if (location is null || dimension == selectedMapDimension ||
            dimension is < 0 or > 2 || location.Dimension == 2 && dimension != 2)
            return;

        selectedMapDimension = dimension;
        SelectLatestLocationRender();
        insetBaseRenderIds.Clear();
        insetBaseRenderIds[location.Rowid] = [.. selectedRenderIds];
        showBaseRenders = selectedRenderIds.Count > 0;
        if (mapModule is not null)
        {
            await mapModule.InvokeVoidAsync("setDimension", InsetId, DimName);
            await RefreshPrimaryRenders();
            await LoadLocationRenders();
            await ApplyLocationSet(focus: true);
            await mapModule.InvokeVoidAsync("setEndPortals", InsetId, showEndPortals);
        }
        UpdatePrimaryRenderCapabilities();
        StateHasChanged();
    }

    private async Task SelectLocationRender(int? renderId)
    {
        if (renderId is null)
            selectedRenderIds.Clear();
        else if (!selectedRenderIds.Add(renderId.Value))
            selectedRenderIds.Remove(renderId.Value);

        if (location is not null)
            insetBaseRenderIds[location.Rowid] = [.. selectedRenderIds];
        showBaseRenders = selectedRenderIds.Count > 0;
        await LoadLocationRenders();
        UpdatePrimaryRenderCapabilities();
    }

    private void SelectLatestLocationRender()
    {
        selectedRenderIds.Clear();
        var latestRenderId = OrderedRenders.FirstOrDefault()?.Id;
        if (latestRenderId is not null)
            selectedRenderIds.Add(latestRenderId.Value);
    }

    private IEnumerable<Atlas.Locations.Render> OrderedInsetRenders(Location selectedLocation) =>
        (selectedLocation.Renders ?? [])
            .Where(render => render.Dimension == selectedMapDimension)
            .OrderByDescending(render => render.WorldDownloadDate)
            .ThenByDescending(render => render.Id);

    private bool HasSelectedInsetBaseRenders(Location selectedLocation) =>
        insetBaseRenderIds.TryGetValue(selectedLocation.Rowid, out var renderIds) && renderIds.Count > 0;

    private bool IsInsetBaseRenderSelected(Location selectedLocation, int renderId) =>
        insetBaseRenderIds.TryGetValue(selectedLocation.Rowid, out var renderIds) && renderIds.Contains(renderId);

    private async Task SelectInsetBaseRender(int locationId, int? renderId)
    {
        if (!insetBaseRenderIds.TryGetValue(locationId, out var renderIds))
        {
            renderIds = [];
            insetBaseRenderIds[locationId] = renderIds;
        }

        if (renderId is null)
            renderIds.Clear();
        else if (!renderIds.Add(renderId.Value))
            renderIds.Remove(renderId.Value);

        if (location?.Rowid == locationId)
        {
            selectedRenderIds.Clear();
            selectedRenderIds.UnionWith(renderIds);
        }
        showBaseRenders = insetBaseRenderIds.Values.Any(selectedIds => selectedIds.Count > 0);
        await LoadLocationRenders();
        UpdatePrimaryRenderCapabilities();
    }

    private async Task FocusBaseRender(Location renderLocation, Atlas.Locations.Render render)
    {
        if (mapModule is null) return;
        if (!insetBaseRenderIds.TryGetValue(renderLocation.Rowid, out var renderIds))
        {
            renderIds = [];
            insetBaseRenderIds[renderLocation.Rowid] = renderIds;
        }
        renderIds.Add(render.Id);
        if (location?.Rowid == renderLocation.Rowid)
        {
            selectedRenderIds.Clear();
            selectedRenderIds.UnionWith(renderIds);
        }
        showBaseRenders = true;
        await LoadLocationRenders();
        UpdatePrimaryRenderCapabilities();

        await mapModule.InvokeAsync<bool>("focusBaseRender", InsetId, new
        {
            id = render.Id,
            locationId = renderLocation.Rowid,
            x = renderLocation.X,
            z = renderLocation.Z,
            scale = render.Scale,
            dimension = render.Dimension,
            minX = render.MinX,
            minZ = render.MinZ,
            maxXExclusive = render.MaxXExclusive,
            maxZExclusive = render.MaxZExclusive,
        });
    }

    [JSInvokable]
    public async Task OnLocationSelected(int index)
    {
        if (ignoredInsetSelectionIndex == index)
        {
            ignoredInsetSelectionIndex = null;
            return;
        }
        ignoredInsetSelectionIndex = null;
        if (index < 0 || index >= displayedLocations.Count) return;
        selectedInsetLocation = displayedLocations[index];
        insetLocationSelected = true;
        if (!insetBaseRenderIds.ContainsKey(selectedInsetLocation.Rowid))
        {
            var latestRenderId = OrderedInsetRenders(selectedInsetLocation).FirstOrDefault()?.Id;
            insetBaseRenderIds[selectedInsetLocation.Rowid] = latestRenderId is null ? [] : [latestRenderId.Value];
            if (latestRenderId is not null)
            {
                showBaseRenders = true;
                await LoadLocationRenders();
                UpdatePrimaryRenderCapabilities();
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnLocationDeselected()
    {
        insetLocationSelected = false;
        selectedInsetLocation = null;
        InvokeAsync(StateHasChanged);
    }

    private async Task CloseInsetLocationInfo()
    {
        insetLocationSelected = false;
        selectedInsetLocation = null;
        if (mapModule is not null)
            await mapModule.InvokeVoidAsync("clearLocationSelection", InsetId);
    }

    private async Task GoToInsetLocation()
    {
        if (mapModule is null || selectedInsetLocation is null) return;
        var x = selectedInsetLocation.X;
        var z = selectedInsetLocation.Z;
        if (selectedInsetLocation.Dimension == 0 && selectedMapDimension == 1)
        {
            x /= 8;
            z /= 8;
        }
        else if (selectedInsetLocation.Dimension == 1 && selectedMapDimension == 0)
        {
            x *= 8;
            z *= 8;
        }
        await mapModule.InvokeVoidAsync("goToCoords", InsetId, (double)x, (double)z, 8);
    }

    private async Task CopyInsetLocationCoords()
    {
        if (selectedInsetLocation is not null)
            await CopyText($"{selectedInsetLocation.X} {selectedInsetLocation.Z}");
    }

    private void OpenInsetLocationDetails()
    {
        if (selectedInsetLocation is null) return;
        if (selectedInsetLocation.Rowid == Id)
        {
            insetLocationSelected = false;
            return;
        }
        NavigationManager.NavigateTo($"location/{selectedInsetLocation.Rowid}", forceLoad: true);
    }

    private async Task ToggleHighways()
    {
        showHighways = !showHighways;
        if (mapModule != null) await mapModule.InvokeVoidAsync("setHighways", InsetId, showHighways);
    }

    private async Task ToggleAxes()
    {
        showAxes = !showAxes;
        if (mapModule != null) await mapModule.InvokeVoidAsync("setAxes", InsetId, showAxes);
    }

    private async Task ToggleBorders()
    {
        showBorders = !showBorders;
        if (mapModule != null) await mapModule.InvokeVoidAsync("setBorders", InsetId, showBorders);
    }

    private async Task ToggleEndPortals()
    {
        showEndPortals = !showEndPortals;
        if (mapModule != null) await mapModule.InvokeVoidAsync("setEndPortals", InsetId, showEndPortals);
    }

    private async Task ToggleDay()
    {
        if (!currentPrimaryRenderDayNight) return;
        isDay = !isDay;
        if (mapModule != null) await mapModule.InvokeVoidAsync("setTimeOfDay", InsetId, isDay);
    }

    /// <summary>Returns to the previous page (falls back to the directory).</summary>
    private void GoBack() => NavigationManager.NavigateTo("");

    /// <summary>Opens the full map centered on this location.</summary>
    private void OpenInMap()
    {
        if (location is null) return;
        var x = location.X;
        var z = location.Z;
        if (location.Dimension == 0 && selectedMapDimension == 1)
        {
            x /= 8;
            z /= 8;
        }
        else if (location.Dimension == 1 && selectedMapDimension == 0)
        {
            x *= 8;
            z *= 8;
        }
        NavigationManager.NavigateTo(
            $"map?dimension={DimName}&x={x}&z={z}&zoom=8");
    }

    /// <summary>Badge style for a dimension.</summary>
    private BadgeStyle DimBadge(int dim) => dim switch
    {
        1 => BadgeStyle.Danger,
        2 => BadgeStyle.Warning,
        _ => BadgeStyle.Success
    };

    private record PrimaryRenderInfo(string Id, string Label, bool DayNight);
    private sealed record ThreeDRenderOption(int RenderId, string Label, string Url);

    private record PrimaryRendersResult(List<string> Current, bool DayNight, List<PrimaryRenderInfo> Renders);

    private async Task CopyCoords()
    {
        if (location != null) await CopyText($"{location.X} {location.Z}");
    }

    private async Task CopyText(string text) =>
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);

    private Task CopyRenderWarp(string warpName) => CopyText($"/warp {warpName}");

    private static string RenderSourceLabel(string? source) => source switch
    {
        "archive-collector" => "Archive collector",
        "manual-upload" => "Manual upload",
        "wdl-ingestion" => "WDL ingestion",
        "legacy" => "Legacy render",
        _ => "Render source unknown",
    };

    private async Task OpenLink(string url) =>
        await JSRuntime.InvokeVoidAsync("open", url, "_blank");

    private static bool IsImageUrl(string? value)
    {
        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri)) return false;
        var extension = Path.GetExtension(uri.AbsolutePath);
        return extension.Equals(".png", StringComparison.OrdinalIgnoreCase) ||
            extension.Equals(".jpg", StringComparison.OrdinalIgnoreCase) ||
            extension.Equals(".jpeg", StringComparison.OrdinalIgnoreCase) ||
            extension.Equals(".gif", StringComparison.OrdinalIgnoreCase) ||
            extension.Equals(".webp", StringComparison.OrdinalIgnoreCase) ||
            extension.Equals(".avif", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Disposes the inset Leaflet map and its imported browser module when the component is removed.</summary>
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (mapModule != null)
            {
                await mapModule.InvokeVoidAsync("dispose", InsetId);
                await mapModule.DisposeAsync();
            }
            mapDotNetRef?.Dispose();
        }
        catch (JSDisconnectedException) { /* circuit already gone */ }
    }
}

