    private string ApiBase => (Http.BaseAddress ?? new Uri(NavigationManager.BaseUri)).ToString().TrimEnd('/') + "/api";

    private string OpenApiUrl => (Http.BaseAddress ?? new Uri(NavigationManager.BaseUri)).ToString().TrimEnd('/') + "/openapi/v1.json";

    private const string McpEndpoint = "http://127.0.0.1:5297/mcp";

    private const string McpRegistryUrl = "https://registry.modelcontextprotocol.io/?q=io.github.example%2F2b2t-atlas";

    private const string McpClientConfig = """
{
  "mcpServers": {
    "2b2t-atlas": {
      "type": "http",
      "url": "http://127.0.0.1:5297/mcp"
    }
  }
}
""";

    private IEnumerable<ApiTag> VisibleGroups =>
        Tags.Select(t => t with { Operations = t.Operations.Where(o => isAuthenticated || o.IsPublic).ToArray() })
            .Where(t => t.Operations.Length > 0);

    /// <summary>Determines whether the visitor is signed in so non-public endpoints can be hidden from anonymous users.</summary>
    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
    }

