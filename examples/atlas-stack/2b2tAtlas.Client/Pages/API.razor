@page "/api"
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject _2b2tAtlas.Client.Services.AuthService AuthService

<PageTitle>API - 2b2t Atlas</PageTitle>
<HeadContent>
    <meta name="description" content="Public 2b2t Atlas JSON API and MCP server documentation for locations, groups, Archive warps, bounded Minecraft worlds, renders, attachments, highways, bots, mods, LLMs, and research agents." />
    <link rel="canonical" href="https://atlas.example/api" />
</HeadContent>

<div class="api-page">
    <div class="api-heading">
        <div>
            <h1>Atlas Example API</h1>
            @if (isAuthenticated)
            {
                <p>Stable public read endpoints. Administrative writes require a JWT and the listed permission.</p>
            }
            else
            {
                <p>Stable public read endpoints returning JSON.</p>
            }
        </div>
        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="v2" />
    </div>

    <RadzenCard class="api-summary">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
            <span><strong>Base URL</strong> @ApiBase</span>
            <span><strong>Format</strong> JSON</span>
            <span><strong>Dimensions</strong> 0 Overworld · 1 Nether · 2 End</span>
            <span><strong>Schema</strong> <a href="@OpenApiUrl" target="_blank" rel="noopener">OpenAPI</a></span>
        </RadzenStack>
    </RadzenCard>

    <aside class="api-github" aria-label="Developer examples on GitHub">
        <RadzenIcon Icon="code" />
        <div>
            <strong>Building a mod, bot, map, or research tool?</strong>
            <span>Start with runnable C#, JavaScript, Python, and Fabric-oriented examples in the public developer repository.</span>
        </div>
        <a href="https://github.com/bobymicjohn/2b2tAtlas-Public-API" target="_blank" rel="noopener noreferrer">
            View GitHub examples
        </a>
    </aside>

    <section class="mcp-panel" id="mcp" aria-labelledby="mcp-heading">
        <div class="mcp-intro">
            <span class="mcp-icon" aria-hidden="true"><RadzenIcon Icon="smart_toy" /></span>
            <div>
                <span class="mcp-kicker">Agent-native access</span>
                <h2 id="mcp-heading">2b2t Atlas MCP server</h2>
                <p>
                    Connect an AI client or research agent directly to the reviewed Atlas knowledge graph.
                    The public server exposes deterministic, read-only tools for locations, nearby searches,
                    groups and their builds, highways, Archive warps, render metadata, historical capture dates,
                    and downloadable bounded WDL metadata.
                </p>
            </div>
        </div>
        <div class="mcp-facts" aria-label="MCP connection details">
            <span><strong>Endpoint</strong><code>@McpEndpoint</code></span>
            <span><strong>Registry</strong><a href="@McpRegistryUrl" target="_blank" rel="noopener noreferrer"><code>io.github.example/2b2t-atlas</code></a></span>
            <span><strong>Transport</strong>Streamable HTTP</span>
            <span><strong>Authentication</strong>None for public reads</span>
            <span><strong>Mode</strong>Stateless and read-only</span>
        </div>
        <div class="mcp-grid">
            <div>
                <h3>Client configuration</h3>
                <p>Add this remote server to any MCP client that supports Streamable HTTP:</p>
                <pre><code>@McpClientConfig</code></pre>
            </div>
            <div>
                <h3>Purpose-built research tools</h3>
                <p>
                    Start with <code>research_location</code>, <code>search_locations</code>,
                    <code>find_locations_near</code>, <code>search_groups</code>,
                    <code>get_group_builds</code>, <code>search_highways</code>, or
                    <code>find_preserved_builds</code>. Fifteen bounded tools and four URI resources
                    are discoverable through the protocol itself.
                </p>
                <p class="mcp-note">
                    WDL and render tools return metadata plus stable HTTPS URLs, never multi-megabyte
                    binary payloads inside model context. Cite the returned canonical entity URL and
                    retain original-source attribution when publishing a result.
                </p>
            </div>
        </div>
    </section>

    <div class="api-tags">
        @foreach (var tag in VisibleGroups)
        {
            <section class="api-tag">
                <div class="api-tag-head">
                    <h2>@tag.Name</h2>
                    <span>@tag.Description</span>
                </div>
                <div class="api-ops">
                    @foreach (var op in tag.Operations)
                    {
                        <details class="api-op op-@op.Method.ToLowerInvariant()">
                            <summary>
                                <span class="op-method">@op.Method</span>
                                <code class="op-path">@op.Route</code>
                                <span class="op-desc">@op.Summary</span>
                                <span class="op-auth">@(op.IsPublic ? "public" : "🔒 " + op.Permission)</span>
                            </summary>
                            <div class="op-detail">
                                @if (op.Parameters.Length > 0)
                                {
                                    <h4>Parameters</h4>
                                    <table class="op-params">
                                        <thead><tr><th>Name</th><th>In</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
                                        <tbody>
                                            @foreach (var p in op.Parameters)
                                            {
                                                <tr>
                                                    <td><code>@p.Name</code></td>
                                                    <td>@p.In</td>
                                                    <td>@p.Type</td>
                                                    <td>@(p.Required ? "required" : "optional")</td>
                                                    <td>@p.Description</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                @if (!string.IsNullOrEmpty(op.RequestBody))
                                {
                                    <h4>Request body <span class="op-ct">application/json</span></h4>
                                    <pre><code>@op.RequestBody</code></pre>
                                }
                                <h4>Responses</h4>
                                @foreach (var r in op.Responses)
                                {
                                    <div class="op-resp">
                                        <span class="op-status status-@(r.Status / 100)">@r.Status</span>
                                        <span>@r.Description</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(r.Example))
                                    {
                                        <pre><code>@r.Example</code></pre>
                                    }
                                }
                                @if (op.CanTry)
                                {
                                    <RadzenButton Icon="open_in_new" Text="Open in browser" Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Light" Click="@(() => OpenEndpoint(op.Route))" />
                                }
                            </div>
                        </details>
                    }
                </div>
            </section>
        }
    </div>

    <RadzenCard class="api-notes">
        <h2>Notes</h2>
        <ul>
            <li><code>/api/renders</code> is the dedicated collection of per-location base renders (filter by <code>locationId</code>, <code>dimension</code>, <code>scale</code>; page with <code>limit</code>/<code>offset</code>). <code>/api/maprenders</code> lists only the dimension-level primary layers, which may be empty.</li>
            <li><code>/api/maprenders/catalog</code> returns every render in one call: <code>primary</code> full-map layers and per-location <code>location</code> renders.</li>
            <li>Machine-readable schema is at <code>/openapi/v1.json</code> (OpenAPI); <code>/api</code> is a short endpoint index for discovery.</li>
            <li>Bulk WDL discovery is available as <a href="https://atlas.example/entities/world-downloads/" target="_blank" rel="noopener">crawlable HTML/JSON-LD</a> and <a href="https://atlas.example/entities/world-downloads.jsonl" target="_blank" rel="noopener">JSONL</a>. Each record links its Archive warp or preserved source render, canonical location, capture scope, checksum, metadata, ZIP, and related renders.</li>
            <li>Tile templates use <code>{z}/{y}/{x}</code>, plus <code>{dn}</code> → <code>day</code>/<code>night</code> when <code>hasDayNight</code> is true.</li>
            <li>Coordinate schemes: <code>xyz-v1</code> (standard), <code>atlas-sparse-v1</code> (signed sparse world-download tiles), <code>place-proxy</code> (2b2t.place layers, served via <code>/tiles/place/…</code>).</li>
            <li>Dimensions are <code>0</code> Overworld, <code>1</code> Nether, <code>2</code> End; the legacy <code>.php</code> query uses <code>1</code> End and <code>-1</code> Nether.</li>
            <li>Location responses include reviewed groups, warps, attachments, renders, and exact render bounds when available.</li>
            <li>Collector-backed warp records and verified pre-Archive render records advertise immutable <code>worldDownloadUrl</code> and metadata URLs. These ZIPs are playable Java-world snapshots rather than complete 2b2t worlds; clients should read each record's scope/warning and verify the SHA-256 before use.</li>
            <li>Archive concept artifacts remain available for preservation, but warp, render, WDL, and MCP records explicitly set <code>isSinglePlayerConcept=true</code>. They are offline creative builds, not evidence of a structure existing on the live 2b2t server.</li>
            <li>Entity and relationship records expose additive <code>canonicalUrl</code>, <code>interactiveUrl</code>, and <code>apiUrl</code> fields so integrations do not need to construct links.</li>
            <li>Public reads allow cross-origin requests. Every mutation requires a bearer token and the route's explicit permission; authenticated users do not receive blanket write access.</li>
            <li><a href="/nocom/">Nocom historical data</a>: <code>/api/nocom</code> supplies provenance and coverage;
                <code>/api/nocom/periods</code> exposes fixed 30-day observation aggregates;
                <code>/api/nocom/highways</code> exposes released highway activity by compass direction.
                MCP provides <code>get_nocom_dataset</code>, <code>get_nocom_periods</code> and <code>get_nocom_highway_activity</code>.
                Counts are observations, not players or visits.</li>
            <li>Waypoint exports are generated in the map UI; there are no server export endpoints.</li>
        </ul>
    </RadzenCard>
</div>

@code {
