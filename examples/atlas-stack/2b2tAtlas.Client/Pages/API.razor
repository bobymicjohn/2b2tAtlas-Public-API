    private static readonly ApiParam[] IdOnly = [new("id", "path", "integer", true, "Row identifier.")];
    private static readonly ApiParam[] NoParams = [];
    private static readonly ApiParam[] RendersQuery =
    [
        new("locationId", "query", "integer", false, "Only renders for this location."),
        new("dimension", "query", "integer", false, "0 Overworld, 1 Nether, 2 End."),
        new("scale", "query", "string", false, "Scale label, e.g. 256k."),
        new("limit", "query", "integer", false, "Max rows (default 500, max 1000)."),
        new("offset", "query", "integer", false, "Rows to skip for paging."),
    ];
    private static readonly ApiParam[] AttachmentsQuery =
    [
        new("locationId", "query", "integer", false, "Only media for this location."),
        new("mediaType", "query", "string", false, "Image, Video, Wiki, Link, Timeline, or Article."),
        new("limit", "query", "integer", false, "Max rows (default 500, max 1000)."),
        new("offset", "query", "integer", false, "Rows to skip for paging."),
    ];
    private static readonly ApiParam[] WarpsQuery =
    [
        new("locationId", "query", "integer", false, "Only Archive warps for this location."),
        new("limit", "query", "integer", false, "Max rows (default 500, max 1000)."),
        new("offset", "query", "integer", false, "Rows to skip for paging."),
    ];

    private static readonly ApiTag[] Tags =
    [
        new("Map renders", "Dimension-level layers and the combined render catalog.",
        [
            new("GET", "/api/maprenders/catalog", "Every render in one view: primary layers and per-location renders.", true, "", true,
                NoParams, [new(200, "Primary layers and location renders.", CatalogExample)]),
            new("GET", "/api/maprenders", "Published dimension-level map layers.", true, "", true,
                NoParams, [new(200, "Published layers.", MapRendersExample)]),
            new("GET", "/api/maprenders/all", "Every layer regardless of publish state.", false, "renders.manage", false,
                NoParams, [new(200, "All layers.")]),
            new("PUT", "/api/maprenders", "Register or refresh a layer (idempotent by slug).", false, "renders.manage", false,
