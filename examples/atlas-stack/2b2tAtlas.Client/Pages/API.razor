    private async Task OpenEndpoint(string route)
    {
        var baseUri = Http.BaseAddress ?? new Uri(NavigationManager.BaseUri);
        await JSRuntime.InvokeVoidAsync("open", new Uri(baseUri, route.TrimStart('/')).ToString(), "_blank");
    }

