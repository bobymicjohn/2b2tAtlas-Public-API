@code {
    /// <summary>Gets or sets the current layout theme index used to style resource descriptions.</summary>
    [CascadingParameter]
    public int themeIndex { get; set; } = 0;
    string[] themes = new string[] { "light", "dark" };

    string r1cksonUrl = "https://www.youtube.com/@rickson2b2t";
    string blizzenurl = "https://www.youtube.com/@blizzen";
    string barrendomeUrl = "https://www.youtube.com/c/barrendome";
    string dadTwokneeUrl = "https://www.youtube.com/@dadtwoknee632";
    private List<GroupExtra> groupResources = [];

    /// <summary>Loads verified group resources from the public group catalog.</summary>
    protected override async Task OnInitializedAsync()
    {
        var groups = (await GroupService.GetGroupsAsync())
            .Where(group => !string.IsNullOrWhiteSpace(group.WebsiteUrl))
            .Where(group => !group.Name.Contains("Highway Workers Union", StringComparison.OrdinalIgnoreCase))
            .OrderBy(group => group.Name)
            .ToList();

        groupResources = groups
            .Select(group => new GroupExtra(
                group.Name,
                group.WebsiteUrl!,
                group.LogoUrl ?? "./Images/atlas.webp",
                $"Official website for {group.Name}."))
            .ToList();
    }

    private Task HandleCardKeyDown(KeyboardEventArgs args, string url)
        => args.Key == "Enter" ? OpenLink(url) : Task.CompletedTask;

    private async Task OpenLink(string url)
    {
        await JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private sealed record GroupExtra(string Title, string Url, string LogoUrl, string Description);
}

