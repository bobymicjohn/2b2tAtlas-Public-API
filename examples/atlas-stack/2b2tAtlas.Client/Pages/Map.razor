@page "/map"
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using Atlas
@using System.Text
@using System.Net.Http.Json
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject _2b2tAtlas.Client.Services.LocationService LocationService
@inject _2b2tAtlas.Client.Services.HighwayService HighwayService
@inject _2b2tAtlas.Client.Services.GroupService GroupService
@inject _2b2tAtlas.Client.Services.AuthService AuthService
@inject _2b2tAtlas.Client.Services.MapRenderService MapRenderService
@implements IAsyncDisposable

<PageTitle>Map - 2b2t Atlas</PageTitle>

<div class="map-container map-theme-@MapTheme">
    <div class="map-view">
        <div id="map" class="map-display"></div>

        @if (showCrosshairs)
        {
            <div class="map-crosshair"></div>
        }

        <div class="map-toolbar">
            <button class="map-ctrl@(showSearchPanel ? " active" : "")" @onclick="ToggleSearch" title="Search & go to" aria-label="Search and go to coordinates">
                <RadzenIcon Icon="search" />
            </button>
            <button class="map-ctrl@(showLayersPanel ? " active" : "")" @onclick="ToggleLayers" title="Layers" aria-label="Map layers">
                <RadzenIcon Icon="layers" />
            </button>
            <button class="@HistoryControlClass" @onclick="ToggleHistory"
                    title="World Pulse history" aria-label="Open World Pulse history">
                <RadzenIcon Icon="history" />
            </button>
            <button class="map-ctrl@(measuring ? " active" : "")" @onclick="ToggleMeasure" title="Measure distance" aria-label="Measure distance">
                <RadzenIcon Icon="straighten" />
            </button>
            <button class="map-ctrl@(showMarkerToolPanel ? " active" : "")" @onclick="ToggleMarkerTool" title="Place markers" aria-label="Place temporary markers">
                <RadzenIcon Icon="add_location_alt" />
            </button>
            <button class="map-ctrl@(showExportPanel ? " active" : "")" @onclick="ToggleExport" title="Export waypoints" aria-label="Export waypoints">
                <RadzenIcon Icon="download" />
            </button>
            @if (canEditHighways)
            {
                <button class="map-ctrl@(editorOpen ? " active" : "")" @onclick="ToggleHighwayEditor" title="Edit highways" aria-label="Edit highways">
                    <RadzenIcon Icon="edit_road" />
                </button>
            }
            <div class="map-ctrl-gap"></div>
            <button class="map-ctrl@(currentRenderDayNight ? "" : " ctrl-off")" @onclick="ToggleDay"
                    title="@(currentRenderDayNight ? (isDay ? "Switch to night" : "Switch to day") : "Day/night not available for this render")"
                    aria-label="@(isDay ? "Switch map to night" : "Switch map to day")">
                <RadzenIcon Icon="@(isDay ? "dark_mode" : "light_mode")" />
            </button>
            <button class="map-ctrl" @onclick="ToggleFullscreen" title="Fullscreen" aria-label="Toggle fullscreen map">
                <RadzenIcon Icon="fullscreen" />
            </button>
        </div>

        <div class="map-coords">
            <span class="coord-main">@cursorText</span>
            @if (!string.IsNullOrEmpty(altCoordLabel))
            {
                <span class="coord-alt">@altCoordLabel @altCoordText</span>
            }
            <button class="coord-copy" @onclick="CopyCoords" title="Copy coordinates">
                <RadzenIcon Icon="content_copy" />
            </button>
            <button class="coord-copy" @onclick="ShareView" title="@(shareCopied ? "Link copied!" : "Copy a link to this view")">
                <RadzenIcon Icon="@(shareCopied ? "check" : "share")" />
            </button>
        </div>

        @if (showSearchPanel)
        {
            <div class="map-panel search-panel">
                <div class="panel-header">
                    <span>Search &amp; go to</span>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Size="ButtonSize.Small" Click="@(() => showSearchPanel = false)" />
                </div>
                <div class="goto-row">
                    <span class="goto-field"><label>X</label><RadzenNumeric @bind-Value="@gotoX" Style="width: 100%" /></span>
                    <span class="goto-field"><label>Z</label><RadzenNumeric @bind-Value="@gotoZ" Style="width: 100%" /></span>
                    <RadzenButton Icon="my_location" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Click="@GoToCoords" title="Go to coordinates" />
                </div>
                <input class="search-input" @bind="searchQuery" @bind:event="oninput" @bind:after="RunSearch"
                       placeholder="Name, tag, or coordinates…" autocomplete="off" />
                <div class="search-results">
                    @if (searchCoordinates is { } coordinates)
                    {
                        <button class="search-row coordinate-result" @onclick="GoToSearchCoordinates">
                            <div class="search-row-main">
                                <span class="search-name">Go to coordinates</span>
                                <span class="loc-badge">@DimensionLabel(selectedDimension)</span>
                            </div>
                            <div class="search-coords">@coordinates.X, @coordinates.Z</div>
                        </button>
                    }
                    @if (searchResults.Count == 0 && searchCoordinates is null && !string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <div class="search-empty">No matches</div>
                    }
                    @foreach (var loc in searchResults)
                    {
                        <div class="search-row" @onclick="@(() => GoToSearchResult(loc))">
                            <div class="search-row-main">
                                <span class="search-name">@loc.Name</span>
                                <span class="loc-badge">@loc.DimensionName</span>
                            </div>
                            <div class="search-coords">@loc.X, @loc.Z</div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (showLayersPanel)
        {
            <div class="map-panel layers-panel">
                <div class="panel-header">
                    <span>Layers</span>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Size="ButtonSize.Small" Click="@(() => showLayersPanel = false)" />
                </div>
                <div class="spawn-render-manager">
                    <div class="panel-row render-master-row">
                        <RadzenCheckBox @bind-Value="@showSpawnRenders" TValue="bool" Change="@OnSpawnRendersChanged" Name="srToggle" />
                        <RadzenLabel Text="Spawn renders" Component="srToggle" />
                        <span class="render-count">@orderedRenders.Count</span>
                    </div>

                    <div class="render-section-label">Active</div>
                    <div class="render-order @(showSpawnRenders ? "" : "renders-disabled")">
                        @if (orderedRenders.Count == 0)
                        {
                            <div class="render-empty">No active renders</div>
                        }
                        @for (int i = 0; i < orderedRenders.Count; i++)
                        {
                            var id = orderedRenders[i];
                            var idx = i;
                            <div class="render-order-row @(draggingIndex == idx ? "dragging" : "")"
                                 draggable="true"
                                 @ondragstart="() => OnDragStart(idx)"
                                 @ondragenter="() => OnDragEnter(idx)"
                                 @ondragover:preventDefault="true"
                                 @ondrop:preventDefault="true"
                                 @ondragend="OnDragEnd">
                                <RadzenIcon Icon="drag_indicator" class="ro-drag" />
                                <span class="ro-label" title="@RenderLabel(id)">@RenderLabel(id)</span>
                                <RadzenButton Icon="remove" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                              Size="ButtonSize.ExtraSmall" class="render-row-action"
                                              title="@($"Remove {RenderLabel(id)}")" Click="@(() => RemoveRender(id))" />
                            </div>
                        }
                    </div>
                    <div class="ro-hint">Top layer is in front · drag to reorder</div>

                    <div class="render-section-label available-label">Available</div>
                    <div class="render-available">
                        @if (!AvailableRenders.Any())
                        {
                            <div class="render-empty">All renders are active</div>
                        }
                        @foreach (var render in AvailableRenders)
                        {
                            <div class="render-available-row">
                                <span class="ro-label" title="@render.Label">@render.Label</span>
                                <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text"
                                              Size="ButtonSize.ExtraSmall" class="render-row-action"
                                              title="@($"Add {render.Label}")" Click="@(() => AddRender(render.Id))" />
                            </div>
                        }
                    </div>
                </div>
                <div class="panel-row">
                    <RadzenCheckBox @bind-Value="@showBaseRenders" TValue="bool" Change="@OnBaseRendersChanged" Name="brToggle" />
                    <RadzenLabel Text="Base renders (close-up)" Component="brToggle" />
                </div>
                <div class="panel-row">
                    <RadzenCheckBox @bind-Value="@showLocations" TValue="bool" Change="@OnLocationsChanged" Name="locToggle" />
                    <RadzenLabel Text="Locations" Component="locToggle" />
                </div>
                <div class="panel-row">
                    <RadzenCheckBox @bind-Value="@showEndPortals" TValue="bool" Change="@OnEndPortalsChanged" Name="epToggle" />
                    <RadzenLabel Text="End portals" Component="epToggle" />
                </div>
                <div class="marker-settings">
                    <div class="render-row">
                        <RadzenLabel Text="Marker icon" />
                        <RadzenDropDown @bind-Value="@markerIcon" Data="@markerIconOptions"
                                        TextProperty="Label" ValueProperty="Id" Change="@OnMarkerSettingsChanged"
                                        Style="width: 100%; margin-top: 4px;" />
                    </div>
                    <div class="render-row">
                        <RadzenLabel Text="Marker color" />
                        <RadzenDropDown @bind-Value="@markerColor" Data="@markerColorOptions"
                                        TextProperty="Label" ValueProperty="Id" Change="@OnMarkerSettingsChanged"
                                        Style="width: 100%; margin-top: 4px;" />
                    </div>
                    <div class="slider-row">
                        <RadzenLabel Text="@($"Opacity: {markerOpacity:0.00}")" />
                        <input class="marker-slider" type="range" min="0.1" max="1.0" step="0.05"
                               value="@markerOpacity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               @onchange="OnMarkerOpacityChanged" aria-label="Marker opacity" />
                    </div>
                    <div class="slider-row">
                        <RadzenLabel Text="@($"Size: {markerScale:0.00}×")" />
                        <input class="marker-slider" type="range" min="0.5" max="1.5" step="0.05"
                               value="@markerScale.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               @onchange="OnMarkerScaleChanged" aria-label="Marker size" />
                    </div>
                </div>
                <div class="panel-row">
                    <RadzenCheckBox @bind-Value="@showHighways" TValue="bool" Change="@OnHighwaysChanged" Name="hwToggle" />
                    <RadzenLabel Text="Highways" Component="hwToggle" />
                </div>
                @if (showHighways)
                {
                    <div class="slider-row">
                        <RadzenLabel Text="@($"Highway opacity: {highwayOpacity:0.00}")" />
                        <input class="marker-slider" type="range" min="0.1" max="1.0" step="0.05"
                               value="@highwayOpacity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               @oninput="OnHighwayOpacityChanged" aria-label="Highway opacity" />
                    </div>
                }
                <div class="panel-row">
                    <RadzenCheckBox @bind-Value="@showAxes" TValue="bool" Change="@OnAxesChanged" Name="axToggle" />
                    <RadzenLabel Text="Axes" Component="axToggle" />
                </div>
                <div class="panel-row">
                    <RadzenCheckBox @bind-Value="@showBorders" TValue="bool" Change="@OnBordersChanged" Name="bdToggle" />
                    <RadzenLabel Text="World borders" Component="bdToggle" />
                </div>
                @if (showBorders)
                {
                    <div class="border-legend">
                        @if (selectedDimension == "overworld")
                        {
                            <span><i class="border-key overworld"></i>Overworld ±30M</span>
                            <span><i class="border-key nether"></i>Nether ±30M (projected ±240M)</span>
                        }
                        else if (selectedDimension == "nether")
                        {
                            <span><i class="border-key overworld"></i>Overworld ±30M (projected ±3.75M)</span>
                            <span><i class="border-key nether"></i>Nether ±30M</span>
                        }
                        else
                        {
                            <span><i class="border-key overworld"></i>End ±30M</span>
                        }
                    </div>
                }
                <div class="panel-row">
                    <RadzenCheckBox @bind-Value="@showSpawnRadius" TValue="bool" Change="@OnSpawnRadiusChanged" Name="spToggle" />
                    <RadzenLabel Text="Spawn radius" Component="spToggle" />
                </div>
                <div class="panel-row">
                    <RadzenCheckBox @bind-Value="@showCrosshairs" TValue="bool" Name="chToggle" />
                    <RadzenLabel Text="Crosshairs" Component="chToggle" />
                </div>
            </div>
        }

        @if (showHistoryPanel)
        {
            <div class="map-panel history-panel">
                <div class="panel-header history-header">
                    <span>World Pulse</span>
                    <span class="history-era-badge">Nocom 2018-2021</span>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Size="ButtonSize.Small" Click="@(() => showHistoryPanel = false)" />
                </div>

                @if (nocomLoading)
                {
                    <div class="history-empty">Loading historical record...</div>
                }
                else if (nocomManifest is null)
                {
                    <div class="history-empty">
                        <span>World Pulse data could not be loaded.</span>
                        <RadzenButton Text="Retry" Icon="refresh" ButtonStyle="ButtonStyle.Info"
                                      Size="ButtonSize.Small" Click="RetryNocomManifestAsync" />
                    </div>
                }
                else
                {
                    <p class="history-intro">
                        Nocom remotely tested whether chunks were loaded. This layer shows positive observations,
                        not exact player positions.
                    </p>

                    <div class="panel-row history-master-row">
                        <RadzenCheckBox @bind-Value="@nocomEnabled" TValue="bool" Change="@OnNocomEnabledChanged" Name="nocomToggle" />
                        <RadzenLabel Text="Show World Pulse" Component="nocomToggle" />
                    </div>

                    <div class="history-mode" role="group" aria-label="World Pulse time range">
                            <button class="@(nocomShowTotal ? "" : "active")" @onclick="@(() => SetNocomTotal(false))">Period</button>
                            <button class="@(nocomShowTotal ? "active" : "")" @onclick="@(() => SetNocomTotal(true))">All time</button>
                        </div>

                        @if (!nocomShowTotal && NocomPeriods.Count > 0)
                        {
                            <div class="history-date-row">
                                <div>
                                    <strong>@CurrentNocomPeriod.Label</strong>
                                    <span>@NocomEra(CurrentNocomPeriod.StartUtc)</span>
                                </div>
                                <span>@(nocomPeriodIndex + 1) / @NocomPeriods.Count</span>
                            </div>
                            <input class="history-slider" type="range" min="0" max="@(NocomPeriods.Count - 1)" step="1"
                                   value="@nocomPeriodIndex" @oninput="OnNocomPeriodChanged" aria-label="Nocom observation period" />
                            <div class="history-playback">
                                <button @onclick="PreviousNocomPeriod" title="Previous period" aria-label="Previous period"><RadzenIcon Icon="skip_previous" /></button>
                                <button class="play" @onclick="ToggleNocomPlayback" title="@(nocomPlaying ? "Pause" : "Play timeline")"
                                        aria-label="@(nocomPlaying ? "Pause timeline" : "Play timeline")">
                                    <RadzenIcon Icon="@(nocomPlaying ? "pause" : "play_arrow")" />
                                </button>
                                <button @onclick="NextNocomPeriod" title="Next period" aria-label="Next period"><RadzenIcon Icon="skip_next" /></button>
                            </div>
                        }
                        else
                        {
                            <div class="history-total-label">
                                <strong>All observations</strong>
                                <span>Full released Nocom record</span>
                            </div>
                        }

                        <div class="history-opacity-row">
                            <label>Color style</label>
                        </div>
                        <div class="history-mode history-color-mode" role="group" aria-label="World Pulse color style">
                            <button class="@(nocomStyle == "contrast" ? "active" : "")"
                                    @onclick="@(() => SetNocomStyle("contrast"))">High contrast</button>
                            <button class="@(nocomStyle == "classic" ? "active" : "")"
                                    @onclick="@(() => SetNocomStyle("classic"))">Original heat</button>
                            <button class="@(nocomStyle == "custom" ? "active" : "")"
                                    @onclick="@(() => SetNocomStyle("custom"))">Custom color</button>
                        </div>

                        @if (nocomStyle == "custom")
                        {
                            <div class="history-color-picker-row">
                                <label for="nocomColor">Heatmap color</label>
                                <div>
                                    <input id="nocomColor" type="color" value="@CurrentNocomColor"
                                           @oninput="OnNocomColorChanged" aria-label="Custom World Pulse color" />
                                    <code>@CurrentNocomColor.ToUpperInvariant()</code>
                                </div>
                            </div>
                        }

                        <div class="history-opacity-row">
                            <label for="nocomOpacity">Layer opacity</label>
                            <span>@Math.Round(nocomOpacity * 100)%</span>
                        </div>
                        <input id="nocomOpacity" class="history-slider" type="range" min="0.1" max="1" step="0.05"
                               value="@nocomOpacity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               @oninput="OnNocomOpacityChanged" />

                    <div class="history-legend" aria-label="Observation intensity legend">
                            <div class="@HistoryGradientClass" style="@HistoryGradientStyle"></div>
                            @if (nocomStyle == "contrast")
                            {
                                <div><span>Less observed</span><span>More observed</span></div>
                            }
                            else
                            {
                                <div><span>1</span><span>100</span><span>10k</span><span>100k+</span></div>
                            }
                    </div>

                    <details class="history-method">
                        <summary>How to read this</summary>
                        <p>A brighter cell means the chunk returned more positive loaded-chunk checks during the selected 30-day period.</p>
                        <p>Scanning focused on highways, known sites, and other priorities. Dark areas may be unobserved, not empty.</p>
                        @if (nocomStyle == "contrast")
                        {
                            <p>Colors show the existing qualitative density. Chunk coverage is unchanged. Below the terrain's zoom range, a small glow keeps tiny footprints visible; it is not additional observed area.</p>
                        }
                        <a href="https://github.com/nerdsinspace/nocom-explanation" target="_blank" rel="noopener">Original technical explanation</a>
                    </details>
                }
            </div>
        }

        @if (measuring)
        {
            <div class="map-panel measure-panel">
                <div class="panel-header">
                    <span>Measure</span>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Size="ButtonSize.Small" Click="@ToggleMeasure" />
                </div>
                <div class="measure-total">@FormatDistance(measureBlocks)</div>
                <div class="panel-row">
                    <RadzenSelectBar @key="selectedDimension" @bind-Value="@measureUnit" TValue="string" Size="ButtonSize.Small">
                        <Items>
                            <RadzenSelectBarItem Text="@(selectedDimension == "nether" ? "Nether" : "Blocks")" Value="@("blocks")" />
                            <RadzenSelectBarItem Text="Chunks" Value="@("chunks")" />
                            <RadzenSelectBarItem Text="Km" Value="@("km")" />
                            @if (selectedDimension == "overworld")
                            {
                                <RadzenSelectBarItem Text="Nether" Value="@("nether")" />
                            }
                            else if (selectedDimension == "nether")
                            {
                                <RadzenSelectBarItem Text="Overworld" Value="@("overworld")" />
                            }
                        </Items>
                    </RadzenSelectBar>
                </div>
                <div class="measure-hint">@measurePointCount point(s) — click the map to add.</div>
                <RadzenButton Text="Clear" Icon="delete" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" Click="@ClearMeasure" />
            </div>
        }

        @if (showMarkerToolPanel)
        {
            <div class="map-panel marker-tool-panel">
                <div class="panel-header">
                    <span>Place markers</span>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Size="ButtonSize.Small" Click="@ToggleMarkerTool" />
                </div>
                <div class="render-row">
                    <RadzenLabel Text="Icon" />
                    <RadzenDropDown @bind-Value="@placeIcon" Data="@markerToolIcons"
                                    TextProperty="Label" ValueProperty="Id" Change="@OnPlaceIconChanged"
                                    Style="width: 100%; margin-top: 4px;" />
                </div>
                <div class="measure-hint">@customMarkerCount marker(s) — click the map to drop, drag to move, right-click to remove.</div>
                <RadzenButton Text="Clear all" Icon="delete" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" Click="@ClearCustomMarkers" Disabled="@(customMarkerCount == 0)" />
            </div>
        }

        @if (showExportPanel)
        {
            <div class="map-panel export-panel">
                <div class="panel-header">
                    <span>Export waypoints</span>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Size="ButtonSize.Small" Click="@(() => showExportPanel = false)" />
                </div>
                <div class="panel-row">
                    <RadzenCheckBox @bind-Value="@exportAllDims" TValue="bool" Name="expAll" />
                    <RadzenLabel Text="All dimensions" Component="expAll" />
                </div>
                <div class="export-count">@ExportSet().Count locations to export</div>
                <div class="export-buttons">
                    <RadzenButton Text="Xaero (.txt)" Icon="download" ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small" Click="@ExportXaero" />
                    <RadzenButton Text="CSV" Icon="download" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" Click="@ExportCsv" />
                    <RadzenButton Text="JSON" Icon="download" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" Click="@ExportJson" />
                </div>
                <div class="export-hint">Xaero: drop the .txt into your Xaero waypoints folder for the matching dimension.</div>
            </div>
        }

        @if (editorOpen)
        {
            <div class="map-panel highway-editor-panel">
                <div class="panel-header">
                    <span>@(hwEditId is null ? "New highway" : "Edit highway")</span>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Size="ButtonSize.Small" Click="@CloseHighwayEditor" />
                </div>

                <div class="editor-hint">
                    Click the map to add points. Drag a point to move it, right-click a point to remove it.
                </div>
                <div class="editor-path-row">
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{editVertexCount} point(s)")" />
                    <RadzenButton Text="Undo" Icon="undo" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Disabled="@(editVertexCount == 0)" Click="@UndoVertex" />
                    <RadzenButton Text="Clear" Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Disabled="@(editVertexCount == 0)" Click="@ClearVertices" />
                </div>

                <div class="editor-field">
                    <RadzenLabel Text="Name" />
                    <RadzenTextBox @bind-Value="@hwName" Placeholder="e.g. My Spur Highway" class="w-100" />
                </div>
                <div class="editor-grid">
                    <div class="editor-field">
                        <RadzenLabel Text="Category" />
                        <RadzenDropDown @bind-Value="@hwCategory" Data="@categoryOptions" class="w-100" />
                    </div>
                    <div class="editor-field">
                        <RadzenLabel Text="Width" />
                        <RadzenNumeric @bind-Value="@hwWidth" Min="1" Max="16" class="w-100" />
                    </div>
                    <div class="editor-field">
                        <RadzenLabel Text="Paving" />
                        <RadzenDropDown @bind-Value="@hwMaterial" Data="@materialOptions" class="w-100" />
                    </div>
                    <div class="editor-field">
                        <RadzenLabel Text="Status" />
                        <RadzenDropDown @bind-Value="@hwStatus" Data="@statusOptions" class="w-100" />
                    </div>
                    <div class="editor-field">
                        <RadzenLabel Text="Y level" />
                        <RadzenNumeric @bind-Value="@hwYLevel" class="w-100" />
                    </div>
                    <div class="editor-field">
                        <RadzenLabel Text="Color" />
                        <RadzenTextBox @bind-Value="@hwColor" Placeholder="#4da3ff" class="w-100" />
                    </div>
                </div>
                <div class="editor-field">
                    <RadzenLabel Text="Builder group" />
                    <RadzenDropDown @bind-Value="@hwBuilderGroupId" Data="@groups" TextProperty="Name" ValueProperty="Id"
                                    AllowClear="true" Placeholder="Unattributed" class="w-100" />
                </div>
                <div class="editor-field">
                    <RadzenLabel Text="Builders / maintainers" />
                    <RadzenDropDown @bind-Value="hwGroupIds" Data="@groups" TextProperty="Name" ValueProperty="Id"
                                    Multiple="true" Chips="true" AllowClear="true" class="w-100" />
                </div>
                <div class="editor-grid">
                    <div class="editor-field">
                        <RadzenLabel Text="Clearance (blocks)" />
                        <RadzenNumeric @bind-Value="hwHeight" Min="1" Max="1024" class="w-100" />
                    </div>
                    @if (hwCategory is HighwayCategory.Ring or HighwayCategory.DiamondRing)
                    {
                        <div class="editor-field">
                            <RadzenLabel Text="Ring radius (dimension blocks)" />
                            <RadzenNumeric @bind-Value="hwRingRadius" Min="1" Max="30000000" class="w-100" />
                        </div>
                    }
                </div>
                <div class="panel-row">
                    <RadzenCheckBox @bind-Value="hwLit" TValue="bool" Name="hwLit" />
                    <RadzenLabel Text="Lit" Component="hwLit" />
                </div>
                <div class="editor-checks">
                    <div class="panel-row">
