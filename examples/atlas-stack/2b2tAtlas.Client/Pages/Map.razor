                                        <div class="warp-row">
                                            <code>/warp @renderWarp.Name</code>
                                            <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                          Size="ButtonSize.Small" Click="@(() => CopyWarp(renderWarp.Name))"
                                                          title="Copy this render's warp" />
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="base-render-hint">Select any combination. The latest render is selected by default.</div>
                }

                <div class="loc-actions">
                    <RadzenButton Text="Go to" Icon="my_location" ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small" Click="@GoToSelectedLocation" />
                    <RadzenButton Text="Details" Icon="open_in_new" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@(() => NavigationManager.NavigateTo($"location/{selectedLocation.Rowid}"))" />
                    <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Size="ButtonSize.Small" Click="@CopySelectedCoords" title="Copy coordinates" />
                    @if (!string.IsNullOrWhiteSpace(selectedLocation.Wiki))
                    {
                        <a href="@selectedLocation.Wiki" target="_blank" rel="noopener" class="loc-link">Wiki</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(selectedLocation.VideoUrl))
                    {
                        <a href="@selectedLocation.VideoUrl" target="_blank" rel="noopener" class="loc-link">Video</a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
