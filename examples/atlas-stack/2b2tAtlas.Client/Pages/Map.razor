            ? "Rate-limit transition"
            : "Adaptive tracking era";

    /// <summary>Runs a ranked search over the loaded locations as the query changes.</summary>
    private void RunSearch()
    {
        var q = (searchQuery ?? "").Trim().ToLowerInvariant();
        searchCoordinates = ParseCoordinates(q);
        if (q.Length == 0) { searchResults = new(); return; }
        searchResults = allLocations
            .Select(l => (loc: l, score: ScoreLocation(l, q)))
            .Where(t => t.score > 0)
            .OrderByDescending(t => t.score)
            .ThenBy(t => t.loc.Name)
            .Take(40)
            .Select(t => t.loc)
            .ToList();
    }

    private static (int X, int Z)? ParseCoordinates(string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return null;
        var values = System.Text.RegularExpressions.Regex.Matches(query, @"-?\d+")
            .Select(match => int.TryParse(match.Value, out var value) ? (int?)value : null)
            .Where(value => value.HasValue)
            .Select(value => value!.Value)
            .ToArray();
        if (values.Length == 2) return (values[0], values[1]);
        if (values.Length == 3 && query.Contains("/tp", StringComparison.OrdinalIgnoreCase))
            return (values[0], values[2]);
        return null;
    }

