    private async Task LoadNocomManifestAsync()
    {
        nocomLoading = true;
        nocomManifest = null;
        Exception? lastError = null;
        try
        {
            using var publicHttp = new HttpClient();
            var urls = new[]
            {
                $"{NocomTileBase}/manifest.json?v={NocomManifestVersion}",
                $"{NocomTileBase}/manifest.json?v={NocomManifestVersion}&retry={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}"
            };
            foreach (var url in urls)
            {
                try
                {
                    nocomManifest = await publicHttp.GetFromJsonAsync<NocomManifest>(url);
                    if (nocomManifest is not null) break;
                }
                catch (Exception ex)
                {
                    lastError = ex;
                }
            }

            if (nocomManifest is null)
                throw lastError ?? new InvalidOperationException("The World Pulse manifest response was empty.");

            RefreshNocomPeriods();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Nocom manifest unavailable: {ex.Message}");
            nocomManifest = null;
        }
        finally
        {
            nocomLoading = false;
        }
    }

    private void RefreshNocomPeriods()
    {
        NocomPeriods = (nocomManifest?.Frames ?? new())
                .Where(frame => frame.Dimension == selectedDimension)
                .OrderBy(frame => frame.PeriodStartUtc)
                .Select(frame => new NocomPeriod(frame.Key, frame.Label, frame.PeriodStartUtc))
                .ToList();
        nocomPeriodIndex = Math.Max(0, NocomPeriods.Count - 1);
    }

    private async Task RetryNocomManifestAsync()
    {
        await LoadNocomManifestAsync();
        await ApplyNocomLayerAsync();
    }

    private async Task ApplyNocomLayerAsync()
    {
        if (!initialized || mapModule is null) return;
        if (!nocomEnabled || nocomManifest is null)
        {
            await mapModule.InvokeVoidAsync("clearNocom", MapContainerId);
            return;
        }

        NocomLayer? layer;
        if (nocomShowTotal)
        {
            layer = nocomManifest.Totals.FirstOrDefault(item => item.Dimension == selectedDimension);
        }
        else
        {
            var period = CurrentNocomPeriod.Key;
            layer = nocomManifest.Frames.FirstOrDefault(item => item.Dimension == selectedDimension && item.Key == period);
        }

        if (layer is null)
        {
            await mapModule.InvokeVoidAsync("clearNocom", MapContainerId);
            return;
        }

        var tileBase = nocomStyle == "contrast" ? NocomTileBase : NocomOriginalTileBase;
        var url = $"{tileBase}/{layer.UrlTemplate}?v={NocomManifestVersion}";
        await mapModule.InvokeVoidAsync("setNocomLayer", MapContainerId, url, layer.MaxNativeUrlZoom, nocomOpacity, nocomStyle, CurrentNocomColor);
    }

