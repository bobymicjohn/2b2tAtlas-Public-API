                    <div class="loc-desc">@DisplayText.NormalizeDescription(selectedLocation.Description)</div>
                }

                @if (!string.IsNullOrWhiteSpace(selectedLocation.Tags))
                {
                    <div class="loc-tags">@selectedLocation.Tags</div>
                }

                @if (selectedLocation.Warps is { Count: > 0 })
                {
                    <div class="loc-section-label">Warps</div>
                    @foreach (var w in selectedLocation.Warps)
                    {
                        <div class="warp-row">
                            <code>/warp @w.Name</code>
