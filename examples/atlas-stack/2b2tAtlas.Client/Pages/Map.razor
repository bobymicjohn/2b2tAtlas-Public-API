    // Search
    private bool showSearchPanel;
    private string searchQuery = "";
    private List<Location> searchResults = new();
    private (int X, int Z)? searchCoordinates;

    // Export
    private bool showExportPanel;
    private bool exportAllDims;

    // Renders (named world-download tile layers)
    private List<RenderInfo> renderOptions = new();
    private List<string> orderedRenders = new();
    private bool showSpawnRenders = true;
    private bool currentRenderDayNight = true;
    private IEnumerable<RenderInfo> AvailableRenders =>
        renderOptions.Where(r => !orderedRenders.Contains(r.Id));

    private const string MapContainerId = "map";
    private const int OverworldPrimaryRenderMin = -512_000;
    private const int OverworldPrimaryRenderMaxExclusive = 512_000;
    private const long OtherDimensionDefaultRadius = 100_000;
    private IJSObjectReference? mapModule;
    private DotNetObjectReference<Map>? selfRef;
    private bool initialized;

    private readonly List<DimensionOption> dimensionOptions = new()
    {
        new("overworld", "Overworld"),
        new("nether", "Nether"),
        new("end", "End")
    };

    /// <summary>On first render, subscribes to route changes and imports and initializes the browser map module.</summary>
    /// <param name="firstRender">Whether this is the component's first completed render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Honor ?dimension= deep links (e.g. /map?dimension=nether) and react to nav.
        selectedDimension = DimensionFromUri();
        NavigationManager.LocationChanged += OnLocationChanged;

        await InitializeMap();
    }

    /// <summary>Reads the target dimension from the current URL query.</summary>
    private string DimensionFromUri(string? uri = null)
    {
        var q = new Uri(uri ?? NavigationManager.Uri).Query;
        if (q.Contains("dimension=nether")) return "nether";
        if (q.Contains("dimension=end")) return "end";
        return "overworld";
    }

    /// <summary>Switches the map dimension when the URL changes (sidebar Overworld/Nether/End).</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (disposed || !IsMapUri(e.Location)) return;
        _ = InvokeAsync(() => HandleMapLocationChangedAsync(e.Location));
    }

    private bool IsMapUri(string uri)
    {
        var relative = NavigationManager.ToBaseRelativePath(uri);
        var path = relative.Split('?', '#')[0].Trim('/');
        return string.Equals(path, "map", StringComparison.OrdinalIgnoreCase);
    }

    private async Task HandleMapLocationChangedAsync(string uri)
    {
        var dim = DimensionFromUri(uri);
        var module = mapModule;
        if (disposed || dim == selectedDimension || !initialized || module == null) return;

        try
        {
            if (editorOpen) await CloseHighwayEditor();
            selectedDimension = dim;
            measureUnit = "blocks";
            await module.InvokeVoidAsync("setDimension", MapContainerId, selectedDimension);
            await RefreshRenders(module);
            RefreshNocomPeriods();
            await ApplyNocomLayerAsync();
            if (disposed) return;
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) when (disposed) { }
        catch (JSDisconnectedException) when (disposed) { }
    }

    private async Task InitializeMap()
    {
        try
        {
            mapModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", MapModuleAsset.Url);
            selfRef = DotNetObjectReference.Create(this);
            // Point the 2b2t.place tile proxy at the API origin (frontend is a different host in prod).
            await mapModule.InvokeVoidAsync("setApiBase", Http.BaseAddress?.ToString());
            // Register ingest-published world renders before init so they appear in the picker.
            var worldRenders = await MapRenderService.GetPublishedAsync();
            if (worldRenders.Count > 0)
                await mapModule.InvokeVoidAsync("registerWorldRenders", worldRenders);
            await mapModule.InvokeVoidAsync("initialize", MapContainerId, selectedDimension, isDay, selfRef);
            initialized = true;
            await LoadNocomManifestAsync();
            await LoadLocationsAsync();
            await LoadHighwaysAsync();
            await LoadHighwayPermissionsAsync();
            await RefreshRenders();

            // Apply the overlays that are enabled by default.
            if (showHighways)
            {
                await mapModule.InvokeVoidAsync("setHighways", MapContainerId, true);
                await mapModule.InvokeVoidAsync("setHighwayOpacity", MapContainerId, highwayOpacity);
            }
            if (showAxes) await mapModule.InvokeVoidAsync("setAxes", MapContainerId, true);
            if (showBorders) await mapModule.InvokeVoidAsync("setBorders", MapContainerId, true);
            await ApplyNocomLayerAsync();

            // Honor a shared deep link (?x=&z=&zoom=) as the initial view.
            await ApplyViewFromUri();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to initialize map: {ex.Message}");
        }
    }

    private async Task OnDimensionChanged()
    {
        if (initialized && mapModule != null)
        {
            await mapModule.InvokeVoidAsync("setDimension", MapContainerId, selectedDimension);
            await RefreshRenders();
            RefreshNocomPeriods();
            await ApplyNocomLayerAsync();
        }
    }

    private async Task OnTimeChanged()
    {
        if (initialized && mapModule != null)
            await mapModule.InvokeVoidAsync("setTimeOfDay", MapContainerId, isDay);
    }

    /// <summary>Toggles day/night from the map control button.</summary>
    private async Task ToggleDay()
    {
        if (!currentRenderDayNight) return;
        isDay = !isDay;
        if (initialized && mapModule != null)
            await mapModule.InvokeVoidAsync("setTimeOfDay", MapContainerId, isDay);
    }

    /// <summary>Refreshes the render manager for the current dimension.</summary>
    private async Task RefreshRenders(IJSObjectReference? module = null)
    {
        module ??= mapModule;
        if (disposed || module == null) return;
        var result = await module.InvokeAsync<RendersResult>("getRenders", MapContainerId);
        if (disposed) return;
        renderOptions = result.Renders;
        orderedRenders = result.Current.ToList();
        if (!showSpawnRenders)
            await module.InvokeVoidAsync("setRenders", MapContainerId, Array.Empty<string>());
        UpdateRenderCapabilities();
        StateHasChanged();
    }

    private async Task AddRender(string id)
    {
        if (!orderedRenders.Contains(id)) orderedRenders.Insert(0, id);
        await ApplyRenders();
    }

    private async Task RemoveRender(string id)
    {
        orderedRenders.Remove(id);
        await ApplyRenders();
    }

    private async Task OnSpawnRendersChanged(bool value)
    {
        showSpawnRenders = value;
        await ApplyRenders();
    }

    /// <summary>Pushes the current render stack (top-to-bottom) to the map.</summary>
    private async Task ApplyRenders()
    {
        if (initialized && mapModule != null)
        {
            await mapModule.InvokeVoidAsync("setRenders", MapContainerId,
                showSpawnRenders ? orderedRenders : Array.Empty<string>());
            UpdateRenderCapabilities();
            StateHasChanged();
        }
    }

    private void UpdateRenderCapabilities()
    {
        currentRenderDayNight =
            showSpawnRenders && orderedRenders.Any(id =>
                renderOptions.FirstOrDefault(r => r.Id == id)?.DayNight == true) ||
            showBaseRenders && allLocations.Any(location =>
                selectedBaseRenderIds.TryGetValue(location.Rowid, out var selectedIds) &&
                (location.Renders ?? []).Any(render => selectedIds.Contains(render.Id) && render.HasDayNight));
    }

    private int draggingIndex = -1;

    /// <summary>Begins dragging a render row in the reorder list.</summary>
    private void OnDragStart(int i) => draggingIndex = i;

    /// <summary>Live-reorders the stack as the dragged row passes over another.</summary>
    private void OnDragEnter(int i)
    {
        if (draggingIndex < 0 || draggingIndex == i || i < 0 || i >= orderedRenders.Count) return;
        var item = orderedRenders[draggingIndex];
        orderedRenders.RemoveAt(draggingIndex);
        orderedRenders.Insert(i, item);
        draggingIndex = i;
    }

    /// <summary>Commits the reordered stack to the map when the drag ends.</summary>
    private async Task OnDragEnd()
    {
        if (draggingIndex < 0) return;
        draggingIndex = -1;
        await ApplyRenders();
    }

    /// <summary>Label for a render id (falls back to the id).</summary>
    private string RenderLabel(string id) => renderOptions.FirstOrDefault(r => r.Id == id)?.Label ?? id;

    private async Task GoToCoords()
    {
        if (initialized && mapModule != null)
            await mapModule.InvokeVoidAsync("goToCoords", MapContainerId, gotoX, gotoZ, 7);
    }

    /// <summary>Loads location markers from the API and pushes them to the map.</summary>
    private async Task LoadLocationsAsync()
    {
        if (mapModule == null) return;
        allLocations = await LocationService.GetLocationsAsync();
        var payload = allLocations
            .Select((l, i) => new { index = i, name = l.Name, x = l.X, z = l.Z, dimension = l.Dimension, description = DisplayText.NormalizeDescription(l.Description) })
            .ToList();
        await mapModule.InvokeVoidAsync("loadLocations", MapContainerId, payload);
        if (showLocations)
            await mapModule.InvokeVoidAsync("setLocations", MapContainerId, true);

        foreach (var location in allLocations.Where(location =>
                     location.Renders is { Count: > 0 } && !ShouldDefaultBaseRenderOff(location)))
            selectedBaseRenderIds.TryAdd(location.Rowid, [OrderedLocationRenders(location).First().Id]);
        await RefreshBaseRendersAsync();
    }

    private static bool ShouldDefaultBaseRenderOff(Location location)
    {
        if (location.Dimension == 0)
        {
            return location.X >= OverworldPrimaryRenderMin && location.X < OverworldPrimaryRenderMaxExclusive &&
                location.Z >= OverworldPrimaryRenderMin && location.Z < OverworldPrimaryRenderMaxExclusive;
        }

        var x = (long)location.X;
        var z = (long)location.Z;
        return (x * x) + (z * z) <= OtherDimensionDefaultRadius * OtherDimensionDefaultRadius;
    }

    private async Task RefreshBaseRendersAsync()
    {
        if (mapModule == null) return;
        // Each location defaults to its newest capture, but users may compare any combination.
        // Load older captures first so the newest selected capture remains visually on top.
        var renders = allLocations
            .SelectMany(location => (location.Renders ?? new())
                .Where(render => selectedBaseRenderIds.TryGetValue(location.Rowid, out var selectedIds) && selectedIds.Contains(render.Id))
                .OrderBy(render => render.WorldDownloadDate)
                .ThenBy(render => render.Id)
                .Select(render => new
            {
                id = render.Id,
                locationId = location.Rowid,
                tilesPath = render.TilesPath,
                x = location.X,
                z = location.Z,
                scale = render.Scale,
                dimension = render.Dimension,
                name = render.Name,
                date = render.WorldDownloadDate,
                minX = render.MinX,
                minZ = render.MinZ,
                maxXExclusive = render.MaxXExclusive,
                maxZExclusive = render.MaxZExclusive,
                maxNativeZoom = render.MaxNativeZoom,
                coordinateScheme = render.CoordinateScheme,
                hasDayNight = render.HasDayNight
            }))
            .Where(r => !string.IsNullOrEmpty(r.tilesPath))
            .ToList();
        await mapModule.InvokeVoidAsync("loadBaseRenders", MapContainerId, renders);
        await mapModule.InvokeVoidAsync("setBaseRenders", MapContainerId, showBaseRenders);
        UpdateRenderCapabilities();
    }

    private static IEnumerable<Atlas.Locations.Render> OrderedLocationRenders(Location location) =>
        (location.Renders ?? new()).OrderByDescending(render => render.WorldDownloadDate).ThenByDescending(render => render.Id);

    private bool HasSelectedBaseRenders(Location location) =>
        selectedBaseRenderIds.TryGetValue(location.Rowid, out var renderIds) && renderIds.Count > 0;

    private bool IsBaseRenderSelected(Location location, int renderId) =>
        selectedBaseRenderIds.TryGetValue(location.Rowid, out var renderIds) && renderIds.Contains(renderId);

    private bool EnsureLatestBaseRenderSelected(Location location)
    {
        if (selectedBaseRenderIds.ContainsKey(location.Rowid)) return false;
        var latestRenderId = OrderedLocationRenders(location).FirstOrDefault()?.Id;
        if (latestRenderId is null) return false;
        selectedBaseRenderIds[location.Rowid] = [latestRenderId.Value];
        return true;
    }

    private async Task ToggleBaseRender(int locationId, int? renderId)
    {
        if (!selectedBaseRenderIds.TryGetValue(locationId, out var renderIds))
        {
            renderIds = [];
            selectedBaseRenderIds[locationId] = renderIds;
        }

        if (renderId is null)
            renderIds.Clear();
        else if (!renderIds.Add(renderId.Value))
            renderIds.Remove(renderId.Value);

        await RefreshBaseRendersAsync();
        UpdateRenderCapabilities();
    }

    private async Task FocusBaseRender(Location renderLocation, Atlas.Locations.Render render)
    {
        if (mapModule is null) return;
        if (!selectedBaseRenderIds.TryGetValue(renderLocation.Rowid, out var renderIds))
        {
            renderIds = [];
            selectedBaseRenderIds[renderLocation.Rowid] = renderIds;
        }
        if (renderIds.Add(render.Id) || !showBaseRenders)
        {
            showBaseRenders = true;
            await RefreshBaseRendersAsync();
        }

        await mapModule.InvokeAsync<bool>("focusBaseRender", MapContainerId, new
        {
            id = render.Id,
            locationId = renderLocation.Rowid,
            x = renderLocation.X,
            z = renderLocation.Z,
            scale = render.Scale,
            dimension = render.Dimension,
            minX = render.MinX,
            minZ = render.MinZ,
            maxXExclusive = render.MaxXExclusive,
            maxZExclusive = render.MaxZExclusive,
        });
    }

    /// <summary>Loads highways from the API and pushes them to the map (falls back to the built-in set on failure).</summary>
    private async Task LoadHighwaysAsync()
    {
        if (mapModule == null) return;
        // Load groups first so highways can carry a resolved builder-group name.
        groups = await GroupService.GetGroupsAsync();
        groupById = groups.ToDictionary(g => g.Id, g => g.Name);

        var highways = await HighwayService.GetHighwaysAsync();
        if (highways.Count == 0) return; // keep the JS built-in fallback
        foreach (var h in highways)
            if (string.IsNullOrWhiteSpace(h.BuilderGroupName) && h.BuilderGroupId is int gid && groupById.TryGetValue(gid, out var gname))
                h.BuilderGroupName = gname;
        await mapModule.InvokeVoidAsync("loadHighways", MapContainerId, highways);
    }

