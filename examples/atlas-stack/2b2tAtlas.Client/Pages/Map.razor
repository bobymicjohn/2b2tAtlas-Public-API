    private readonly IEnumerable<PavingMaterial> materialOptions = Enum.GetValues<PavingMaterial>();
    private readonly IEnumerable<HighwayStatus> statusOptions = Enum.GetValues<HighwayStatus>();

    // Location selection
    private List<Location> allLocations = new();
    private Location? selectedLocation;
    private bool locationSelected;
