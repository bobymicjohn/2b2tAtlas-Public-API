    private async Task NextNocomPeriod()
    {
        StopNocomPlayback();
        await AdvanceNocomPeriodAsync();
    }

    private void ToggleNocomPlayback()
    {
        if (nocomPlaying)
        {
            StopNocomPlayback();
            return;
        }
        if (NocomPeriods.Count == 0) return;
        nocomPlaying = true;
        var generation = ++nocomPlaybackGeneration;
        _ = PlayNocomAsync(generation);
    }

    private async Task PlayNocomAsync(int generation)
    {
        while (!disposed && nocomPlaying && generation == nocomPlaybackGeneration)
        {
            await Task.Delay(1_100);
            if (disposed || !nocomPlaying || generation != nocomPlaybackGeneration) break;
            await InvokeAsync(async () =>
            {
                await AdvanceNocomPeriodAsync();
                StateHasChanged();
            });
        }
    }

    private async Task AdvanceNocomPeriodAsync()
    {
        if (NocomPeriods.Count == 0) return;
        nocomPeriodIndex = (nocomPeriodIndex + 1) % NocomPeriods.Count;
        await ApplyNocomLayerAsync();
    }

    private void StopNocomPlayback()
    {
        nocomPlaying = false;
        nocomPlaybackGeneration++;
    }

