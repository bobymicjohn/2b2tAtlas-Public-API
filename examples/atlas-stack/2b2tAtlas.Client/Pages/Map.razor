    /// <summary>Scores a location against a lowercase query (name-weighted, like the old Fuse config).</summary>
    /// <param name="l">The location to score.</param>
    /// <param name="q">The lowercase query.</param>
    /// <returns>A relevance score; 0 means no match.</returns>
    private static int ScoreLocation(Location l, string q)
    {
        int score = 0;
        var name = (l.Name ?? "").ToLowerInvariant();
        if (name == q) score += 100;
        else if (name.StartsWith(q)) score += 60;
        else if (name.Contains(q)) score += 40;
        if ((l.Tags ?? "").ToLowerInvariant().Contains(q)) score += 20;
        if ((l.Description ?? "").ToLowerInvariant().Contains(q)) score += 10;
        if ($"{l.X} {l.Z}".Contains(q) || $"{l.X},{l.Z}".Contains(q)) score += 15;
        return score;
    }

    /// <summary>Flies to a search result, switching dimension if needed, and selects its marker.</summary>
    /// <param name="loc">The chosen location.</param>
    private async Task GoToSearchResult(Location loc)
    {
        if (!initialized || mapModule == null) return;

        // Switch dimension if the result lives elsewhere.
        var dim = loc.Dimension switch { 2 => "end", 1 => "nether", _ => "overworld" };
        if (dim != selectedDimension)
        {
            selectedDimension = dim;
            await mapModule.InvokeVoidAsync("setDimension", MapContainerId, selectedDimension);
            await RefreshRenders();
            RefreshNocomPeriods();
            await ApplyNocomLayerAsync();
            NavigationManager.NavigateTo($"map?dimension={dim}");
        }

        // Ensure markers are visible so the target can be focused.
        if (!showLocations)
        {
            showLocations = true;
            await mapModule.InvokeVoidAsync("setLocations", MapContainerId, true);
        }

        var idx = allLocations.IndexOf(loc);
        var found = await mapModule.InvokeAsync<bool>("focusLocation", MapContainerId, idx, 8);
        if (!found)
        {
            await mapModule.InvokeVoidAsync("goToCoords", MapContainerId, (double)loc.X, (double)loc.Z, 8);
            selectedLocation = loc;
            locationSelected = true;
            highwaySelected = false;
            if (EnsureLatestBaseRenderSelected(loc))
                await RefreshBaseRendersAsync();
        }

        showSearchPanel = false;
    }

    /// <summary>Opens/closes the export panel (mutually exclusive with other left panels).</summary>
    private void ToggleExport()
    {
        showExportPanel = !showExportPanel;
        if (showExportPanel) { showSearchPanel = false; showLayersPanel = false; showHistoryPanel = false; }
    }

    /// <summary>The current dimension as its integer index (0=Overworld, 1=Nether, 2=End).</summary>
    private int CurrentDimIndex() => selectedDimension switch { "nether" => 1, "end" => 2, _ => 0 };

    /// <summary>The set of locations to export, honoring the all-dimensions scope toggle.</summary>
    private List<Location> ExportSet() =>
        exportAllDims ? allLocations : allLocations.Where(l => l.Dimension == CurrentDimIndex()).ToList();

    /// <summary>Exports waypoints in Xaero's Minimap format (single .txt for the matching dimension).</summary>
    private async Task ExportXaero()
    {
        var sb = new StringBuilder();
        sb.AppendLine("#");
        sb.AppendLine("#Exported from 2b2t Atlas");
        foreach (var l in ExportSet())
        {
            var name = (l.Name ?? "loc").Replace(':', ' ').Replace('\n', ' ').Replace('\r', ' ').Trim();
            if (name.Length == 0) name = "loc";
            var initial = name.Substring(0, 1).ToUpperInvariant();
            var y = l.Y ?? 64;
            sb.AppendLine($"waypoint:{name}:{initial}:{l.X}:{y}:{l.Z}:6:false:0:gui.xaero_default:true:0:0:false");
        }
        var scope = exportAllDims ? "all" : selectedDimension;
        await JSRuntime.InvokeVoidAsync("downloadTextFile", $"atlas-xaero-{scope}.txt", "text/plain", sb.ToString());
    }

    /// <summary>Exports the selected locations as CSV.</summary>
    private async Task ExportCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("name,x,y,z,dimension,tags,description");
        foreach (var l in ExportSet())
            sb.AppendLine(string.Join(",", CsvField(l.Name), l.X, l.Y?.ToString() ?? "", l.Z,
                CsvField(l.DimensionName), CsvField(l.Tags), CsvField(DisplayText.CompactDescription(l.Description))));
        await JSRuntime.InvokeVoidAsync("downloadTextFile", "atlas-locations.csv", "text/csv", sb.ToString());
    }

    /// <summary>Exports the selected locations as indented JSON.</summary>
    private async Task ExportJson()
    {
        var data = ExportSet().Select(l => new { l.Name, l.X, l.Y, l.Z, dimension = l.DimensionName, l.Tags, l.Description, l.Wiki, l.VideoUrl });
        var json = System.Text.Json.JsonSerializer.Serialize(data, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        await JSRuntime.InvokeVoidAsync("downloadTextFile", "atlas-locations.json", "application/json", json);
    }

    /// <summary>Escapes a value for a CSV field.</summary>
    /// <param name="value">The raw value.</param>
    /// <returns>The quoted, escaped CSV field.</returns>
    private static string CsvField(string? value) => "\"" + (value ?? "").Replace("\"", "\"\"") + "\"";

    /// <summary>Closes the highway info panel and clears the map selection.</summary>
    private async Task CloseHighwayInfo()
    {
        highwaySelected = false;
        if (initialized && mapModule != null)
            await mapModule.InvokeVoidAsync("clearHighwaySelection", MapContainerId);
    }

    // ---- Highway editor ----

    /// <summary>Loads the current user's highway permissions to gate the editor UI.</summary>
    private async Task LoadHighwayPermissionsAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        var perms = user?.Permissions ?? new List<string>();
        canEditHighways = perms.Contains(Permissions.HighwaysCreate) || perms.Contains(Permissions.HighwaysEdit);
        canDeleteHighways = perms.Contains(Permissions.HighwaysDelete);
    }

    /// <summary>Opens/closes the highway editor for creating a new highway.</summary>
    private async Task ToggleHighwayEditor()
    {
        if (editorOpen) { await CloseHighwayEditor(); return; }
        // Close conflicting tools.
        if (measuring) await ToggleMeasure();
        if (showMarkerToolPanel) await ToggleMarkerTool();
        ResetEditorForm(null);
        editorOpen = true;
        if (initialized && mapModule != null)
            await mapModule.InvokeVoidAsync("setHighwayEditMode", MapContainerId, true);
    }

    /// <summary>Closes the editor and exits map edit mode.</summary>
    private async Task CloseHighwayEditor()
    {
        editorOpen = false;
        editVertexCount = 0;
        editorError = null;
        if (initialized && mapModule != null)
            await mapModule.InvokeVoidAsync("setHighwayEditMode", MapContainerId, false);
    }

    /// <summary>Loads the selected highway into the editor for editing.</summary>
    private async Task EditSelectedHighway()
    {
        if (selectedHighwayId <= 0) return;
        var hw = await HighwayService.GetHighwayAsync(selectedHighwayId);
        if (hw == null) return;

        highwaySelected = false;
        if (mapModule != null) await mapModule.InvokeVoidAsync("clearHighwaySelection", MapContainerId);

        ResetEditorForm(hw);
        editorOpen = true;
        if (initialized && mapModule != null)
        {
            await mapModule.InvokeVoidAsync("setHighwayEditMode", MapContainerId, true, (int)hw.Dimension);
            var points = hw.Points.Select(p => new { x = p.X, z = p.Z }).ToArray();
            await mapModule.InvokeVoidAsync("setEditPath", MapContainerId, points);
        }
    }

    /// <summary>Resets the editor form from a highway (or blank for a new one).</summary>
    private void ResetEditorForm(Highway? hw)
    {
        hwOriginal = hw;
        hwGroupIds = hw?.BuilderGroups.Select(g => g.GroupId).ToArray() ?? Array.Empty<int>();
        hwRingRadius = hw?.RingRadius;
        hwHeight = hw?.Height;
        hwLit = hw?.Lit ?? false;
        hwEditId = hw?.Id;
        hwName = hw?.Name ?? "";
        hwCategory = hw?.Category ?? HighwayCategory.Custom;
        hwWidth = hw?.Width ?? 4;
        hwMaterial = hw?.PavingMaterial ?? PavingMaterial.Unknown;
        hwStatus = hw?.Status ?? HighwayStatus.Unknown;
        hwYLevel = hw?.YLevel;
        hwPaved = hw?.Paved ?? false;
        hwWalls = hw?.Walls ?? false;
        hwEnclosed = hw?.Enclosed ?? false;
        hwRoof = hw?.IsRoofHighway ?? false;
        hwColor = hw?.Color;
        hwDescription = hw?.Description;
        hwWiki = hw?.WikiUrl;
        hwBuilderGroupId = hw?.BuilderGroupId;
        editorError = null;
    }

    /// <summary>Removes the last drawn vertex.</summary>
    private async Task UndoVertex()
    {
        if (initialized && mapModule != null)
            await mapModule.InvokeVoidAsync("undoEditVertex", MapContainerId);
    }

    /// <summary>Clears all drawn vertices.</summary>
    private async Task ClearVertices()
    {
        if (initialized && mapModule != null)
            await mapModule.InvokeVoidAsync("clearEditPath", MapContainerId);
    }

    /// <summary>Saves the drawn highway (create or update) via the API.</summary>
    private async Task SaveHighway()
    {
        if (mapModule == null) return;
        saving = true;
        editorError = null;
        try
        {
            var pts = await mapModule.InvokeAsync<List<PointDto>>("getEditPath", MapContainerId);
            if (pts.Count < 2 && hwCategory is not (HighwayCategory.Ring or HighwayCategory.DiamondRing)) { editorError = "Draw at least two points."; return; }

            var dto = new Highway
            {
                Id = hwEditId ?? 0,
                EditVersion = hwOriginal?.EditVersion,
                Slug = hwOriginal?.Slug ?? "",
                RingRadius = hwRingRadius,
                Height = hwHeight,
                Lit = hwLit,
                VideoUrl = hwOriginal?.VideoUrl,
                DisplayWeight = hwOriginal?.DisplayWeight,
                LengthBlocks = hwOriginal?.LengthBlocks,
                LastVerifiedUtc = hwOriginal?.LastVerifiedUtc,
                ReviewStatus = hwOriginal?.ReviewStatus ?? ReviewStatus.Approved,
                BuilderGroups = hwGroupIds.Select(id => hwOriginal?.BuilderGroups.FirstOrDefault(g => g.GroupId == id)
                    ?? new HighwayGroupAttribution { GroupId = id, Role = "Maintainer" }).ToList(),
                Name = hwName.Trim(),
                Dimension = hwOriginal?.Dimension ?? selectedDimension switch
                {
                    "end" => Dimension.End,
                    "overworld" => Dimension.Overworld,
                    _ => Dimension.Nether,
                },
                Category = hwCategory,
                Points = pts.Select(p => new HighwayPoint(p.X, p.Z)).ToList(),
                Width = hwWidth,
                PavingMaterial = hwMaterial,
                Status = hwStatus,
                YLevel = hwYLevel,
                Paved = hwPaved,
                Walls = hwWalls,
                Enclosed = hwEnclosed,
                IsRoofHighway = hwRoof,
                Color = string.IsNullOrWhiteSpace(hwColor) ? null : hwColor,
                Description = string.IsNullOrWhiteSpace(hwDescription) ? null : hwDescription,
                WikiUrl = string.IsNullOrWhiteSpace(hwWiki) ? null : hwWiki,
                BuilderGroupId = hwBuilderGroupId,
                Visibility = hwOriginal?.Visibility ?? HighwayVisibility.Public,
            };

            var result = hwEditId is null
                ? await HighwayService.CreateAsync(dto)
                : await HighwayService.UpdateAsync(hwEditId.Value, dto);

            if (!result.Ok)
            {
                editorError = result.Error ?? "Save failed.";
                return;
            }

            await CloseHighwayEditor();
            await LoadHighwaysAsync(); // refresh the map with the new/updated highway
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>Deletes the highway being edited.</summary>
    private async Task DeleteHighway()
    {
        if (hwEditId is null) return;
        saving = true;
        try
        {
            var ok = await HighwayService.DeleteAsync(hwEditId.Value);
            if (!ok) { editorError = "Delete failed (permission?)."; return; }
            await CloseHighwayEditor();
            await LoadHighwaysAsync();
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>A point returned from the JS edit path.</summary>
    private record PointDto(int X, int Z);

    /// <summary>Maps a highway category key to a friendly label for display.</summary>
    /// <param name="category">The raw category key from the map data.</param>
    /// <returns>A human-readable category label.</returns>
    private static string FormatCategory(string category) => category switch
    {
        "axis" => "Axis highway",
        "diagonal" => "Diagonal highway",
        "ring" => "Ring road",
        "diamond" => "Diamond ring road",
        "star" => "Nether Star ring road",
        "grid" => "50k grid road",
        _ => "Highway"
    };

    /// <summary>Invoked from JS on mouse move to report the block coordinates under the cursor.</summary>
    /// <param name="x">The block X coordinate.</param>
    /// <param name="z">The block Z coordinate.</param>
    [JSInvokable]
    public void UpdateCoordinates(int x, int z)
    {
        cursorX = x;
        cursorZ = z;
        cursorText = $"{x}, {z}";
        if (selectedDimension == "nether")
        {
            altCoordLabel = "OVW:";
            altCoordText = $"{x * 8}, {z * 8}";
        }
        else if (selectedDimension == "overworld")
        {
            altCoordLabel = "Nether:";
            altCoordText = $"{x / 8}, {z / 8}";
        }
        else
        {
            altCoordLabel = "";
            altCoordText = "";
        }
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Stops route handling and asks the browser map module to release the Leaflet map, event handlers, and .NET callback reference.</summary>
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        StopNocomPlayback();
        initialized = false;
        NavigationManager.LocationChanged -= OnLocationChanged;
        var module = mapModule;
        mapModule = null;
        try
        {
            if (module != null)
            {
                await module.InvokeVoidAsync("dispose", MapContainerId);
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { /* circuit already gone */ }
        catch (ObjectDisposedException) { /* module already disposed */ }
        selfRef?.Dispose();
    }

    private record DimensionOption(string Value, string Text);

    private record MarkerOption(string Id, string Label);

    private record RenderInfo(string Id, string Label, bool DayNight);

    private record RendersResult(List<string> Current, bool DayNight, List<RenderInfo> Renders);

    private record NocomPeriod(string Key, string Label, DateTimeOffset StartUtc);

    private sealed class NocomManifest
    {
        public List<NocomFrame> Frames { get; set; } = new();
        public List<NocomTotal> Totals { get; set; } = new();
    }

    private abstract class NocomLayer
    {
        public string Dimension { get; set; } = "";
        public int MaxNativeUrlZoom { get; set; }
        public string UrlTemplate { get; set; } = "";
    }

    private sealed class NocomFrame : NocomLayer
    {
        public string Key { get; set; } = "";
        public string Label { get; set; } = "";
        public DateTimeOffset PeriodStartUtc { get; set; }
    }

    private sealed class NocomTotal : NocomLayer { }
}

