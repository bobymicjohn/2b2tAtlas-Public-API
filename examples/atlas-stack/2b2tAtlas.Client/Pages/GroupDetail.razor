@code {
    [Parameter] public int Id { get; set; }
    private Atlas.Group? group;
    private bool loading = true;
    private const string GroupMapId = "group-build-map";
    private IJSObjectReference? mapModule;
    private DotNetObjectReference<GroupDetail>? mapDotNetRef;
    private bool mapReady;
    private bool mapInitializationPending;
    private int selectedMapDimension;
    private string? mapError;
    private List<Location>? allLocations;
    private List<Location> groupMapLocations = [];
    private List<Location> displayedLocations = [];
    private Location? selectedMapLocation;
    private bool mapLocationSelected;
    private readonly Dictionary<int, HashSet<int>> selectedBaseRenderIds = [];
    private bool showOthers;
    private bool showHighways = true;
    private bool showAxes = true;
    private bool showBorders = true;
    private bool showEndPortals;
    private bool showBaseRenders;
    private bool isDay = true;
    private bool showPrimaryRenderPanel;
    private bool showPrimaryRenders = true;
    private bool currentPrimaryRenderDayNight = true;
    private List<PrimaryRenderInfo> primaryRenderOptions = [];
    private List<string> orderedPrimaryRenders = [];
    private int primaryRenderDraggingIndex = -1;
    private IEnumerable<PrimaryRenderInfo> AvailablePrimaryRenders =>
        primaryRenderOptions.Where(render => !orderedPrimaryRenders.Contains(render.Id));
    private bool HasMapBaseRenders => (showOthers ? allLocations : groupMapLocations)?
        .Any(location => (location.Renders ?? []).Any(render => render.Dimension == selectedMapDimension)) == true;
    private string Accent => string.IsNullOrWhiteSpace(group?.Color) ? "#4da3ff" : group.Color;
    private string CanonicalUrl => $"https://atlas.example/entities/groups/{Id}/";
    private string MetaDescription
    {
        get
        {
            var value = group is null ? "A documented 2b2t group." : $"{group.Name}: {DisplayText.CompactDescription(group.Description)}";
            return value.Length <= 160 ? value : $"{value[..157].TrimEnd()}...";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        await DisposeMapAsync();
        group = await GroupService.GetGroupAsync(Id);
        selectedMapDimension = group?.Locations
            .GroupBy(location => location.Dimension)
            .OrderByDescending(set => set.Count())
            .ThenBy(set => set.Key == 0 ? 0 : 1)
            .Select(set => set.Key)
            .FirstOrDefault() ?? 0;
        mapError = null;
        allLocations = null;
        groupMapLocations = [];
        displayedLocations = [];
        selectedMapLocation = null;
        mapLocationSelected = false;
        selectedBaseRenderIds.Clear();
        showOthers = false;
        showBaseRenders = false;
        mapInitializationPending = group?.Locations.Count > 0;
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!mapInitializationPending || group is null)
            return;

        mapInitializationPending = false;
        try
        {
            mapModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", MapModuleAsset.Url);
            mapDotNetRef ??= DotNetObjectReference.Create(this);
            await mapModule.InvokeVoidAsync("setApiBase", Http.BaseAddress?.ToString());
            var worldRenders = await MapRenderService.GetPublishedAsync();
            if (worldRenders.Count > 0)
                await mapModule.InvokeVoidAsync("registerWorldRenders", worldRenders);
            await mapModule.InvokeVoidAsync("initialize", GroupMapId, DimensionSlug(selectedMapDimension), isDay, mapDotNetRef);
            mapReady = true;
            await RefreshPrimaryRenders();

            allLocations = await LocationService.GetLocationsAsync();
            var locationsById = allLocations.ToDictionary(location => location.Rowid);
            groupMapLocations = group.Locations.Select(summary =>
            {
                if (locationsById.TryGetValue(summary.LocationId, out var fullLocation)) return fullLocation;
                return new Location
                {
                    Rowid = summary.LocationId,
                    Name = summary.Name,
                    X = summary.X,
                    Z = summary.Z,
                    Dimension = summary.Dimension,
                };
            }).ToList();

            await LoadGroupMapLocationsAsync(fit: true);
            var highways = await HighwayService.GetHighwaysAsync();
            if (highways.Count > 0)
                await mapModule.InvokeVoidAsync("loadHighways", GroupMapId, highways);
            await mapModule.InvokeVoidAsync("setHighways", GroupMapId, showHighways);
            await mapModule.InvokeVoidAsync("setAxes", GroupMapId, showAxes);
            await mapModule.InvokeVoidAsync("setBorders", GroupMapId, showBorders);
            await mapModule.InvokeVoidAsync("setEndPortals", GroupMapId, showEndPortals);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            mapError = $"The build map could not be loaded: {ex.Message}";
            StateHasChanged();
        }
    }

    private IReadOnlyList<int> MapDimensions
    {
        get
        {
            if (group is null) return [];
            var dimensions = new List<int>();
            if (group.Locations.Any(location => location.Dimension is 0 or 1)) dimensions.AddRange([0, 1]);
            if (group.Locations.Any(location => location.Dimension == 2)) dimensions.Add(2);
            return dimensions;
        }
    }

    private int MapLocationCount => MapLocationCountFor(selectedMapDimension);

    private int MapLocationCountFor(int dimension) => groupMapLocations.Count > 0
        ? groupMapLocations.Count(location => IsVisibleInDimension(location.Dimension, dimension))
        : group?.Locations.Count(location => IsVisibleInDimension(location.Dimension, dimension)) ?? 0;

    private string GroupMapUrl
    {
        get
        {
            var first = group?.Locations.FirstOrDefault(location => location.Dimension == selectedMapDimension);
            first ??= group?.Locations.FirstOrDefault(location =>
                selectedMapDimension is 0 or 1 && location.Dimension is 0 or 1);
            var x = first?.X ?? 0;
            var z = first?.Z ?? 0;
            if (first?.Dimension == 0 && selectedMapDimension == 1) { x /= 8; z /= 8; }
            else if (first?.Dimension == 1 && selectedMapDimension == 0) { x *= 8; z *= 8; }
            return first is null
                ? $"map?dimension={DimensionSlug(selectedMapDimension)}"
                : $"map?dimension={DimensionSlug(selectedMapDimension)}&x={x}&z={z}&zoom=4";
        }
    }

    private async Task SetMapDimension(int dimension)
    {
        if (selectedMapDimension == dimension || mapModule is null)
            return;
        selectedMapDimension = dimension;
        showOthers = false;
        selectedMapLocation = null;
        mapLocationSelected = false;
        selectedBaseRenderIds.Clear();
        showBaseRenders = false;
        await mapModule.InvokeVoidAsync("setDimension", GroupMapId, DimensionSlug(dimension));
        await RefreshPrimaryRenders();
        await LoadGroupMapLocationsAsync(fit: true);
        await LoadBaseRenders();
        await mapModule.InvokeVoidAsync("setHighways", GroupMapId, showHighways);
        await mapModule.InvokeVoidAsync("setAxes", GroupMapId, showAxes);
        await mapModule.InvokeVoidAsync("setBorders", GroupMapId, showBorders);
        await mapModule.InvokeVoidAsync("setEndPortals", GroupMapId, showEndPortals);
        UpdatePrimaryRenderCapabilities();
        StateHasChanged();
    }

    private async Task LoadGroupMapLocationsAsync(bool fit = false)
    {
        if (!mapReady || mapModule is null || group is null)
            return;

        displayedLocations = showOthers
            ? allLocations?.ToList() ?? []
            : groupMapLocations.ToList();
        selectedMapLocation = null;
        mapLocationSelected = false;

        var payload = displayedLocations
            .Select((location, index) => new
            {
                index,
                name = location.Name,
                x = location.X,
                z = location.Z,
                dimension = location.Dimension,
                description = DisplayText.NormalizeDescription(location.Description),
            })
            .ToArray();
        await mapModule.InvokeVoidAsync("loadLocations", GroupMapId, payload);
        await mapModule.InvokeVoidAsync("setLocations", GroupMapId, true);
        await mapModule.InvokeVoidAsync("setEndPortals", GroupMapId, showEndPortals);
        if (fit)
            await mapModule.InvokeVoidAsync("fitLocations", GroupMapId, 44, 8);
    }

    private async Task ToggleOthers()
    {
        showOthers = !showOthers;
        await LoadGroupMapLocationsAsync();
        await LoadBaseRenders();
    }

    private void TogglePrimaryRenderPanel() => showPrimaryRenderPanel = !showPrimaryRenderPanel;

    private async Task RefreshPrimaryRenders()
    {
        if (mapModule is null) return;
        var result = await mapModule.InvokeAsync<PrimaryRendersResult>("getRenders", GroupMapId);
        primaryRenderOptions = result.Renders;
        orderedPrimaryRenders = result.Current.ToList();
        UpdatePrimaryRenderCapabilities();
    }

    private async Task AddPrimaryRender(string renderId)
    {
        if (!orderedPrimaryRenders.Contains(renderId)) orderedPrimaryRenders.Insert(0, renderId);
        await ApplyPrimaryRenders();
    }

    private async Task RemovePrimaryRender(string renderId)
    {
        orderedPrimaryRenders.Remove(renderId);
        await ApplyPrimaryRenders();
    }

    private async Task OnPrimaryRendersChanged(bool value)
    {
        showPrimaryRenders = value;
        await ApplyPrimaryRenders();
    }

    private async Task ApplyPrimaryRenders()
    {
        if (mapModule is null) return;
        await mapModule.InvokeVoidAsync("setRenders", GroupMapId,
            showPrimaryRenders ? orderedPrimaryRenders : Array.Empty<string>());
        UpdatePrimaryRenderCapabilities();
    }

    private void UpdatePrimaryRenderCapabilities()
    {
        var selectedBaseHasDayNight = displayedLocations.Any(location =>
            selectedBaseRenderIds.TryGetValue(location.Rowid, out var ids) &&
            (location.Renders ?? []).Any(render => ids.Contains(render.Id) && render.HasDayNight));
        currentPrimaryRenderDayNight =
            showPrimaryRenders && orderedPrimaryRenders.Any(renderId =>
                primaryRenderOptions.FirstOrDefault(render => render.Id == renderId)?.DayNight == true) ||
            showBaseRenders && selectedBaseHasDayNight;
    }

    private void OnPrimaryRenderDragStart(int index) => primaryRenderDraggingIndex = index;

    private void OnPrimaryRenderDragEnter(int index)
    {
        if (primaryRenderDraggingIndex < 0 || primaryRenderDraggingIndex == index ||
            index < 0 || index >= orderedPrimaryRenders.Count) return;
        var renderId = orderedPrimaryRenders[primaryRenderDraggingIndex];
        orderedPrimaryRenders.RemoveAt(primaryRenderDraggingIndex);
        orderedPrimaryRenders.Insert(index, renderId);
        primaryRenderDraggingIndex = index;
    }

    private async Task OnPrimaryRenderDragEnd()
    {
        if (primaryRenderDraggingIndex < 0) return;
        primaryRenderDraggingIndex = -1;
        await ApplyPrimaryRenders();
    }

    private string PrimaryRenderLabel(string renderId) =>
        primaryRenderOptions.FirstOrDefault(render => render.Id == renderId)?.Label ?? renderId;

    private async Task LoadBaseRenders()
    {
        if (mapModule is null) return;
        var renders = displayedLocations
            .SelectMany(sourceLocation => (sourceLocation.Renders ?? [])
                .Where(render => selectedBaseRenderIds.TryGetValue(sourceLocation.Rowid, out var selectedIds) &&
                    selectedIds.Contains(render.Id) && !string.IsNullOrWhiteSpace(render.TilesPath))
                .OrderBy(render => render.WorldDownloadDate)
                .ThenBy(render => render.Id)
                .Select(render => new
                {
                    id = render.Id,
                    locationId = sourceLocation.Rowid,
                    tilesPath = render.TilesPath,
                    x = sourceLocation.X,
                    z = sourceLocation.Z,
                    scale = render.Scale,
                    dimension = render.Dimension,
                    name = render.Name,
                    date = render.WorldDownloadDate,
                    minX = render.MinX,
                    minZ = render.MinZ,
                    maxXExclusive = render.MaxXExclusive,
                    maxZExclusive = render.MaxZExclusive,
                    maxNativeZoom = render.MaxNativeZoom,
                    coordinateScheme = render.CoordinateScheme,
                    hasDayNight = render.HasDayNight,
                }))
            .ToArray();
        await mapModule.InvokeVoidAsync("loadBaseRenders", GroupMapId, renders);
        await mapModule.InvokeVoidAsync("setBaseRenders", GroupMapId, showBaseRenders);
    }

    private async Task ToggleBaseRenders()
    {
        showBaseRenders = !showBaseRenders;
        if (mapModule is not null)
            await mapModule.InvokeVoidAsync("setBaseRenders", GroupMapId, showBaseRenders);
        UpdatePrimaryRenderCapabilities();
    }

    private IEnumerable<Atlas.Locations.Render> OrderedMapRenders(Location selectedLocation) =>
        (selectedLocation.Renders ?? [])
            .Where(render => render.Dimension == selectedMapDimension)
            .OrderByDescending(render => render.WorldDownloadDate)
            .ThenByDescending(render => render.Id);

    private bool HasSelectedBaseRenders(Location selectedLocation) =>
        selectedBaseRenderIds.TryGetValue(selectedLocation.Rowid, out var renderIds) && renderIds.Count > 0;

    private bool IsBaseRenderSelected(Location selectedLocation, int renderId) =>
        selectedBaseRenderIds.TryGetValue(selectedLocation.Rowid, out var renderIds) && renderIds.Contains(renderId);

    private async Task SelectBaseRender(int locationId, int? renderId)
    {
        if (!selectedBaseRenderIds.TryGetValue(locationId, out var renderIds))
        {
            renderIds = [];
            selectedBaseRenderIds[locationId] = renderIds;
        }
        if (renderId is null) renderIds.Clear();
        else if (!renderIds.Add(renderId.Value)) renderIds.Remove(renderId.Value);
        showBaseRenders = selectedBaseRenderIds.Values.Any(ids => ids.Count > 0);
        await LoadBaseRenders();
        UpdatePrimaryRenderCapabilities();
    }

    private async Task FocusBaseRender(Location renderLocation, Atlas.Locations.Render render)
    {
        if (mapModule is null) return;
        if (!selectedBaseRenderIds.TryGetValue(renderLocation.Rowid, out var renderIds))
        {
            renderIds = [];
            selectedBaseRenderIds[renderLocation.Rowid] = renderIds;
        }
        renderIds.Add(render.Id);
        showBaseRenders = true;
        await LoadBaseRenders();
        UpdatePrimaryRenderCapabilities();
        await mapModule.InvokeAsync<bool>("focusBaseRender", GroupMapId, new
        {
            id = render.Id,
            locationId = renderLocation.Rowid,
            x = renderLocation.X,
            z = renderLocation.Z,
            scale = render.Scale,
            dimension = render.Dimension,
            minX = render.MinX,
            minZ = render.MinZ,
            maxXExclusive = render.MaxXExclusive,
            maxZExclusive = render.MaxZExclusive,
        });
    }

    [JSInvokable]
    public async Task OnLocationSelected(int index)
    {
        if (index < 0 || index >= displayedLocations.Count) return;
        selectedMapLocation = displayedLocations[index];
        mapLocationSelected = true;
        if (!selectedBaseRenderIds.ContainsKey(selectedMapLocation.Rowid))
        {
            var latestRenderId = OrderedMapRenders(selectedMapLocation).FirstOrDefault()?.Id;
            selectedBaseRenderIds[selectedMapLocation.Rowid] = latestRenderId is null ? [] : [latestRenderId.Value];
            if (latestRenderId is not null)
            {
                showBaseRenders = true;
                await LoadBaseRenders();
                UpdatePrimaryRenderCapabilities();
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnLocationDeselected()
    {
        mapLocationSelected = false;
        selectedMapLocation = null;
        InvokeAsync(StateHasChanged);
    }

    private async Task CloseMapLocationInfo()
    {
        mapLocationSelected = false;
        selectedMapLocation = null;
        if (mapModule is not null)
            await mapModule.InvokeVoidAsync("clearLocationSelection", GroupMapId);
    }

    private async Task GoToMapLocation()
    {
        if (mapModule is null || selectedMapLocation is null) return;
        var x = selectedMapLocation.X;
        var z = selectedMapLocation.Z;
        if (selectedMapLocation.Dimension == 0 && selectedMapDimension == 1) { x /= 8; z /= 8; }
        else if (selectedMapLocation.Dimension == 1 && selectedMapDimension == 0) { x *= 8; z *= 8; }
        await mapModule.InvokeVoidAsync("goToCoords", GroupMapId, (double)x, (double)z, 8);
    }

    private async Task CopyMapLocationCoords()
    {
        if (selectedMapLocation is not null)
            await CopyText($"{selectedMapLocation.X} {selectedMapLocation.Z}");
    }

    private void OpenMapLocationDetails()
    {
        if (selectedMapLocation is not null)
            NavigationManager.NavigateTo($"location/{selectedMapLocation.Rowid}");
    }

    private async Task ToggleHighways()
    {
        showHighways = !showHighways;
        if (mapModule is not null) await mapModule.InvokeVoidAsync("setHighways", GroupMapId, showHighways);
    }

    private async Task ToggleAxes()
    {
        showAxes = !showAxes;
        if (mapModule is not null) await mapModule.InvokeVoidAsync("setAxes", GroupMapId, showAxes);
    }

    private async Task ToggleBorders()
    {
        showBorders = !showBorders;
        if (mapModule is not null) await mapModule.InvokeVoidAsync("setBorders", GroupMapId, showBorders);
    }

    private async Task ToggleEndPortals()
    {
        showEndPortals = !showEndPortals;
        if (mapModule is not null) await mapModule.InvokeVoidAsync("setEndPortals", GroupMapId, showEndPortals);
    }

    private async Task ToggleDay()
    {
        if (!currentPrimaryRenderDayNight) return;
        isDay = !isDay;
        if (mapModule is not null) await mapModule.InvokeVoidAsync("setTimeOfDay", GroupMapId, isDay);
    }

    private async Task CopyText(string text) =>
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);

    private async ValueTask DisposeMapAsync()
    {
        mapReady = false;
        mapInitializationPending = false;
        if (mapModule is not null)
        {
            try { await mapModule.InvokeVoidAsync("dispose", GroupMapId); }
            catch (JSDisconnectedException) { }
            try { await mapModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        mapModule = null;
        mapDotNetRef?.Dispose();
        mapDotNetRef = null;
    }

    public async ValueTask DisposeAsync() => await DisposeMapAsync();

    private void BackToGroups() => NavigationManager.NavigateTo("groups");
    private static string DimensionName(int dimension) => dimension switch { 1 => "Nether", 2 => "End", _ => "Overworld" };
    private static string DimensionSlug(int dimension) => dimension switch { 1 => "nether", 2 => "end", _ => "overworld" };
    private static string MapUrl(GroupLocationSummary location) =>
        $"map?dimension={DimensionSlug(location.Dimension)}&x={location.X}&z={location.Z}&zoom=8";
    private static bool IsVisibleInDimension(int locationDimension, int mapDimension) =>
        locationDimension == mapDimension || locationDimension is 0 or 1 && mapDimension is 0 or 1;
    private sealed record PrimaryRenderInfo(string Id, string Label, bool DayNight);
    private sealed record PrimaryRendersResult(List<string> Current, bool DayNight, List<PrimaryRenderInfo> Renders);
    private static BadgeStyle TypeBadge(GroupType type) => type switch
    {
        GroupType.Build => BadgeStyle.Info,
        GroupType.Highway => BadgeStyle.Warning,
        GroupType.Mixed => BadgeStyle.Success,
        _ => BadgeStyle.Light,
    };
    private static string TypeLabel(GroupType type) => type switch
    {
        GroupType.Build => "Builders",
        GroupType.Highway => "Infrastructure",
        GroupType.Mixed => "Build + infrastructure",
        _ => "Faction / community",
    };
    private static string Monogram(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }
}
