@using Atlas.Locations
@using _2b2tAtlas.Client.Services

<article class="attachment-card @(videoId is not null ? "is-youtube" : kind == "Wiki" ? "is-wiki" : "")">
    <div class="attachment-type">
        <span class="attachment-type-label">
            @if (videoId is not null)
            {
                <svg viewBox="0 0 24 18" width="17" height="13" aria-hidden="true"><path fill="currentColor" d="M23.5 3a3 3 0 0 0-2.1-2.1C19.5.4 12 .4 12 .4S4.5.4 2.6.9A3 3 0 0 0 .5 3C0 4.9 0 9 0 9s0 4.1.5 6a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-6 .5-6s0-4.1-.5-6Z"/><path fill="var(--rz-base-background-color)" d="m9.5 5.3 6.3 3.7-6.3 3.7z"/></svg>
            }
            else
            {
                <RadzenIcon Icon="@icon" Style="font-size:15px" />
            }
            @kind
        </span>
        <span class="attachment-format">@(videoId is not null ? "VIDEO" : extension)</span>
    </div>
    @if (preview is not null || kind is not ("Timeline" or "Article"))
    {
    <a href="@Item.Path" target="_blank" rel="noopener noreferrer" class="attachment-preview" aria-label="Open @title">
        @if (!previewFailed && preview is not null)
        {
            <img src="@preview" alt="" loading="lazy" decoding="async" @onerror="() => previewFailed = true" />
        }
        else
        {
            <span class="attachment-placeholder"><RadzenIcon Icon="@icon" Style="font-size:34px" /></span>
        }
        @if (isVideo)
        {
            <span class="attachment-play" aria-hidden="true"><svg viewBox="0 0 20 20" width="18" height="18"><path fill="currentColor" d="m6 3 11 7-11 7z" /></svg></span>
        }
        @if (startTime is not null)
        {
            <span class="attachment-time">From @startTime</span>
        }
    </a>
    }
    <div class="attachment-content">
        <a class="attachment-title" href="@Item.Path" target="_blank" rel="noopener noreferrer" title="@title">@title</a>
        @if (!string.IsNullOrWhiteSpace(Item.Caption))
        {
            <p class="attachment-caption" title="@Item.Caption">@Item.Caption</p>
        }
        @if (creator is not null)
        {
            <a class="attachment-creator" href="@creator.ChannelUrl" target="_blank" rel="noopener noreferrer" title="Visit @creator.Name on YouTube">
                @if (!avatarFailed)
                {
                    <img src="@creator.AvatarPath" alt="" width="26" height="26" loading="lazy" @onerror="() => avatarFailed = true" />
                }
                else
                {
                    <span class="attachment-avatar-fallback" aria-hidden="true">@creator.Name[..1]</span>
                }
                <span>@creator.Name</span>
            </a>
            @if (!string.IsNullOrWhiteSpace(Item.Attribution) && !string.Equals(Item.Attribution, creator.Name, StringComparison.OrdinalIgnoreCase))
            {
                <span class="attachment-credit" title="@Item.Attribution">@Item.Attribution</span>
            }
        }
        else if (!string.IsNullOrWhiteSpace(Item.Attribution))
        {
            <span class="attachment-credit" title="@Item.Attribution">@Item.Attribution</span>
        }
        <div class="attachment-actions">
            @if (!string.IsNullOrWhiteSpace(Item.SourceUrl))
            {
                <a href="@Item.SourceUrl" target="_blank" rel="noopener noreferrer">Source <span aria-hidden="true">↗</span></a>
            }
            <a href="@(string.IsNullOrWhiteSpace(Item.ApiUrl) ? $"http://127.0.0.1:5297/api/attachments/{Item.Id}" : Item.ApiUrl)" target="_blank" rel="noopener noreferrer" title="Attachment metadata and provenance">Details <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Attachment Item { get; set; } = default!;
    private string? videoId, preview, startTime;
    private string title = "Attachment", kind = "Link", icon = "link", extension = "";
    private YoutubeCreator? creator;
    private bool isVideo, previewFailed, avatarFailed;
    private string? previousPath;

    protected override void OnParametersSet()
    {
        if (previousPath != Item.Path) { previewFailed = avatarFailed = false; previousPath = Item.Path; }
        videoId = YoutubeCreators.VideoId(Item.Path);
        if (videoId is null && Item.MediaType?.Equals("Video", StringComparison.OrdinalIgnoreCase) == true)
            videoId = YoutubeCreators.VideoId(Item.SourceUrl);
        creator = videoId is not null ? YoutubeCreators.Find(videoId, Item.Attribution) : null;
        startTime = YoutubeCreators.StartTime(Item.Path);
        extension = Uri.TryCreate(Item.Path, UriKind.Absolute, out var uri) ? System.IO.Path.GetExtension(uri.AbsolutePath).TrimStart('.').ToUpperInvariant() : "";
        if (extension.Length > 5) extension = "";
        isVideo = videoId is not null || Item.MediaType?.Equals("Video", StringComparison.OrdinalIgnoreCase) == true || extension is "MP4" or "WEBM" or "MOV";
        var wiki = Item.MediaType?.Equals("Wiki", StringComparison.OrdinalIgnoreCase) == true || uri?.AbsolutePath.StartsWith("/wiki/", StringComparison.OrdinalIgnoreCase) == true || uri?.Host.Contains("wiki", StringComparison.OrdinalIgnoreCase) == true || uri?.Host.EndsWith(".miraheze.org", StringComparison.OrdinalIgnoreCase) == true;
        var image = Item.MediaType?.Equals("Image", StringComparison.OrdinalIgnoreCase) == true || extension is "JPG" or "JPEG" or "PNG" or "WEBP" or "GIF" or "AVIF";
        (kind, icon) = videoId is not null ? ("YouTube", "smart_display") : isVideo ? ("Video", "movie") : wiki ? ("Wiki", "menu_book") : image ? ("Image", "image") : extension == "PDF" ? ("Document", "description") : extension is "ZIP" or "7Z" or "RAR" ? ("Archive", "folder_zip") : ("Link", "link");
        if (kind == "Link")
            (kind, icon) = Item.MediaType?.ToLowerInvariant() switch
            {
                "timeline" => ("Timeline", "timeline"),
                "article" => ("Article", "article"),
                _ => (kind, icon),
            };
        preview = !string.IsNullOrWhiteSpace(Item.ThumbnailPath) ? Item.ThumbnailPath : videoId is not null ? $"https://i.ytimg.com/vi/{videoId}/hqdefault.jpg" : image ? Item.Path : wiki ? "Images/wiki.png" : null;
        title = string.IsNullOrWhiteSpace(Item.FileName) ? "Attachment" : Item.FileName;
        foreach (var name in new[] { creator?.Name, Item.Attribution })
            if (!string.IsNullOrWhiteSpace(name))
                foreach (var separator in new[] { " — ", " – ", " - " })
                    if (title.StartsWith(name + separator, StringComparison.OrdinalIgnoreCase)) title = title[(name.Length + separator.Length)..];
    }
}
