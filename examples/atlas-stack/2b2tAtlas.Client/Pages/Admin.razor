        roleWorking = new();
        if (roleMatrix != null)
        {
            foreach (var role in roleMatrix.Roles)
            {
                roleWorking[role] = roleMatrix.Grants.TryGetValue(role, out var g)
                    ? new HashSet<string>(g)
                    : new HashSet<string>();
            }
        }
        isLoadingRoles = false;
        StateHasChanged();
    }

    /// <summary>Toggles a permission for a role in the working copy.</summary>
    private void ToggleRolePerm(string role, string perm, ChangeEventArgs e)
    {
        if (!roleWorking.TryGetValue(role, out var set))
        {
            set = new HashSet<string>();
            roleWorking[role] = set;
        }
        if (e.Value is true) set.Add(perm);
        else set.Remove(perm);
    }

    /// <summary>Persists a role's working permission set.</summary>
    private async Task SaveRole(string role)
    {
        var perms = roleWorking.TryGetValue(role, out var s) ? s.ToList() : new List<string>();
        var updated = await RoleService.SetRoleAsync(role, perms);
        if (updated != null)
        {
            roleMatrix = updated;
            RebuildRoleWorking();
            NotificationService.Notify(NotificationSeverity.Success, "Role updated", $"{role}: {perms.Count} permission(s)");
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, "Save failed", "You may not have permission.");
        }
    }

