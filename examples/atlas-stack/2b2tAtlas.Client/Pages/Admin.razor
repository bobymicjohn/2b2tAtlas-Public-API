    private async Task AddUser()
    {
        try
        {
            var token = await AuthService.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                HttpClient.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                var request = new Atlas.Auth.CreateUserRequest
                    {
                        Username = newUser.Username,
                        Password = newUser.PasswordHash, // Using PasswordHash field to store plain password temporarily
                        DiscordHandle = newUser.DiscordHandle,
                        Role = newUser.Role,
                        IsAdmin = newUser.IsAdmin,
                        IsActive = newUser.IsActive
                    };

                var response = await HttpClient.PostAsJsonAsync("api/admin/users", request);

                if (response.IsSuccessStatusCode)
                {
                    await ShowSuccessNotification("User added successfully");
                    await LoadUsers();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"Error response: {error}");
                    await ShowErrorNotification($"Failed to add user: {error}");
                }
            }
            else
            {
                Console.WriteLine("No token available");
                await ShowErrorNotification("Authentication token not available");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in AddUser: {ex.Message}");
            await ShowErrorNotification($"An error occurred: {ex.Message}");
        }
    }

