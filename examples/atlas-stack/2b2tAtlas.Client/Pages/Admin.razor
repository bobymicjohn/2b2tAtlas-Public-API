        await ApplyPreviewImage();
    }

    private async Task PreviewPrimaryChanged(string id, ChangeEventArgs args)
    {
        var enabled = args.Value is bool value && value;
        if (enabled) previewSelectedRenders.Add(id);
        else previewSelectedRenders.Remove(id);
        if (previewMapModule is not null)
            await previewMapModule.InvokeVoidAsync(
                "setRenders", "render-settings-preview-map", previewSelectedRenders.ToArray());
    }

    private async Task ClearPreviewPrimaryLayers()
    {
        previewSelectedRenders.Clear();
        if (previewMapModule is not null)
            await previewMapModule.InvokeVoidAsync(
                "setRenders", "render-settings-preview-map", Array.Empty<string>());
    }

    private async Task PreviewOpacityChanged(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var opacity))
            previewOpacity = Math.Clamp(opacity, 0, 1);
        if (previewMapModule is not null)
            await previewMapModule.InvokeVoidAsync(
                "setRenderPreviewOpacity", "render-settings-preview-map", previewOpacity);
    }

    /// <summary>Confirms and queues replacement of every existing location render.</summary>
    private async Task RerenderEverything()
    {
        var confirmed = await DialogService.Confirm(
            "This queues every existing location render for rebuilding from its archived WDL. The worker runs them sequentially and keeps the current tiles until each replacement is ready. Continue?",
            "Re-render every WDL",
            new ConfirmOptions { OkButtonText = "Queue all renders", CancelButtonText = "Cancel" });
        if (confirmed != true) return;

        isQueuingRerender = true;
        StateHasChanged();
        var (ok, result, error) = await RenderSettingsService.RerenderAllAsync();
        isQueuingRerender = false;
        rerenderStatus = await RenderSettingsService.GetRerenderStatusAsync();
        if (ok)
