    private IReadOnlyList<string> AssignableRoles()
    {
        var callerRole = currentUser?.Role;
        var callerIsSuperAdmin = currentUser?.IsSuperAdmin ?? false;
        return RoleNames.All
            .Where(role => RoleNames.CanAssign(callerRole, role, callerIsSuperAdmin))
            .ToList();
    }

