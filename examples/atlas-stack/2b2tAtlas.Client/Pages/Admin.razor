    private async Task InitializePreviewComparisonMap()
    {
        if (previewResult is not { Ok: true, ImageBase64: not null }) return;
        previewMapModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", MapModuleAsset.Url);
        await previewMapModule.InvokeVoidAsync("setApiBase", HttpClient.BaseAddress?.ToString());
        var registered = await MapRenderService.GetPublishedAsync();
        if (registered.Count > 0)
            await previewMapModule.InvokeVoidAsync("registerWorldRenders", registered);
        await previewMapModule.InvokeVoidAsync(
            "initialize", "render-settings-preview-map", previewDimension, previewIsDay, null);
        var renders = await previewMapModule.InvokeAsync<PreviewRendersResult>(
            "getRenders", "render-settings-preview-map");
        previewPrimaryOptions = renders.Renders;
        previewSelectedRenders = renders.Current.ToHashSet(StringComparer.Ordinal);
        await ApplyPreviewImage();
        StateHasChanged();
    }

    private async Task ApplyPreviewImage()
    {
        if (previewMapModule is null || previewResult is not { Ok: true }) return;
        var base64 = previewIsDay ? previewResult.ImageBase64 : previewResult.NightImageBase64;
        await previewMapModule.InvokeVoidAsync(
            "setTimeOfDay", "render-settings-preview-map", previewIsDay);
        await previewMapModule.InvokeVoidAsync(
            "setRenderPreview", "render-settings-preview-map",
            string.IsNullOrWhiteSpace(base64) ? null : "data:image/png;base64," + base64,
            previewResult.MinX, previewResult.MinZ, previewResult.MaxXExclusive, previewResult.MaxZExclusive);
        await previewMapModule.InvokeVoidAsync(
            "setRenderPreviewOpacity", "render-settings-preview-map", previewOpacity);
    }

    private async Task SetPreviewDay(bool isDay)
    {
