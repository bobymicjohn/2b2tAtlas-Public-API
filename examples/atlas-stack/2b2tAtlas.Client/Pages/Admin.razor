        await grid.Reload();
        // If rows disappeared, use the last valid page; retain sorting/filters.
        var lastPage = Math.Max(0, (grid.View.Count() - 1) / grid.PageSize);
        if (grid.CurrentPage > lastPage) await grid.GoToPage(lastPage);
    }
