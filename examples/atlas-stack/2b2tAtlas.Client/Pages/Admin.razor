    {
        < 60 => $"{Math.Max(1, seconds)} sec",
        < 3600 => $"{Math.Max(1, (int)Math.Ceiling(seconds / 60d))} min",
        _ => $"{seconds / 3600d:0.#} hr",
    };

    /// <summary>Cancels and joins the ingestion-status polling loop, then releases its cancellation source.</summary>
    public async ValueTask DisposeAsync()
    {
        enrichmentPollCancellation.Cancel();
        if (enrichmentPollTask is not null)
        {
            try { await enrichmentPollTask; }
            catch (OperationCanceledException) { }
        }
        enrichmentPollCancellation.Dispose();
        ingestionPollCancellation.Cancel();
        if (ingestionPollTask is not null)
        {
            try { await ingestionPollTask; }
            catch (OperationCanceledException) { }
        }
        ingestionPollCancellation.Dispose();
        if (previewMapModule is not null)
        {
            try { await previewMapModule.InvokeVoidAsync("dispose", "render-settings-preview-map"); }
            catch (JSDisconnectedException) { }
            await previewMapModule.DisposeAsync();
        }
    }

