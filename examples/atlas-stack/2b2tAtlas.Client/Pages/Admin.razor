    private int RequestedAdminTabIndex()
    {
        var query = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query.TrimStart('?');
        var requested = query.Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .Where(parts => parts.Length == 2 && string.Equals(parts[0], "tab", StringComparison.OrdinalIgnoreCase))
            .Select(parts => Uri.UnescapeDataString(parts[1]).ToLowerInvariant())
            .FirstOrDefault();

        var tabs = new List<(string Key, bool Visible)>
        {
            ("users", canManageUsers),
            ("locations", canManageLocations),
            ("moderation", canModerate),
            ("enrichment", canModerate),
            ("audit", canViewAudit),
            ("groups", canManageGroups),
            ("highways", canManageHighways),
            ("roles", canManageRoleProfiles),
            ("rendersettings", canManageRenderSettings),
        };
        var visibleIndex = 0;
        foreach (var tab in tabs)
        {
            if (!tab.Visible) continue;
            if (tab.Key == requested) return visibleIndex;
            visibleIndex++;
        }
        return 0;
    }

