    private static string FormatStorage(long bytes)
    {
        if (bytes <= 0) return "—";
        var units = new[] { "B", "KiB", "MiB", "GiB", "TiB" };
        var value = (double)bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }
        return $"{value:0.#} {units[unit]}";
    }

