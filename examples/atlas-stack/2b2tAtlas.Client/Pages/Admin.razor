@page "/admin"
@using Blazored.LocalStorage
@using _2b2tAtlas.Client.Services
@using Atlas.Auth
@using Atlas
@using Atlas.Enrichment
@using Atlas.Ingestion
@using Group = Atlas.Group
@using Atlas.Locations
@using System.Linq
@using System.Text.Json
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject HttpClient HttpClient
@inject HighwayService HighwayService
@inject GroupService GroupService
@inject RoleService RoleService
@inject RevisionService RevisionService
@inject EnrichmentService EnrichmentService
@inject RenderSettingsService RenderSettingsService
@inject MapRenderService MapRenderService
@inject IJSRuntime JSRuntime
@inject DialogService DialogService
@inject NotificationService NotificationService
@implements IAsyncDisposable

<PageTitle>Admin Panel - 2b2t Atlas</PageTitle>

<CascadingValue Value="@themeIndex" Name="ThemeIndex">
    <div class="admin-page-shell">
        @if (isLoading)
        {
            <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
                <div class="lds-ring"><div></div><div></div><div></div><div></div></div>
            </div>
        }
        else
        {
            @if (!isAuthenticated)
            {
                <RadzenCard class="rz-mx-auto" Style="max-width: 400px; margin-top: 2rem;">
                    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-color-danger">
                        <RadzenIcon Icon="lock" class="rz-me-1" /> Access Denied
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1">
                        You must be logged in to access the admin panel.
                    </RadzenText>
                    <RadzenButton Text="Go to Login"
                                  Icon="login"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => NavigationManager.NavigateTo("/login"))"
                                  class="rz-mt-3" />
                </RadzenCard>
            }
            else if (!canAccessAdmin)
            {
                <RadzenCard class="rz-mx-auto" Style="max-width: 440px; margin-top: 2rem;">
                    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-color-danger">
                        <RadzenIcon Icon="lock" class="rz-me-1" /> Access Denied
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1">
                        Your account (<strong>@currentUser?.Username</strong>) doesn't have permission to use the admin panel.
                    </RadzenText>
                    <RadzenButton Text="Back to map"
                                  Icon="home"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => NavigationManager.NavigateTo("/"))"
                                  class="rz-mt-3" />
                </RadzenCard>
            }
            else
            {
                <RadzenRow Gap="2rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H4" class="rz-mb-3">
                                <RadzenIcon Icon="person" class="rz-me-1" /> User Profile
                            </RadzenText>

                            <div style="text-align: center; margin-bottom: 1rem;">
                                <img src="@UserAvatar.Url(currentUser)"
                                     alt="@currentUser?.Username Avatar"
                                     style="width: 80px; height: 80px; border-radius: 8px; border: 2px solid #ddd;"
                                     onerror="this.src='./Images/logo.png'" />
                            </div>

                            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-2">
                                <strong>Username:</strong> @currentUser?.Username
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-2">
                                <strong>Discord:</strong> @currentUser?.DiscordHandle
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-2">
                                <strong>Role:</strong>
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@currentUser?.Role" class="rz-ms-1" />
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-2">
                                <strong>Last Login:</strong> @(currentUser?.LastLoginAt?.ToString("MMM dd, yyyy hh:mm tt") ?? "Never")
                            </RadzenText>
                        </RadzenCard>
                    </RadzenColumn>

                    @if (canManageUsers)
                    {
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H4" class="rz-mb-3">
                                <RadzenIcon Icon="dashboard" class="rz-me-1" /> Database Stats
                            </RadzenText>

                            @if (isLoading)
                            {
                                <RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary">
                                    Loading statistics...
                                </RadzenText>
                            }
                            else if (databaseStats != null)
                            {
                                <RadzenRow Gap="1rem" class="rz-mb-3">
                                    <RadzenColumn Size="6" SizeMD="3">
                                        <RadzenCard class="stats-card stats-card-locations">
                                            <RadzenText TextStyle="TextStyle.H4" class="rz-mb-1 stats-number">@databaseStats.Locations</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" class="stats-label">Total Locations</RadzenText>
                                        </RadzenCard>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="3">
                                        <RadzenCard class="stats-card stats-card-warps">
                                            <RadzenText TextStyle="TextStyle.H4" class="rz-mb-1 stats-number">@databaseStats.Warps</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" class="stats-label">Total Warps</RadzenText>
                                        </RadzenCard>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="3">
                                        <RadzenCard class="stats-card stats-card-renders">
                                            <RadzenText TextStyle="TextStyle.H4" class="rz-mb-1 stats-number">@databaseStats.Renders</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" class="stats-label">Total Renders</RadzenText>
                                        </RadzenCard>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="3">
                                        <RadzenCard class="stats-card stats-card-attachments">
                                            <RadzenText TextStyle="TextStyle.H4" class="rz-mb-1 stats-number">@databaseStats.Attachments</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" class="stats-label">Total Attachments</RadzenText>
                                        </RadzenCard>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow Gap="1rem" class="rz-mb-3">
                                    <RadzenColumn Size="6" SizeMD="3">
                                        <RadzenCard class="stats-card stats-card-locations-monthly">
                                            <RadzenText TextStyle="TextStyle.H4" class="rz-mb-1 stats-number">@databaseStats.LocationsMonth</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" class="stats-label">Monthly Locations</RadzenText>
                                        </RadzenCard>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="3">
                                        <RadzenCard class="stats-card stats-card-warps-monthly">
                                            <RadzenText TextStyle="TextStyle.H4" class="rz-mb-1 stats-number">@databaseStats.WarpsMonth</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" class="stats-label">Monthly Warps</RadzenText>
                                        </RadzenCard>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="3">
                                        <RadzenCard class="stats-card stats-card-renders-monthly">
                                            <RadzenText TextStyle="TextStyle.H4" class="rz-mb-1 stats-number">@databaseStats.RendersMonth</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" class="stats-label">Monthly Renders</RadzenText>
                                        </RadzenCard>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="3">
                                        <RadzenCard class="stats-card stats-card-attachments-monthly">
                                            <RadzenText TextStyle="TextStyle.H4" class="rz-mb-1 stats-number">@databaseStats.AttachmentsMonth</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" class="stats-label">Monthly Attachments</RadzenText>
                                        </RadzenCard>
                                    </RadzenColumn>
                                </RadzenRow>
                            }
                        </RadzenCard>
                    </RadzenColumn>
                    }
                </RadzenRow>

                <!-- Admin Management Tabs -->
                <RadzenCard class="admin-tabs rz-mt-4">
                    <RadzenTabs @bind-SelectedIndex="selectedAdminTabIndex" RenderMode="TabRenderMode.Client">
                        <Tabs>
                            @if (canManageUsers)
                            {
                            <RadzenTabsItem Text="User Management">
                                <div class="rz-d-flex rz-justify-content-between rz-align-items-center rz-mb-3">
                                    <RadzenButton Text="Add User" Icon="person_add" ButtonStyle="ButtonStyle.Success"
                                                  Click="@ShowAddUserDialog" />
                                </div>

                                @if (isLoadingUsers)
                                {
                                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                                    <RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary rz-mt-2">
                                        Loading users...
                                    </RadzenText>
                                }
                                else if (users == null || !users.Any())
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                                        No users found.
                                    </RadzenAlert>
                                }
                                else
                                {
                                    <RadzenDataGrid @ref="usersGrid" Data="@users" TItem="User" AllowPaging="true" PageSize="10"
                                                    AllowSorting="true" AllowColumnResize="true" GridLines="DataGridGridLines.Both">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="User" Property="Id" Title="ID" Width="60px" />
                                            <RadzenDataGridColumn TItem="User" Property="Username" Title="Username" Width="150px">
                                                <Template Context="user">
                                                    <div class="rz-d-flex rz-align-items-center">
                                                        <img src="@UserAvatar.Url(user)"
                                                             alt="@user.Username Avatar"
                                                             style="width: 32px; height: 32px; border-radius: 4px; margin-right: 8px;"
                                                             onerror="this.src='./Images/logo.png'" />
                                                        @user.Username
                                                    </div>
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="User" Property="DiscordHandle" Title="Discord" Width="200px" />
                                            <RadzenDataGridColumn TItem="User" Property="Role" Title="Role" Width="100px">
                                                <Template Context="user">
                                                    <RadzenBadge BadgeStyle="@(user.IsAdmin ? BadgeStyle.Danger : BadgeStyle.Info)"
                                                                 Text="@RoleNames.DisplayName(user.Role)" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="User" Property="IsActive" Title="Status" Width="80px">
                                                <Template Context="user">
                                                    <RadzenBadge BadgeStyle="@(user.IsActive ? BadgeStyle.Success : BadgeStyle.Secondary)"
                                                                 Text="@(user.IsActive ? "Active" : "Inactive")" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="User" Property="CreatedAt" Title="Created" Width="120px">
                                                <Template Context="user">
                                                    @user.CreatedAt.ToString("MMM dd, yyyy")
                                                </Template>
                                            </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="User" Title="Actions" Width="120px" Sortable="false">
                                                    <Template Context="user">
                                                        @if (CanManageUser(user))
                                                        {
                                                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                                          Click="@(() => ShowEditUserDialog(user))"
                                                                      class="rz-me-1" />
                                                            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                                          Click="@(() => ShowDeleteUserConfirmation(user))" />
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                }
                            </RadzenTabsItem>
                            }

                            @if (canManageLocations || canManageRenders)
                            {
                            <RadzenTabsItem Text="Location Management">
                                @if (canManageRenders)
                                {
                                    <RadzenFieldset AllowCollapse="true" Collapsed="true" class="collector-panel rz-mb-3">
                                        <HeaderTemplate>
                                            <div class="collector-heading">
                                                <span class="collector-heading-title"><RadzenIcon Icon="radar" /> Archive Collector</span>
                                                @if (collectorStatus is not null)
                                                {
                                                    <RadzenBadge BadgeStyle="@GetCollectorStatusBadge(collectorStatus)" Text="@collectorStatus.Status" />
                                                    <span class="collector-heading-count">@collectorStatus.Saved.ToString("N0") / @collectorStatus.QueueTotal.ToString("N0") saved</span>
                                                }
                                            </div>
                                        </HeaderTemplate>
                                        <ChildContent>
                                            @if (isLoadingCollectorStatus && collectorStatus is null)
                                            {
                                                <div class="collector-loading">
                                                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                                                               Size="ProgressBarCircularSize.Small" />
                                                    <span>Reading collector status from example host…</span>
                                                </div>
                                            }
                                            else if (collectorStatus is null)
                                            {
                                                <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                                                    Collector status is unavailable. @(collectorStatusError ?? "Try refreshing in a moment.")
                                                </RadzenAlert>
                                            }
                                            else
                                            {
                                                <div class="collector-toolbar">
                                                    <div>
                                                        <div class="collector-operation">@collectorStatus.Phase</div>
                                                        <div class="collector-updated">Status updated @FormatCollectorDate(collectorStatus.UpdatedUtc)</div>
                                                    </div>
                                                    <RadzenButton Icon="refresh" Text="Refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                                  Disabled="@isLoadingCollectorStatus" Click="@(() => LoadCollectorStatus())" />
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(collectorStatusError))
                                                {
                                                    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false" class="rz-mb-3">
                                                        Live refresh failed: @collectorStatusError. Showing the most recent snapshot.
                                                    </RadzenAlert>
                                                }

                                                @if (!collectorStatus.Available)
                                                {
                                                    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false" class="rz-mb-3">
                                                        @collectorStatus.Phase
                                                    </RadzenAlert>
                                                }
                                                else
                                                {
                                                    <div class="collector-progress-line">
                                                        <span>Initial applicable candidates</span>
                                                        <strong>@collectorStatus.ProgressPercent.ToString("0.0")%</strong>
                                                    </div>
                                                    <RadzenProgressBar Value="@collectorStatus.ProgressPercent" ShowValue="false" class="collector-progress" />
                                                    <div class="collector-progress-caption">
                                                        @collectorStatus.Checked.ToString("N0") of @collectorStatus.QueueTotal.ToString("N0") checked
                                                    </div>

                                                    <div class="collector-kpis">
                                                        <div class="collector-kpi collector-kpi-saved"><strong>@collectorStatus.Saved.ToString("N0")</strong><span>WDLs saved</span></div>
                                                        <div class="collector-kpi collector-kpi-unavailable"><strong>@collectorStatus.Unavailable.ToString("N0")</strong><span>Unavailable</span></div>
                                                        <div class="collector-kpi"><strong>@collectorStatus.Remaining.ToString("N0")</strong><span>Remaining</span></div>
                                                        <div class="collector-kpi"><strong>@collectorStatus.Retryable.ToString("N0")</strong><span>Retryable</span></div>
                                                    </div>

                                                    <div class="collector-section-title">
                                                        <span>Workers</span>
                                                        <span>@collectorStatus.ActiveWorkers / @collectorStatus.Workers.Count capturing · @collectorStatus.FastLaneWorkers fast · @collectorStatus.LongRunningWorkers long · @collectorStatus.DeferredToLongRunning deferred</span>
                                                    </div>
                                                    <div class="collector-workers">
                                                        @foreach (var worker in collectorStatus.Workers.OrderBy(worker => worker.Id))
                                                        {
                                                            <div class="collector-worker">
                                                                <div class="collector-worker-identity">
                                                                    <strong>Worker @worker.Id</strong>
                                                                    <span>@worker.Profile</span>
                                                                    <span class="collector-worker-lane">@(worker.Lane == "throughput" ? "Fast · 30m" : worker.Lane == "temporary-long" ? "Fast → long · 12h" : "Long · 12h")</span>
                                                                    @if (!string.IsNullOrWhiteSpace(worker.MinecraftVersion))
                                                                    {
                                                                        <span>@FormatCollectorMinecraftVersion(worker.MinecraftVersion)</span>
                                                                    }
                                                                </div>
                                                                <RadzenBadge BadgeStyle="@GetCollectorWorkerBadge(worker)" Text="@worker.Status" />
                                                                <div class="collector-worker-warp" title="@worker.Warp">
                                                                    @if (!string.IsNullOrWhiteSpace(worker.Warp))
                                                                    {
                                                                        <code>/warp @worker.Warp</code>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="rz-text-secondary">Waiting for assignment</span>
                                                                    }
                                                                </div>
                                                                <div class="collector-worker-stat">
                                                                    <span>Chunks</span><strong>@FormatCollectorCount(worker.ChunksReceived)</strong>
                                                                </div>
                                                                <div class="collector-worker-stat">
                                                                    <span>Missing</span><strong>@FormatCollectorCount(worker.MissingChunks)</strong>
                                                                </div>
                                                                <div class="collector-worker-stat">
                                                                    <span>Scan</span><strong>@FormatCollectorWaypoint(worker)</strong>
                                                                </div>
                                                                <div class="collector-worker-stat">
                                                                    <span>Shard</span><strong>@worker.Completed.ToString("N0") / @worker.Assigned.ToString("N0")</strong>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="collector-footer">
                                                        <span><strong>Catalog:</strong> @collectorStatus.CatalogDiscovered.ToString("N0") discovered</span>
                                                        <span><strong>Production:</strong> @collectorStatus.HandoffStage@if (collectorStatus.HandoffSubmitted > 0){<text> · @collectorStatus.HandoffSubmitted.ToString("N0") submitted</text>}</span>
                                                        <span><strong>Next check:</strong> @FormatCollectorDate(collectorStatus.NextScheduledRun)</span>
                                                    </div>
                                                }
                                            }
                                        </ChildContent>
                                    </RadzenFieldset>

                                    <RadzenFieldset AllowCollapse="true" Collapsed="true" class="collector-panel bluemap-monitor rz-mb-3">
                                        <HeaderTemplate>
                                            <div class="collector-heading">
                                                <span class="collector-heading-title"><RadzenIcon Icon="view_in_ar" /> BlueMap 3D Generation</span>
                                                @if (blueMapStatus is not null)
                                                {
                                                    <RadzenBadge BadgeStyle="@GetBlueMapStatusBadge(blueMapStatus)" Text="@blueMapStatus.Status" />
                                                    <span class="collector-heading-count">@blueMapStatus.ValidatedRenderCount.ToString("N0") / @blueMapStatus.EligibleRenderCount.ToString("N0") validated</span>
                                                }
                                            </div>
                                        </HeaderTemplate>
                                        <ChildContent>
                                            @if (isLoadingBlueMapStatus && blueMapStatus is null)
                                            {
                                                <div class="collector-loading">
                                                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                                                               Size="ProgressBarCircularSize.Small" />
                                                    <span>Reading BlueMap generation status from example host…</span>
                                                </div>
                                            }
                                            else if (blueMapStatus is null)
                                            {
                                                <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                                                    BlueMap status is unavailable. @(blueMapStatusError ?? "Try refreshing in a moment.")
                                                </RadzenAlert>
                                            }
                                            else
                                            {
                                                <div class="collector-toolbar">
                                                    <div>
                                                        <div class="collector-operation">@blueMapStatus.Phase</div>
                                                        <div class="collector-updated">Latest renderer activity @FormatCollectorDate(blueMapStatus.LatestActivityUtc ?? blueMapStatus.UpdatedUtc)</div>
                                                    </div>
                                                    <RadzenButton Icon="refresh" Text="Refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                                  Disabled="@isLoadingBlueMapStatus" Click="@(() => LoadBlueMapStatus())" />
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(blueMapStatusError))
                                                {
                                                    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false" class="rz-mb-3">
                                                        Live refresh failed: @blueMapStatusError. Showing the most recent snapshot.
                                                    </RadzenAlert>
                                                }

                                                @if (!blueMapStatus.Available)
                                                {
                                                    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false" class="rz-mb-3">
                                                        @blueMapStatus.Phase
                                                    </RadzenAlert>
                                                }
                                                else
                                                {
                                                    <div class="collector-progress-line">
                                                        <span>Validated source-backed 3D derivatives</span>
                                                        <strong>@BlueMapCatalogProgressPercent(blueMapStatus).ToString("0.0")%</strong>
                                                    </div>
                                                    <RadzenProgressBar Value="@BlueMapCatalogProgressPercent(blueMapStatus)" ShowValue="false" class="collector-progress" />
                                                    <div class="collector-progress-caption">
                                                        @blueMapStatus.ValidatedRenderCount.ToString("N0") of @blueMapStatus.EligibleRenderCount.ToString("N0") eligible renders are selectable in 3D
                                                    </div>

                                                    @if (blueMapStatus.PendingAfterSnapshot > 0)
                                                    {
                                                        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false" class="rz-mt-3">
                                                            @blueMapStatus.PendingAfterSnapshot.ToString("N0") newly ingested render@(blueMapStatus.PendingAfterSnapshot == 1 ? " is" : "s are") awaiting @(blueMapStatus.Coordinated ? "the next automatic discovery (within one minute)." : "the next automatic pass.")
                                                        </RadzenAlert>
                                                    }

                                                    <div class="collector-kpis">
                                                        <div class="collector-kpi collector-kpi-saved"><strong>@blueMapStatus.ValidatedRenderCount.ToString("N0")</strong><span>Validated</span></div>
                                                        <div class="collector-kpi"><strong>@blueMapStatus.RemainingRenderCount.ToString("N0")</strong><span>Remaining</span></div>
                                                        <div class="collector-kpi"><strong>@blueMapStatus.BatchCompleted.ToString("N0") / @blueMapStatus.BatchTotal.ToString("N0")</strong><span>@(blueMapStatus.Coordinated ? "Discovered catalog" : "Current pass")</span></div>
                                                        <div class="collector-kpi"><strong>@FormatStorage(blueMapStatus.OutputBytes)</strong><span>3D storage</span></div>
                                                    </div>

                                                    @foreach (var worker in blueMapStatus.Workers)
                                                    {
                                                        <div class="bluemap-current-job">
                                                            <div>
                                                                <span class="bluemap-current-label">Worker @worker.WorkerId · @worker.State · @worker.Stage</span>
                                                                @if (worker.Current is not null)
                                                                {
                                                                    <a href="@($"/location/{worker.Current.LocationId}")">@worker.Current.LocationName</a>
                                                                    <small>Render #@worker.Current.RenderId · @FriendlyBlueMapDimension(worker.Current.Dimension)</small>
                                                                }
                                                                else { <small>Waiting for eligible work</small> }
                                                                @if (worker.StartedUtc is not null)
                                                                {
                                                                    <small>Elapsed @((DateTimeOffset.UtcNow - worker.StartedUtc.Value).TotalMinutes.ToString("0")) min · Activity @FormatCollectorDate(worker.UpdatedUtc)</small>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (blueMapStatus.Current is not null)
                                                    {
                                                        <div class="bluemap-current-job">
                                                            <div>
                                                                <span class="bluemap-current-label">Now generating</span>
                                                                <a href="@($"/location/{blueMapStatus.Current.LocationId}")">@blueMapStatus.Current.LocationName</a>
                                                                <small>Render #@blueMapStatus.Current.RenderId.ToString("N0")</small>
                                                            </div>
                                                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@FriendlyBlueMapDimension(blueMapStatus.Current.Dimension)" />
                                                        </div>
                                                    }

                                                    <div class="collector-section-title bluemap-dimension-title">
                                                        <span>Validated dimensions</span>
                                                        <span>@blueMapStatus.OverworldValidated.ToString("N0") Overworld · @blueMapStatus.NetherValidated.ToString("N0") Nether · @blueMapStatus.EndValidated.ToString("N0") End</span>
                                                    </div>
                                                    <div class="collector-footer">
                                                        <span><strong>Quality gate:</strong> profile @blueMapStatus.MinimumProfileVersion.ToString("N0")</span>
                                                        <span><strong>Retained generations:</strong> @blueMapStatus.DiagnosticGenerationCount.ToString("N0")</span>
                                                        <span><strong>Failures this pass:</strong> @blueMapStatus.FailedRenderCount.ToString("N0")</span>
                                                        <span><strong>Quota:</strong> @FormatStorage(blueMapStatus.OutputBytes) / @FormatStorage(blueMapStatus.OutputQuotaBytes)</span>
                                                        <span><strong>Output volume free:</strong> @FormatStorage(blueMapStatus.OutputDriveFreeBytes)</span>
                                                    </div>
                                                }
                                            }
                                        </ChildContent>
                                    </RadzenFieldset>
                                }

                                <div class="rz-d-flex rz-justify-content-between rz-align-items-center rz-mb-3">
                                    @if (canCreateLocations || canManageRenders)
                                    {
                                        <RadzenFieldset AllowCollapse="false" Style="width: 100%; margin: 17px auto;">
                                            <HeaderTemplate>
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                                    <RadzenIcon Icon="add" /><b>Add Location</b>
                                                </RadzenStack>
                                            </HeaderTemplate>
                                            <ChildContent>
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
                                                    @if (canCreateLocations)
                                                    {
                                                        <RadzenButton Text="Manually" Icon="add_location" ButtonStyle="ButtonStyle.Success"
                                                                      Click="@ShowAddLocationDialog" />
                                                    }
                                                    @if (canManageRenders)
                                                    {
                                                        <RadzenButton Text="From World Download" Icon="globe_location_pin"
                                                                      ButtonStyle="ButtonStyle.Success" Click="@ShowIngestionJobDialog" />
                                                        <RadzenButton Text="Bulk Upload" Icon="drive_folder_upload"
                                                                      ButtonStyle="ButtonStyle.Info" Click="@ShowBulkIngestionDialog" />
                                                    }
                                                </RadzenStack>
                                            </ChildContent>
                                        </RadzenFieldset>

                                    }
                                </div>

                                @if (canManageRenders)
                                {
                                    <RadzenFieldset Text="World Download Jobs" AllowCollapse="true" class="rz-mb-3">
                                        @if (ingestionJobs.Count(job => job.Status == "needs-match") is var needsReview && needsReview > 0)
                                        {
                                            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false" class="rz-mb-2">
                                                <strong>@needsReview WDL job@(needsReview == 1 ? " needs" : "s need") a decision.</strong>
                                                Use the orange link button to attach the render to an existing location or confirm a new one.
                                                Everything else continues automatically.
                                            </RadzenAlert>
                                        }
                                        <div class="rz-d-flex rz-justify-content-between rz-align-items-center rz-mb-2">
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.4rem" AlignItems="AlignItems.Center">
                                                <RadzenCheckBox @bind-Value="@showIngestionExceptionsOnly" @bind-Value:after="RefreshDisplayedIngestionJobs" Name="wdlExceptionsOnly" TValue="bool" />
                                                <RadzenLabel Component="wdlExceptionsOnly" Text="Only jobs needing attention" />
                                            </RadzenStack>
                                            <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                          Click="@(() => LoadIngestionJobs())" title="Refresh jobs" />
                                        </div>
                                        @if (isLoadingIngestionJobs && ingestionJobs.Count == 0)
                                        {
                                            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                                                       Size="ProgressBarCircularSize.Small" />
                                        }
                                        else if (!ingestionJobs.Any())
                                        {
                                            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary">No world download jobs.</RadzenText>
                                        }
                                        else
                                        {
                                            <div class="mobile-admin-list mobile-wdl-list">
                                                @foreach (var job in DisplayedIngestionJobs.Take(20))
                                                {
                                                    <article @key="job.Id" class="mobile-admin-card @(job.Status == "needs-match" ? "needs-attention" : string.Empty)">
                                                        <header>
                                                            <div>
                                                                @if (job.ExistingLocationId is int mobileLocationId)
                                                                {
                                                                    <RadzenLink Path="@($"location/{mobileLocationId}")" Text="@job.Name" />
                                                                }
                                                                else
                                                                {
                                                                    <strong>@job.Name</strong>
                                                                }
                                                                <small>@job.RequestedUtc.ToLocalTime().ToString("MMM d, h:mm tt")</small>
                                                            </div>
                                                            <RadzenBadge BadgeStyle="@GetIngestionStatusBadge(job.Status)" Text="@job.Status" />
                                                        </header>
                                                        <div class="mobile-admin-meta">
                                                            <span><strong>Stage</strong>@job.Stage</span>
                                                            <span><strong>Decision</strong>@(job.MatchDecision ?? "pending")@(job.MatchConfidence is double mobileConfidence ? $" · {mobileConfidence:P0}" : string.Empty)</span>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(job.ArchiveWarpName))
                                                        {
                                                            <code class="mobile-admin-code">/warp @job.ArchiveWarpName</code>
                                                        }
                                                        <RadzenProgressBar Value="@job.ProgressPercent" ShowValue="true" Style="height: 18px" />
                                                        @if (!string.IsNullOrWhiteSpace(job.Message))
                                                        {
                                                            <p class="mobile-admin-note">@job.Message</p>
                                                        }
                                                        @if (job.Inspection is { } mobileInspection)
                                                        {
                                                            <details class="mobile-admin-details">
                                                                <summary>World inspection</summary>
                                                                <div class="wdl-inspection">
                                                                    <strong>@(mobileInspection.VersionName ?? "Unknown version")</strong>
                                                                    <span>@mobileInspection.StorageEra · @(mobileInspection.LevelName ?? "Unnamed world")</span>
                                                                    @foreach (var dimension in mobileInspection.Dimensions)
                                                                    {
                                                                        <span>@dimension.Key: @dimension.ChunkCount.ToString("N0") chunks</span>
                                                                    }
                                                                </div>
                                                            </details>
                                                        }
                                                        <footer>
                                                            @if (job.Status == "needs-match")
                                                            {
                                                                <RadzenButton Text="Resolve match" Icon="link" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                                                              Click="@(() => ShowMatchDialog(job))" />
                                                            }
                                                            @if (job.Status == "queued" || job.Status == "needs-match")
                                                            {
                                                                <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                                              Click="@(() => CancelIngestionJob(job))" />
                                                            }
                                                        </footer>
                                                    </article>
                                                }
                                                @if (DisplayedIngestionJobs.Count() > 20)
                                                {
                                                    <div class="mobile-admin-limit">Showing the 20 newest matching jobs. Use “Only jobs needing attention” to narrow the queue.</div>
                                                }
                                            </div>
                                            <RadzenDataGrid class="desktop-admin-grid" @ref="ingestionJobsGrid" Data="@DisplayedIngestionJobs" KeyProperty="Id" TItem="IngestionJobDto" AllowPaging="true" PageSize="10"
                                                            AllowSorting="true" GridLines="DataGridGridLines.Both" RowRender="@OnIngestionRowRender">
                                                <Columns>
                                                    <RadzenDataGridColumn TItem="IngestionJobDto" Property="Name" Title="Render">
                                                        <Template Context="job">
                                                            @if (job.ExistingLocationId is int locationId)
                                                            {
                                                                <RadzenLink Path="@($"location/{locationId}")" Text="@job.Name" />
                                                            }
                                                            else
                                                            {
                                                                <span>@job.Name</span>
                                                            }
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="IngestionJobDto" Property="OriginalFileName" Title="WDL file">
                                                        <Template Context="job">@(job.OriginalFileName ?? job.IntakeFileName)</Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="IngestionJobDto" Property="Status" Title="Status" Width="110px">
                                                        <Template Context="job">
                                                            <RadzenBadge BadgeStyle="@GetIngestionStatusBadge(job.Status)" Text="@job.Status" />
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="IngestionJobDto" Property="Stage" Title="Stage" Width="110px" />
                                                    <RadzenDataGridColumn TItem="IngestionJobDto" Title="Location / warp decision" Width="250px" Sortable="false">
                                                        <Template Context="job">
                                                            <div class="wdl-inspection">
                                                                <span>
                                                                    <strong>@(job.MatchDecision ?? "pending")</strong>
                                                                    @if (job.MatchConfidence is double confidence)
                                                                    {
                                                                        <span> · @confidence.ToString("P0")</span>
                                                                    }
                                                                </span>
                                                                @if (!string.IsNullOrWhiteSpace(job.ArchiveWarpName))
                                                                {
                                                                    <span><code>/warp @job.ArchiveWarpName</code> · @(job.ArchiveWarpSource ?? "reviewed")</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(job.MatchReason))
                                                                {
                                                                    <span>@job.MatchReason</span>
                                                                }
                                                            </div>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="IngestionJobDto" Title="Progress" Width="220px" Sortable="false">
                                                        <Template Context="job">
                                                            <RadzenProgressBar Value="@job.ProgressPercent" ShowValue="true" Style="height: 18px" />
                                                            <div class="rz-text-secondary" style="font-size: 0.75rem; margin-top: 0.25rem">
                                                                @if (!string.IsNullOrWhiteSpace(job.Message))
                                                                {
                                                                    <span>@job.Message</span>
                                                                }
                                                                @if (job.EtaSeconds is int eta)
                                                                {
                                                                    <span> · about @FormatEta(eta) remaining</span>
                                                                }
                                                            </div>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="IngestionJobDto" Title="World inspection" Width="290px" Sortable="false">
                                                        <Template Context="job">
                                                            @if (job.Inspection is { } inspection)
                                                            {
                                                                <div class="wdl-inspection">
                                                                    <strong>@(inspection.VersionName ?? "Unknown version")</strong>
                                                                    <span>@inspection.StorageEra · @(inspection.LevelName ?? "Unnamed world")</span>
                                                                    @foreach (var dimension in inspection.Dimensions)
                                                                    {
                                                                        <span>
                                                                            @dimension.Key: @dimension.ChunkCount.ToString("N0") chunks,
                                                                            @dimension.MinX,@dimension.MinZ to @dimension.MaxXExclusive,@dimension.MaxZExclusive
                                                                        </span>
                                                                        @if (dimension.SkippedRegionCount + dimension.SkippedChunkCount > 0)
                                                                        {
                                                                            <span style="color: var(--rz-warning, #d97706); font-weight: 600;"
                                                                                  title="Corrupt or truncated data was skipped during ingest; the rest rendered.">
                                                                                ⚠ @dimension.Key skipped @dimension.SkippedRegionCount region(s), @dimension.SkippedChunkCount chunk(s)
                                                                            </span>
                                                                        }
                                                                    }
                                                                    <span class="wdl-provenance">@inspection.ProvenanceMessage</span>
                                                                    @if ((inspection.ArchiveEvidence ?? job.ArchiveEvidence) is { } archive)
                                                                    {
                                                                        <span>
                                                                            Evidence: @archive.DownloaderKind
                                                                            @if (archive.IsArchiveSource) { <strong> · Archive source identified</strong> }
                                                                        </span>
                                                                        @if (!string.IsNullOrWhiteSpace(archive.DownloadName))
                                                                        {
                                                                            <span>Capture name: @archive.DownloadName</span>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(archive.CompletionStatus))
                                                                        {
                                                                            <span>
                                                                                Capture: <strong>@archive.CompletionStatus</strong>
                                                                                @if (archive.SavedChunkCount is int savedChunks)
                                                                                {
                                                                                    <text> | @savedChunks.ToString("N0") chunks on disk</text>
                                                                                }
                                                                                @if (archive.FinishedAtUtc is DateTime finished)
                                                                                {
                                                                                    <text> | @finished.ToLocalTime().ToString("MMM d, yyyy")</text>
                                                                                }
                                                                            </span>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(archive.MinecraftVersion) || !string.IsNullOrWhiteSpace(archive.ModVersion))
                                                                        {
                                                                            <span>
                                                                                Software: Minecraft @(archive.MinecraftVersion ?? "unknown")
                                                                                @if (!string.IsNullOrWhiteSpace(archive.ModVersion))
                                                                                {
                                                                                    <text> | WDL @archive.ModVersion</text>
                                                                                }
                                                                            </span>
                                                                        }
                                                                        @if (archive.PlayerX is double playerX && archive.PlayerZ is double playerZ)
                                                                        {
                                                                            <span>Saved player: @Math.Round(playerX), @Math.Round(playerZ) · @(archive.PlayerDimension ?? "unknown dimension")</span>
                                                                        }
                                                                        @if (archive.RawDimensionIds.Count > 0)
                                                                        {
                                                                            <span title="@string.Join(", ", archive.RawDimensionIds)">
                                                                                Raw dimensions: @string.Join(", ", archive.RawDimensionIds.Take(4))@(archive.RawDimensionIds.Count > 4 ? " …" : string.Empty)
                                                                            </span>
                                                                        }
                                                                        @foreach (var warning in archive.Warnings)
                                                                        {
                                                                            <span style="color: var(--rz-warning, #d97706);">⚠ @warning</span>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="rz-text-secondary">Available after prepare</span>
                                                            }
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="IngestionJobDto" Property="RequestedUtc" Title="Queued" Width="155px">
                                                        <Template Context="job">@job.RequestedUtc.ToLocalTime().ToString("MMM d, HH:mm")</Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="IngestionJobDto" Title="" Width="90px" Sortable="false">
                                                        <Template Context="job">
                                                            @if (job.Status == "needs-match")
                                                            {
                                                                <RadzenButton Icon="link" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                                                              Click="@(() => ShowMatchDialog(job))" title="Match to a location" />
                                                            }
                                                            @if (job.Status == "queued" || job.Status == "needs-match")
                                                            {
                                                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                                              Click="@(() => CancelIngestionJob(job))" title="Cancel job" />
                                                            }
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                </Columns>
                                            </RadzenDataGrid>
                                        }
                                    </RadzenFieldset>
                                }

                                @if (isLoadingLocations && locations.Count == 0)
                                {
                                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                                    <RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary rz-mt-2">
                                        Loading locations...
                                    </RadzenText>
                                }
                                else if (locations == null || !locations.Any())
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                                        No locations found.
                                    </RadzenAlert>
                                }
                                else
                                {
                                    <div class="mobile-admin-list">
                                        <div class="mobile-location-toolbar">
                                            <RadzenTextBox Value="@mobileLocationSearch" Change="@OnMobileLocationSearchChanged"
                                                           Placeholder="Search locations" Style="width: 100%;" />
                                            @if (!string.IsNullOrWhiteSpace(mobileLocationSearch))
                                            {
                                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                              Click="@ClearMobileLocationSearch" title="Clear search" />
                                            }
                                        </div>
                                        <div class="mobile-admin-limit">
                                            @MobileLocationCount.ToString("N0") matching location@(MobileLocationCount == 1 ? string.Empty : "s")
                                        </div>
                                        @foreach (var location in MobileLocationPageItems)
                                        {
                                            <article @key="location.Rowid" class="mobile-admin-card mobile-location-card">
                                                <header>
                                                    <div>
                                                        <RadzenLink Path="@($"location/{location.Rowid}")" Text="@location.Name" />
                                                        <small>ID @location.Rowid · added @location.DateAddedUtc.ToString("MMM d, yyyy")</small>
                                                    </div>
                                                    <RadzenBadge BadgeStyle="@GetDimensionBadgeStyle(location.Dimension)" Text="@location.DimensionName" />
                                                </header>
                                                <code class="mobile-admin-code">@location.X, @(location.Y ?? 64), @location.Z</code>
                                                @if (!string.IsNullOrWhiteSpace(location.Description))
                                                {
                                                    <p class="mobile-admin-note">@TruncateAdminText(location.Description, 150)</p>
                                                }
                                                <div class="mobile-admin-meta mobile-location-counts">
                                                    <span><strong>@location.WarpCount</strong>warps</span>
                                                    <span><strong>@location.RenderCount</strong>renders</span>
                                                    <span><strong>@location.AttachmentCount</strong>media</span>
                                                </div>
                                                <footer>
                                                    <RadzenButton Text="Open" Icon="open_in_new" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info"
                                                                  Click="@(() => NavigationManager.NavigateTo($"location/{location.Rowid}"))" />
                                                    @if (canManageAttachments)
                                                    {
                                                        <RadzenButton Text="Media" Icon="attachment" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                                                                      Click="@(() => ShowAttachmentManagerDialog(location))" />
                                                    }
                                                    @if (canEditLocations)
                                                    {
                                                        <RadzenButton Text="Edit" Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                                      Click="@(() => ShowEditLocationDialog(location))" />
                                                    }
                                                    @if (canDeleteLocations)
                                                    {
                                                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                                      Click="@(() => ShowDeleteLocationConfirmation(location))" title="Delete" />
                                                    }
                                                </footer>
                                            </article>
                                        }
                                        @if (MobileLocationPageCount > 1)
                                        {
                                            <div class="mobile-admin-pager">
                                                <RadzenButton Icon="chevron_left" Text="Previous" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                              Disabled="@(mobileLocationPage <= 0)" Click="@PreviousMobileLocationPage" />
                                                <span>Page @(mobileLocationPage + 1) of @MobileLocationPageCount</span>
                                                <RadzenButton Icon="chevron_right" Text="Next" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                              Disabled="@(mobileLocationPage >= MobileLocationPageCount - 1)" Click="@NextMobileLocationPage" />
                                            </div>
                                        }
                                    </div>
                                    <RadzenDataGrid class="desktop-admin-grid" @ref="locationsGrid" Data="@locations" KeyProperty="Rowid" TItem="Location" AllowPaging="true" PageSize="15"
                                                    AllowFiltering="true" FilterMode="FilterMode.SimpleWithMenu" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    AllowSorting="true" AllowColumnResize="true" GridLines="DataGridGridLines.Both">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="Location" Property="Rowid" Title="ID" Width="60px" />
                                            <RadzenDataGridColumn TItem="Location" Property="Name" Title="Name" Width="200px">
                                                <Template Context="location">
                                                    <div>
                                                        <RadzenLink Path="@($"location/{location.Rowid}")" Text="@location.Name" />
                                                        @if (!string.IsNullOrEmpty(location.Description))
                                                        {
                                                            <br />
                                                            var compactDescription = DisplayText.CompactDescription(location.Description);
                                                            <small class="rz-text-secondary">@(compactDescription.Length > 50 ? compactDescription.Substring(0, 50) + "..." : compactDescription)</small>
                                                        }
                                                    </div>
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="Location" Property="DimensionName" Title="Dimension" Width="100px">
                                                <Template Context="location">
                                                    <RadzenBadge BadgeStyle="@GetDimensionBadgeStyle(location.Dimension)" Text="@location.DimensionName" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="Location" Title="Coordinates" Width="150px" Sortable="false">
                                                <Template Context="location">
                                                    <code>@location.X, @(location.Y ?? 64), @location.Z</code>
                                                </Template>
                                            </RadzenDataGridColumn>

                                            <!-- ENHANCED COUNT COLUMNS - SORTABLE AND FILTERABLE -->
                                            <RadzenDataGridColumn TItem="Location" Property="WarpCount" Title="Warps" Width="80px" TextAlign="TextAlign.Center">
                                                <Template Context="location">
                                                    <RadzenBadge BadgeStyle="@(location.WarpCount > 0 ? BadgeStyle.Info : BadgeStyle.Light)"
                                                                 Text="@location.WarpCount.ToString()"
                                                                 title="@($"{location.WarpCount} warp{(location.WarpCount == 1 ? "" : "s")}")" />
                                                </Template>
                                            </RadzenDataGridColumn>

                                            <RadzenDataGridColumn TItem="Location" Property="AttachmentCount" Title="Files" Width="80px" TextAlign="TextAlign.Center">
                                                <Template Context="location">
                                                    <RadzenBadge BadgeStyle="@(location.AttachmentCount > 0 ? BadgeStyle.Success : BadgeStyle.Light)"
                                                                 Text="@location.AttachmentCount.ToString()"
                                                                 title="@($"{location.AttachmentCount} attachment{(location.AttachmentCount == 1 ? "" : "s")}")" />
                                                </Template>
                                            </RadzenDataGridColumn>

                                            <RadzenDataGridColumn TItem="Location" Property="RenderCount" Title="Renders" Width="80px" TextAlign="TextAlign.Center">
                                                <Template Context="location">
                                                    <RadzenBadge BadgeStyle="@(location.RenderCount > 0 ? BadgeStyle.Warning : BadgeStyle.Light)"
                                                                 Text="@location.RenderCount.ToString()"
                                                                 title="@($"{location.RenderCount} render{(location.RenderCount == 1 ? "" : "s")}")" />
                                                </Template>
                                            </RadzenDataGridColumn>

                                            <RadzenDataGridColumn TItem="Location" Property="TotalRelatedItems" Title="Total" Width="80px" TextAlign="TextAlign.Center" Visible="false">
                                                <Template Context="location">
                                                    <RadzenBadge BadgeStyle="@(location.TotalRelatedItems > 0 ? BadgeStyle.Primary : BadgeStyle.Light)"
                                                                 Text="@location.TotalRelatedItems.ToString()"
                                                                 title="@location.RelatedContentSummary" />
                                                </Template>
                                            </RadzenDataGridColumn>

                                            <RadzenDataGridColumn TItem="Location" Property="DateAddedUtc" Title="Added" Width="120px">
                                                <Template Context="location">
                                                    @location.DateAddedUtc.ToString("MMM dd, yyyy")
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="Location" Title="Actions" Width="190px" Sortable="false">
                                                <Template Context="location">
                                                    <RadzenButton Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info"
                                                                  Click="@(() => ShowViewLocationDialog(location))"
                                                                  class="rz-me-1" title="View Details" />
                                                    <RadzenButton Icon="open_in_new" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                                  Click="@(() => NavigationManager.NavigateTo($"location/{location.Rowid}"))"
                                                                  class="rz-me-1" title="Open location page" />
                                                    @if (canManageAttachments)
                                                    {
                                                        <RadzenButton Icon="attachment" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                                                                      Click="@(() => ShowAttachmentManagerDialog(location))"
                                                                      class="rz-me-1" title="Manage Attachments" />
                                                    }
                                                    @if (canEditLocations)
                                                    {
                                                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                                      Click="@(() => ShowEditLocationDialog(location))"
                                                                      class="rz-me-1" title="Edit" />
                                                    }
                                                    @if (canDeleteLocations)
                                                    {
                                                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                                      Click="@(() => ShowDeleteLocationConfirmation(location))" title="Delete" />
                                                    }
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                }
                            </RadzenTabsItem>
                            }

                            @if (canModerate)
                            {
                                <RadzenTabsItem Text="@($"Moderation ({pendingHighways.Count + pendingRevisions.Count})")">
                                    <div class="rz-d-flex rz-justify-content-between rz-align-items-center rz-mb-3">
                                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Pending highway submissions</RadzenText>
                                        <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                                                      Size="ButtonSize.Small" Click="@LoadModeration" />
                                    </div>

                                    @if (isLoadingModeration)
                                    {
                                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                                    }
                                    else if (!pendingHighways.Any())
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" AllowClose="false">
                                            Nothing awaiting review. The queue is clear.
                                        </RadzenAlert>
                                    }
                                    else
                                    {
                                        <RadzenDataGrid Data="@pendingHighways" TItem="Highway" AllowPaging="true" PageSize="10"
                                                        GridLines="DataGridGridLines.Both">
                                            <Columns>
                                                <RadzenDataGridColumn TItem="Highway" Property="Id" Title="ID" Width="60px" />
                                                <RadzenDataGridColumn TItem="Highway" Property="Name" Title="Name" />
                                                <RadzenDataGridColumn TItem="Highway" Property="Category" Title="Category" Width="120px" />
                                                <RadzenDataGridColumn TItem="Highway" Title="Points" Width="80px" TextAlign="TextAlign.Center">
                                                    <Template Context="hw">@hw.Points.Count</Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Highway" Property="Width" Title="Width" Width="80px" TextAlign="TextAlign.Center" />
                                                <RadzenDataGridColumn TItem="Highway" Title="Submitted by" Width="110px">
                                                    <Template Context="hw">@(hw.CreatedByUserId?.ToString() ?? "—")</Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Highway" Title="Review" Width="180px" Sortable="false">
                                                    <Template Context="hw">
                                                        <RadzenButton Icon="check" Text="Approve" ButtonStyle="ButtonStyle.Success"
                                                                      Size="ButtonSize.Small" class="rz-mr-2"
                                                                      Click="@(() => ApproveHighway(hw.Id))" />
                                                        <RadzenButton Icon="close" Text="Reject" ButtonStyle="ButtonStyle.Danger"
                                                                      Size="ButtonSize.Small"
                                                                      Click="@(() => RejectHighway(hw.Id))" />
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            </Columns>
                                        </RadzenDataGrid>
                                    }

                                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2 rz-mt-4">Proposed edits (revisions)</RadzenText>

                                    @if (isLoadingModeration)
                                    {
                                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                                    }
                                    else if (!pendingRevisions.Any())
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" AllowClose="false">
                                            No proposed edits awaiting review.
                                        </RadzenAlert>
                                    }
                                    else
                                    {
                                        <RadzenDataGrid Data="@pendingRevisions" TItem="RevisionDto" AllowPaging="true" PageSize="10"
                                                        GridLines="DataGridGridLines.Both">
                                            <Columns>
                                                <RadzenDataGridColumn TItem="RevisionDto" Property="Id" Title="ID" Width="60px" />
                                                <RadzenDataGridColumn TItem="RevisionDto" Property="EntityType" Title="Type" Width="100px" />
                                                <RadzenDataGridColumn TItem="RevisionDto" Property="EntityId" Title="Target" Width="80px" TextAlign="TextAlign.Center" />
                                                <RadzenDataGridColumn TItem="RevisionDto" Property="Note" Title="Note" />
                                                <RadzenDataGridColumn TItem="RevisionDto" Title="Submitted by" Width="140px">
                                                    <Template Context="rev">@(string.IsNullOrEmpty(rev.SubmittedByUsername) ? (rev.SubmittedByUserId?.ToString() ?? "—") : rev.SubmittedByUsername)</Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="RevisionDto" Title="Review" Width="180px" Sortable="false">
                                                    <Template Context="rev">
                                                        <RadzenButton Icon="check" Text="Approve" ButtonStyle="ButtonStyle.Success"
                                                                      Size="ButtonSize.Small" class="rz-mr-2"
                                                                      Click="@(() => ApproveRevision(rev.Id))" />
                                                        <RadzenButton Icon="close" Text="Reject" ButtonStyle="ButtonStyle.Danger"
                                                                      Size="ButtonSize.Small"
                                                                      Click="@(() => RejectRevision(rev.Id))" />
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            </Columns>
                                        </RadzenDataGrid>
                                    }
                                </RadzenTabsItem>
                            }

                            @if (canModerate)
                            {
                                <RadzenTabsItem Text="@($"AI Enrichment ({enrichmentStatus?.PendingReviewCount ?? 0})")">
                                    <div class="rz-d-flex rz-justify-content-between rz-align-items-center rz-mb-3">
                                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Wiki, descriptions &amp; build attribution</RadzenText>
                                        <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                                                      Size="ButtonSize.Small" Click="@LoadEnrichment" />
                                    </div>

                                    @if (enrichmentStatus is null)
                                    {
                                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                                    }
                                    else
                                    {
                                        @if (!enrichmentStatus.Enabled)
                                        {
                                            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                                                The AI engine is <b>disabled</b>. Set <code>AiEnrichment:Enabled</code> to <code>true</code> on the server to use it.
                                            </RadzenAlert>
                                        }
                                        else if (enrichmentStatus.Paused)
                                        {
                                            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                                                The AI engine is <b>paused</b> by the GPU game-mode lock. Runs are held until gaming/rendering finishes.
                                            </RadzenAlert>
                                        }

                                        <RadzenCard class="rz-mb-3">
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
                                                <div>
                                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-mb-0">Model</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body2">@enrichmentStatus.Model</RadzenText>
                                                </div>
                                                <div>
                                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-mb-0">Auto-apply at</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body2">@($"{enrichmentStatus.AutoApplyMinConfidence:P0}") confidence</RadzenText>
                                                </div>
                                                <div>
                                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-mb-0">Coord tolerance</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body2">@enrichmentStatus.CoordinateToleranceBlocks blocks</RadzenText>
                                                </div>
                                                <div>
                                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-mb-0">Missing metadata</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body2">@enrichmentStatus.LocationsMissingMetadata locations</RadzenText>
                                                </div>
                                                <div>
                                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-mb-0">Unlinked build evidence</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body2">@enrichmentStatus.LocationsMissingGroupAttributions locations</RadzenText>
                                                </div>
                                                <div>
                                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-mb-0">New group candidates</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body2">@enrichmentStatus.UnrepresentedGroupCandidates groups</RadzenText>
                                                </div>
                                                <div>
                                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-mb-0">Group evidence</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body2">
                                                        @(enrichmentStatus.GroupEvidenceAvailable
                                                            ? $"{enrichmentStatus.GroupEvidenceArticleCount} revision-pinned articles"
                                                            : "Unavailable")
                                                    </RadzenText>
                                                </div>
                                            </RadzenStack>
                                            @if (!enrichmentStatus.GroupEvidenceAvailable && !string.IsNullOrWhiteSpace(enrichmentStatus.GroupEvidenceMessage))
                                            {
                                                <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false" class="rz-mt-3">
                                                    @enrichmentStatus.GroupEvidenceMessage
                                                </RadzenAlert>
                                            }
                                        </RadzenCard>

                                        <RadzenCard class="rz-mb-4">
                                            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Run a complete matching pass</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-2">
                                                Every eligible Atlas location is processed in the background; closing or refreshing this page will not stop it.
                                                Existing open suggestions are skipped.
                                            </RadzenText>
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                    <RadzenCheckBox @bind-Value="@enrichAutoApply" Name="autoApply" TValue="bool" />
                                                    <RadzenLabel Text="Auto-apply confident matches" Component="autoApply" />
                                                </RadzenStack>
                                                <RadzenButton Text="@(IsEnrichmentRunActive ? "Run active" : "Run now")" Icon="auto_awesome" ButtonStyle="ButtonStyle.Primary"
                                                              IsBusy="@IsEnrichmentRunActive" Disabled="@(!IsAtlasOwner || IsEnrichmentRunActive || !enrichmentStatus.Enabled || enrichmentStatus.Paused)"
                                                              Click="@RunEnrichment" />
                                                <RadzenButton Text="Discover new groups" Icon="group_add" ButtonStyle="ButtonStyle.Secondary"
                                                              IsBusy="@isRunningGroupDiscovery"
                                                              Disabled="@(!IsAtlasOwner || isRunningGroupDiscovery || IsEnrichmentRunActive || !enrichmentStatus.Enabled || enrichmentStatus.Paused || !enrichmentStatus.GroupEvidenceAvailable)"
                                                              Click="@RunGroupDiscovery" />
                                            </RadzenStack>

                                            @if (enrichmentStatus.Run.RunId is not null)
                                            {
                                                var run = enrichmentStatus.Run;
                                                <div class="enrichment-run-status rz-mt-3">
                                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center" class="rz-mb-2">
                                                        <RadzenBadge BadgeStyle="@EnrichmentRunBadge(run.State)" Text="@run.State.ToUpperInvariant()" />
                                                        <strong>@(run.IsRunning ? "Catalog enrichment in progress" : "Last catalog enrichment run")</strong>
                                                        @if (!string.IsNullOrWhiteSpace(run.StartedBy))
                                                        {
                                                            <span>started by @run.StartedBy</span>
                                                        }
                                                        <span>· @FormatDuration(run.ElapsedSeconds)</span>
                                                    </RadzenStack>
                                                    @if (run.IsRunning)
                                                    {
                                                        <RadzenProgressBar Value="@run.ProgressPercent" ShowValue="true" Style="height: 20px" />
                                                        <div class="rz-mt-2">
                                                            <strong>@run.Scanned.ToString("N0") / @run.Total.ToString("N0") scanned</strong>
                                                            @if (!string.IsNullOrWhiteSpace(run.CurrentLocationName))
                                                            {
                                                                <span> · Now checking @run.CurrentLocationName</span>
                                                            }
                                                        </div>
                                                    }
                                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mt-2">
                                                        <span>@run.Matched.ToString("N0") matched</span>
                                                        <span>@run.AutoApplied.ToString("N0") applied</span>
                                                        <span>@run.Queued.ToString("N0") queued</span>
                                                        <span>@run.Skipped.ToString("N0") skipped</span>
                                                        @if (run.Errors > 0)
                                                        {
                                                            <span class="rz-text-danger">@run.Errors.ToString("N0") errors</span>
                                                        }
                                                    </RadzenStack>
                                                    @if (!string.IsNullOrWhiteSpace(run.Message))
                                                    {
                                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2 rz-mb-0">@run.Message</RadzenText>
                                                    }
                                                </div>
                                            }
                                        </RadzenCard>
                                    }

                                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Suggestions awaiting review</RadzenText>
                                    @if (isLoadingEnrichment)
                                    {
                                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                                    }
                                    else if (!enrichmentRevisions.Any())
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" AllowClose="false">
                                            No AI suggestions awaiting review. Run a pass to generate some.
                                        </RadzenAlert>
                                    }
                                    else
                                    {
                                        <RadzenDataGrid Data="@enrichmentRevisions" TItem="RevisionDto" AllowPaging="true" PageSize="10"
                                                        GridLines="DataGridGridLines.Both">
                                            <Columns>
                                                <RadzenDataGridColumn TItem="RevisionDto" Title="Target" Width="200px">
                                                    <Template Context="rev">
                                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0"><b>@ProposedName(rev)</b></RadzenText>
                                                        <RadzenText TextStyle="TextStyle.Caption">@rev.EntityType #@rev.EntityId</RadzenText>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="RevisionDto" Title="Wiki match" Width="160px">
                                                    <Template Context="rev">
                                                        @{ var wiki = ProposedWiki(rev); }
                                                        @if (!string.IsNullOrEmpty(wiki))
                                                        {
                                                            <a href="@wiki" target="_blank" rel="noopener noreferrer">@WikiLabel(wiki)</a>
                                                        }
                                                        else
                                                        {
                                                            <span class="rz-text-secondary">—</span>
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="RevisionDto" Title="Confidence" Width="110px" TextAlign="TextAlign.Center">
                                                    <Template Context="rev">
                                                        <RadzenBadge BadgeStyle="@ConfidenceBadge(rev.Confidence)" Text="@($"{rev.Confidence ?? 0:P0}")" />
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="RevisionDto" Title="Proposed description" Property="Note">
                                                    <Template Context="rev">
                                                        <RadzenText TextStyle="TextStyle.Caption" title="@ProposedDescription(rev)">@Truncate(ProposedDescription(rev), 140)</RadzenText>
                                                        @if (!string.IsNullOrWhiteSpace(ProposedGroups(rev)))
                                                        {
                                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-success">Groups: @ProposedGroups(rev)</RadzenText>
                                                        }
                                                        @if (!string.IsNullOrEmpty(rev.Note))
                                                        {
                                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-info">@rev.Note</RadzenText>
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="RevisionDto" Title="Status" Width="110px" TextAlign="TextAlign.Center">
                                                    <Template Context="rev">
                                                        <RadzenBadge BadgeStyle="@RevisionBadge(rev.Status)" Text="@rev.Status.ToString()" />
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="RevisionDto" Title="Review" Width="210px" Sortable="false">
                                                    <Template Context="rev">
                                                        @if (rev.Status == RevisionStatus.Applied)
                                                        {
                                                            <RadzenButton Icon="check" Text="Keep" ButtonStyle="ButtonStyle.Success"
                                                                          Size="ButtonSize.Small" class="rz-mr-2" Click="@(() => KeepEnrichment(rev.Id))" />
                                                            <RadzenButton Icon="undo" Text="Revert" ButtonStyle="ButtonStyle.Danger"
                                                                          Size="ButtonSize.Small" Click="@(() => RevertEnrichment(rev.Id))" />
                                                        }
                                                        else if (rev.Status == RevisionStatus.Pending)
                                                        {
                                                            <RadzenButton Icon="publish" Text="Apply" ButtonStyle="ButtonStyle.Success"
                                                                          Size="ButtonSize.Small" class="rz-mr-2" Click="@(() => ApplyEnrichment(rev.Id))" />
                                                            <RadzenButton Icon="close" Text="Reject" ButtonStyle="ButtonStyle.Danger"
                                                                          Size="ButtonSize.Small" Click="@(() => RejectEnrichment(rev.Id))" />
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            </Columns>
                                        </RadzenDataGrid>
                                    }
                                </RadzenTabsItem>
                            }

                            @if (canViewAudit)
                            {
                                <RadzenTabsItem Text="Audit Log">
                                    <div class="rz-d-flex rz-justify-content-between rz-align-items-center rz-mb-3">
                                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Recent activity</RadzenText>
                                        <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                                                      Size="ButtonSize.Small" Click="@LoadAudit" />
                                    </div>

                                    @if (isLoadingAudit)
                                    {
                                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                                    }
                                    else if (!auditEntries.Any())
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                                            No audit entries yet.
                                        </RadzenAlert>
                                    }
                                    else
                                    {
                                        <RadzenDataGrid Data="@auditEntries" TItem="AuditLogEntry" AllowPaging="true" PageSize="20"
                                                        AllowSorting="true" GridLines="DataGridGridLines.Both">
                                            <Columns>
                                                <RadzenDataGridColumn TItem="AuditLogEntry" Property="CreatedUtc" Title="When" Width="170px">
                                                    <Template Context="a">@a.CreatedUtc.ToLocalTime().ToString("MMM d, HH:mm:ss")</Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="AuditLogEntry" Property="Action" Title="Action" Width="150px">
                                                    <Template Context="a"><RadzenBadge BadgeStyle="@AuditBadge(a.Action)" Text="@a.Action" /></Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="AuditLogEntry" Property="Username" Title="User" Width="130px">
                                                    <Template Context="a">@(string.IsNullOrEmpty(a.Username) ? "—" : a.Username)</Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="AuditLogEntry" Property="Summary" Title="Summary" />
                                            </Columns>
                                        </RadzenDataGrid>
                                    }
                                </RadzenTabsItem>
                            }

                            @if (canManageGroups)
                            {
                                <RadzenTabsItem Text="@($"Groups ({groups.Count})")">
                                    <div class="rz-d-flex rz-justify-content-between rz-align-items-center rz-mb-3">
                                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Builder &amp; highway groups</RadzenText>
                                        <div>
                                            <RadzenButton Text="Add group" Icon="add" ButtonStyle="ButtonStyle.Primary"
                                                          Size="ButtonSize.Small" class="rz-mr-2" Click="@(() => OpenGroupDialog(null))" />
                                            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.Small" Click="@LoadGroups" />
                                        </div>
                                    </div>

                                    @if (isLoadingGroups)
                                    {
                                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                                    }
                                    else if (!groups.Any())
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                                            No groups yet. Add one to start attributing highways and bases.
                                        </RadzenAlert>
                                    }
                                    else
                                    {
                                        <RadzenDataGrid Data="@groups" TItem="Group" AllowPaging="true" PageSize="15"
                                                        AllowSorting="true" GridLines="DataGridGridLines.Both">
                                            <Columns>
                                                <RadzenDataGridColumn TItem="Group" Title="" Width="58px" Sortable="false">
                                                    <Template Context="g">
                                                        @if (!string.IsNullOrWhiteSpace(g.LogoUrl))
                                                        {
                                                            <img src="@g.LogoUrl" alt="" loading="lazy" class="admin-group-logo" onerror="this.style.display='none'" />
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Group" Property="Name" Title="Name" />
                                                <RadzenDataGridColumn TItem="Group" Property="Type" Title="Type" Width="110px">
                                                    <Template Context="g"><RadzenBadge BadgeStyle="@GroupTypeBadge(g.Type)" Text="@g.Type.ToString()" /></Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Group" Property="Description" Title="Description" />
                                                <RadzenDataGridColumn TItem="Group" Property="Status" Title="Status" Width="110px" />
                                                <RadzenDataGridColumn TItem="Group" Property="LocationCount" Title="Builds" Width="75px" TextAlign="TextAlign.Center" />
                                                <RadzenDataGridColumn TItem="Group" Title="Wiki" Width="70px" TextAlign="TextAlign.Center" Sortable="false">
                                                    <Template Context="g">
                                                        @if (!string.IsNullOrWhiteSpace(g.WikiUrl))
                                                        {
                                                            <RadzenLink Path="@g.WikiUrl" Target="_blank" Icon="open_in_new" />
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Group" Title="Actions" Width="130px" Sortable="false">
                                                    <Template Context="g">
                                                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                                      class="rz-mr-2" Click="@(() => OpenGroupDialog(g))" title="Edit" />
                                                        @if (IsAtlasOwner)
                                                        {
                                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                                          Click="@(() => DeleteGroup(g))" title="Delete" />
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            </Columns>
                                        </RadzenDataGrid>
                                    }
                                </RadzenTabsItem>
                            }

                            @if (canManageHighways)
                            {
                                <RadzenTabsItem Text="@($"Highways ({allHighways.Count})")">
                                    <div class="rz-d-flex rz-justify-content-between rz-align-items-center rz-mb-3">
                                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">All highways</RadzenText>
                                        <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                                                      Size="ButtonSize.Small" Click="@LoadHighways" />
                                    </div>

                                    @if (isLoadingHighways)
                                    {
                                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                                    }
                                    else if (!allHighways.Any())
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">No highways found.</RadzenAlert>
                                    }
                                    else
                                    {
                                        <RadzenDataGrid Data="@allHighways" TItem="Highway" AllowPaging="true" PageSize="15"
                                                        AllowSorting="true" AllowFiltering="true" GridLines="DataGridGridLines.Both">
                                            <Columns>
                                                <RadzenDataGridColumn TItem="Highway" Property="Id" Title="ID" Width="60px" />
                                                <RadzenDataGridColumn TItem="Highway" Property="Name" Title="Name" />
                                                <RadzenDataGridColumn TItem="Highway" Property="Category" Title="Category" Width="110px" />
                                                <RadzenDataGridColumn TItem="Highway" Title="Review" Width="110px">
                                                    <Template Context="hw"><RadzenBadge BadgeStyle="@ReviewBadge(hw.ReviewStatus)" Text="@hw.ReviewStatus.ToString()" /></Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Highway" Property="Visibility" Title="Visibility" Width="100px" />
                                                <RadzenDataGridColumn TItem="Highway" Title="Group" Width="150px">
                                                    <Template Context="hw">@(string.IsNullOrEmpty(hw.BuilderGroupName) ? "—" : hw.BuilderGroupName)</Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Highway" Title="Pts" Width="60px" TextAlign="TextAlign.Center">
                                                    <Template Context="hw">@hw.Points.Count</Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Highway" Title="Actions" Width="130px" Sortable="false" Filterable="false">
                                                    <Template Context="hw">
                                                        <RadzenButton Icon="my_location" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info"
                                                                      class="rz-mr-2" title="View on map" Click="@(() => ViewHighwayOnMap(hw))" />
                                                        @if (canDeleteHighways)
                                                        {
                                                            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                                          title="Delete" Click="@(() => DeleteHighway(hw))" />
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            </Columns>
                                        </RadzenDataGrid>
                                    }
                                <_2b2tAtlas.Client.Components.HighwayHistory CanRestore="canDeleteHighways" Changed="LoadHighways" />
                                </RadzenTabsItem>
                            }

                            @if (canManageRoleProfiles)
                            {
                                <RadzenTabsItem Text="Roles &amp; Permissions">
                                    <div class="rz-d-flex rz-justify-content-between rz-align-items-center rz-mb-3">
                                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Role permission matrix</RadzenText>
                                        <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                                                      Size="ButtonSize.Small" Click="@LoadRoles" />
                                    </div>

                                    @if (isLoadingRoles)
                                    {
                                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                                    }
                                    else if (roleMatrix == null)
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">Couldn't load the role matrix.</RadzenAlert>
                                    }
                                    else
                                    {
                                        <div class="roles-matrix-wrap">
                                            <table class="roles-matrix">
                                                <thead>
                                                    <tr>
                                                        <th class="perm-col">Permission</th>
                                                        <th>
                                                            <div class="role-head">SuperAdmin</div>
                                                            <div class="role-sub">all (locked)</div>
                                                        </th>
                                                        @foreach (var role in roleMatrix.Roles)
                                                        {
                                                            <th>
                                                                <div class="role-head">@RoleNames.DisplayName(role) @(roleMatrix.Customized.Contains(role) ? "*" : "")</div>
                                                                <div class="role-actions">
                                                                    <RadzenButton Icon="save" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Success"
                                                                                  title="@($"Save {role}")" Click="@(() => SaveRole(role))" />
                                                                    <RadzenButton Icon="restart_alt" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                                                                  title="Reset to default" Click="@(() => ResetRole(role))" />
                                                                </div>
                                                            </th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var perm in roleMatrix.Permissions)
                                                    {
                                                        <tr>
                                                            <td class="perm-col">@perm</td>
                                                            <td class="cell"><input type="checkbox" checked disabled /></td>
                                                            @foreach (var role in roleMatrix.Roles)
                                                            {
                                                                <td class="cell">
                                                                    <input type="checkbox"
                                                                           checked="@(roleWorking.TryGetValue(role, out var s) && s.Contains(perm))"
                                                                           @onchange="@(e => ToggleRolePerm(role, perm, e))" />
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary rz-mt-2">
                                            * = customised (overrides the built-in default). Changes apply to each affected user on their next login / token refresh. SuperAdmin always has every permission.
                                        </RadzenText>
                                    }
                                </RadzenTabsItem>
                            }

                            @if (canManageRenderSettings)
                            {
                                <RadzenTabsItem Text="Render Settings">
                                    <div class="rz-d-flex rz-justify-content-between rz-align-items-center rz-mb-3">
                                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">unMINED render settings</RadzenText>
                                        <div>
                                            <RadzenButton Text="Reload" Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                          class="rz-mr-2" Click="@LoadRenderSettings" />
                                            <RadzenButton Text="Save settings" Icon="save" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                                          IsBusy="@isSavingRender" Disabled="@(renderSettings is null || isSavingRender)" Click="@SaveRenderSettings" />
                                        </div>
                                    </div>

                                    @if (isLoadingRenderSettings)
                                    {
                                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                                    }
                                    else if (renderSettings is null)
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                                            Couldn't load render settings. The renderer profile may be missing on the host.
                                        </RadzenAlert>
                                    }
                                    else
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary rz-mb-3">
                                            unMINED <b>@renderSettings.RendererVersion</b>. The executable path and its SHA-256 pin are locked and never changed here. Saved settings apply to the next render.
                                        </RadzenText>

                                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2">Render flags</RadzenText>
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-4">
                                            @foreach (var dim in renderSettings.Dimensions)
                                            {
                                                <RadzenCard Style="min-width: 220px;">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2" style="text-transform: capitalize;">@dim.Dimension</RadzenText>
                                                    <RadzenStack Gap="0.5rem">
                                                        <RadzenFormField Text="Shadows" Variant="Variant.Outlined">
                                                            <RadzenDropDown @bind-Value="@dim.Shadows" Data="@shadowModes" />
                                                        </RadzenFormField>
                                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary">
                                                            Both day and night variants are always produced.
                                                        </RadzenText>
                                                        <RadzenFormField Text="Top Y (optional)" Variant="Variant.Outlined">
                                                            <RadzenNumeric @bind-Value="@dim.TopY" TValue="int?" />
                                                        </RadzenFormField>
                                                        <RadzenFormField Text="Bottom Y (optional)" Variant="Variant.Outlined">
                                                            <RadzenNumeric @bind-Value="@dim.BottomY" TValue="int?" />
                                                        </RadzenFormField>
                                                        <RadzenFormField Text="Background #rrggbb (optional)" Variant="Variant.Outlined">
                                                            <RadzenTextBox @bind-Value="@dim.Background" MaxLength="7" Placeholder="#rrggbb" />
                                                        </RadzenFormField>
                                                        <RadzenFormField Text="Image format" Variant="Variant.Outlined">
                                                            <RadzenTextBox Value="PNG (required by Atlas tiles)" Disabled="true" />
                                                        </RadzenFormField>
                                                    </RadzenStack>
                                                </RadzenCard>
                                            }
                                        </RadzenStack>

                                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2">Night colour grade</RadzenText>
                                        <RadzenCard class="rz-mb-4" Style="max-width: 720px;">
                                            <RadzenStack Gap="0.75rem">
                                                <RadzenCheckBox @bind-Value="@renderSettings.NightColorGrade.Enabled" TValue="bool" />
                                                <RadzenText TextStyle="TextStyle.Body2">Preserve terrain colour using paired daytime tiles</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary">
                                                    uNmINeD still supplies the real night/block-light luminance. Atlas restores terrain chroma so unlit areas remain coloured instead of pale gray.
                                                </RadzenText>
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                                                    <RadzenFormField Text="Saturation (0–2)" Variant="Variant.Outlined">
                                                        <RadzenNumeric @bind-Value="@renderSettings.NightColorGrade.Saturation" TValue="double" Min="0m" Max="2m" Step="0.05m" />
                                                    </RadzenFormField>
                                                    <RadzenFormField Text="Lightness (0.5–2)" Variant="Variant.Outlined">
                                                        <RadzenNumeric @bind-Value="@renderSettings.NightColorGrade.Lightness" TValue="double" Min="0.5m" Max="2m" Step="0.05m" />
                                                    </RadzenFormField>
                                                </RadzenStack>
                                            </RadzenStack>
                                        </RadzenCard>

                                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2">Colour, biome &amp; block overrides</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary rz-mb-2">
                                            Raw unMINED config. Colours: <code>map.water = #rrggbb</code>. Biome tints: <code>biome = #grass, #foliage, #water</code>. Comments start with <code>//</code>.
                                        </RadzenText>
                                        <RadzenAccordion>
                                            <Items>
                                                <RadzenAccordionItem Text="custom.colors.txt — block and map colours" Icon="palette">
                                                    <textarea class="render-config-editor" rows="14" spellcheck="false" @bind="renderSettings.ColorsText"></textarea>
                                                </RadzenAccordionItem>
                                                <RadzenAccordionItem Text="custom.biometints.txt — grass / foliage / water per biome" Icon="forest">
                                                    <textarea class="render-config-editor" rows="14" spellcheck="false" @bind="renderSettings.BiomeTintsText"></textarea>
                                                </RadzenAccordionItem>
                                                <RadzenAccordionItem Text="custom.blockstyles.txt — per-block styling" Icon="grid_view">
                                                    <textarea class="render-config-editor" rows="14" spellcheck="false" @bind="renderSettings.BlockStylesText"></textarea>
                                                </RadzenAccordionItem>
                                            </Items>
                                        </RadzenAccordion>

                                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mt-4 rz-mb-2">Preview</RadzenText>
                                        @if (renderSettings.SampleWorlds.Count == 0)
                                        {
                                            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                                                No sample world is staged on the host, so previews are unavailable.
                                            </RadzenAlert>
                                        }
                                        else
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary rz-mb-2">
                                                Save your changes first — the preview renders a small sample area with the currently saved settings.
                                            </RadzenText>
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center" class="rz-mb-3">
                                                <RadzenFormField Text="Sample world" Variant="Variant.Outlined">
                                                    <RadzenDropDown @bind-Value="@previewWorld" Data="@renderSettings.SampleWorlds" Style="width: 200px" />
                                                </RadzenFormField>
                                                <RadzenFormField Text="Dimension" Variant="Variant.Outlined">
                                                    <RadzenDropDown @bind-Value="@previewDimension" Data="@previewDimensions" Style="width: 150px" />
                                                </RadzenFormField>
                                                <RadzenButton Text="Render preview" Icon="image" ButtonStyle="ButtonStyle.Primary"
                                                              IsBusy="@isPreviewing" Disabled="@(isPreviewing || string.IsNullOrWhiteSpace(previewWorld))" Click="@RenderPreview" />
                                                @if (previewResult is { Ok: true })
                                                {
                                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary">
                                                        @previewResult.WidthPx×@previewResult.HeightPx px · @previewResult.ElapsedMs ms
                                                    </RadzenText>
                                                }
                                            </RadzenStack>
                                            @if (previewResult is { Ok: false })
                                            {
                                                <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">@previewResult.Error</RadzenAlert>
                                            }
                                            else if (previewResult is { Ok: true, ImageBase64: not null })
                                            {
                                                <RadzenCard class="rz-mb-3">
                                                    <RadzenStack Gap="0.75rem">
                                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
                                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                                <RadzenSwitch TValue="bool" Value="@previewIsDay" Change="@SetPreviewDay" />
                                                                <RadzenLabel Text="@(previewIsDay ? "Day" : "Night")" />
                                                            </RadzenStack>
                                                            <label class="preview-opacity-label">
                                                                Preview opacity
                                                                <input type="range" min="0" max="1" step="0.05" value="@previewOpacity"
                                                                       @oninput="PreviewOpacityChanged" />
                                                                <span>@($"{previewOpacity:P0}")</span>
                                                            </label>
                                                            <RadzenButton Text="All primary layers off" Icon="layers_clear" Size="ButtonSize.Small"
                                                                          ButtonStyle="ButtonStyle.Light" Click="@ClearPreviewPrimaryLayers" />
                                                        </RadzenStack>
                                                        <div class="preview-layer-list">
                                                            @foreach (var render in previewPrimaryOptions)
                                                            {
                                                                <label class="preview-layer-option">
                                                                    <input type="checkbox" checked="@previewSelectedRenders.Contains(render.Id)"
                                                                           @onchange="@(args => PreviewPrimaryChanged(render.Id, args))" />
                                                                    <span>@render.Label</span>
                                                                    @if (render.DayNight)
                                                                    {
                                                                        <small>day/night</small>
                                                                    }
                                                                </label>
                                                            }
                                                        </div>
                                                    </RadzenStack>
                                                </RadzenCard>
                                                <div class="render-comparison-map-wrap">
                                                    <div id="render-settings-preview-map" class="render-comparison-map"></div>
                                                </div>
                                            }
                                        }

                                        <RadzenCard class="rz-mt-4">
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap"
                                                         AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                                <div>
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Re-render all archived WDLs</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary">
                                                        Rebuilds every existing location render sequentially from its SHA-verified NAS archive and safely replaces its current tiles.
                                                    </RadzenText>
                                                    @if (rerenderStatus is not null)
                                                    {
                                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-1">
                                                            Queue: @rerenderStatus.Queued waiting · @rerenderStatus.Running running · @rerenderStatus.Failed failed
                                                        </RadzenText>
                                                    }
                                                </div>
                                                <RadzenButton Text="Re-render everything" Icon="restart_alt" ButtonStyle="ButtonStyle.Danger"
                                                              IsBusy="@isQueuingRerender"
                                                              Disabled="@(isQueuingRerender || rerenderStatus is { Queued: > 0 } || rerenderStatus is { Running: > 0 })"
                                                              Click="@RerenderEverything" />
                                            </RadzenStack>
                                        </RadzenCard>
                                    }
                                </RadzenTabsItem>
                            }
                        </Tabs>
                    </RadzenTabs>
                </RadzenCard>
            }
        }
    </div>
</CascadingValue>

<style>
    .admin-page-shell { padding: 17px; min-height: 100%; min-width: 0; }
    .admin-group-logo { width: 38px; height: 38px; border-radius: 7px; object-fit: contain; background: rgba(127,127,127,.12); }
    .enrichment-run-status { padding: .85rem; border: 1px solid rgba(127,127,127,.28); border-radius: 8px; background: rgba(127,127,127,.055); }
    /* Space each tab's content below the tab bar so headings/refresh/add buttons don't touch it. */
    .admin-tabs .rz-tabview-panel {
        padding-top: 16px;
    }

    /* This Radzen build defines rz-display-flex / rz-justify-content-space-between, but the tab header
       rows use the Bootstrap-style names, which are undefined here — so the heading and its buttons
       collapse into a touching vertical stack. Define them so each header is a spaced row. */
    .admin-tabs .rz-d-flex {
        display: flex;
        gap: 0.75rem;
    }

    .admin-tabs .rz-justify-content-between {
        justify-content: space-between;
    }

    .admin-tabs .rz-align-items-center {
        align-items: center;
    }

    /* Render-settings raw config editors + preview. */
    .render-config-editor {
        width: 100%;
        box-sizing: border-box;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.8rem;
        line-height: 1.4;
        padding: 10px;
        border: 1px solid rgba(127, 127, 127, 0.4);
        border-radius: 6px;
        background: rgba(127, 127, 127, 0.06);
        color: inherit;
        resize: vertical;
    }

    .render-preview-wrap {
        max-width: 100%;
        overflow: auto;
        border: 1px solid rgba(127, 127, 127, 0.35);
        border-radius: 6px;
        background: repeating-conic-gradient(rgba(127,127,127,0.10) 0% 25%, transparent 0% 50%) 50% / 20px 20px;
    }

    .render-preview-img {
        display: block;
        image-rendering: pixelated;
        max-width: 100%;
        height: auto;
    }

    .render-comparison-map-wrap {
        width: 100%;
        height: min(68vh, 680px);
        min-height: 420px;
        border: 1px solid rgba(127, 127, 127, 0.35);
        border-radius: 6px;
        overflow: hidden;
    }

    .render-comparison-map {
        width: 100%;
        height: 100%;
    }

    .preview-layer-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .preview-layer-option {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border: 1px solid rgba(127, 127, 127, 0.35);
        border-radius: 4px;
        cursor: pointer;
    }

    .preview-layer-option small { opacity: 0.65; }

    .preview-opacity-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .preview-opacity-label input { width: 150px; }

    @@media (max-width: 640px) {
        .render-comparison-map-wrap { height: 55vh; min-height: 340px; }
    }

    /* Base stats card styles */
    .stats-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        border: none !important;
        border-radius: 12px !important;
        padding: 1.5rem !important;
        position: relative;
        overflow: hidden;
    }

        .stats-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
        }

    .stats-number {
        color: white !important;
        font-weight: 700 !important;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
    }

    .stats-label {
        color: rgba(255, 255, 255, 0.9) !important;
        font-weight: 600 !important;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }

    /* Light theme stats cards */
    .stats-card-locations {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    }

    .stats-card-warps {
        background: linear-gradient(135deg, #dc2626 0%, #ea580c 100%);
    }

    .stats-card-renders {
        background: linear-gradient(135deg, #0891b2 0%, #0284c7 100%);
    }

    .stats-card-attachments {
        background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    }

    .stats-card-locations-monthly {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    }

    .stats-card-warps-monthly {
        background: linear-gradient(135deg, #ef4444 0%, #f97316 100%);
    }

    .stats-card-renders-monthly {
        background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
    }

    .stats-card-attachments-monthly {
        background: linear-gradient(135deg, #22c55e 0%, #84cc16 100%);
    }

    /* Dark theme adjustments */
    .minecraft-font:not(.light-theme) .stats-card-locations {
        background: linear-gradient(135deg, #3730a3 0%, #581c87 100%);
    }

    .minecraft-font:not(.light-theme) .stats-card-warps {
        background: linear-gradient(135deg, #991b1b 0%, #c2410c 100%);
    }

    .minecraft-font:not(.light-theme) .stats-card-renders {
        background: linear-gradient(135deg, #075985 0%, #1e40af 100%);
    }

    .minecraft-font:not(.light-theme) .stats-card-attachments {
        background: linear-gradient(135deg, #047857 0%, #16a34a 100%);
    }

    .minecraft-font:not(.light-theme) .stats-card-locations-monthly {
        background: linear-gradient(135deg, #4338ca 0%, #7c2d12 100%);
    }

    .minecraft-font:not(.light-theme) .stats-card-warps-monthly {
        background: linear-gradient(135deg, #b91c1c 0%, #ea580c 100%);
    }

    .minecraft-font:not(.light-theme) .stats-card-renders-monthly {
        background: linear-gradient(135deg, #0e7490 0%, #2563eb 100%);
    }

    .minecraft-font:not(.light-theme) .stats-card-attachments-monthly {
        background: linear-gradient(135deg, #15803d 0%, #65a30d 100%);
    }

    /* Light theme specific overrides */
    .light-theme .stats-card {
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1) !important;
    }

        .light-theme .stats-card:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2) !important;
        }

    .wdl-inspection { display: grid; gap: 2px; font-size: 0.75rem; line-height: 1.3; }
    .wdl-inspection span { overflow-wrap: anywhere; }
    .wdl-provenance { margin-top: 3px; color: var(--rz-warning); }

    .collector-heading { display: inline-flex; align-items: center; flex-wrap: wrap; gap: .55rem; min-width: 0; }
    .collector-heading-title { display: inline-flex; align-items: center; gap: .4rem; }
    .collector-heading-count { opacity: .72; font-size: .78rem; font-weight: 500; }
    .collector-loading { display: flex; align-items: center; gap: .65rem; min-height: 52px; }
    .collector-toolbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
    .collector-operation { font-weight: 700; }
    .collector-updated, .collector-progress-caption { opacity: .68; font-size: .76rem; margin-top: .2rem; }
    .collector-progress-line { display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-size: .82rem; text-transform: uppercase; letter-spacing: .035em; margin-bottom: .35rem; }
    .collector-progress { height: 12px; }
    .collector-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; margin: 1rem 0 1.15rem; }
    .collector-kpi { display: grid; gap: .2rem; padding: .75rem; text-align: center; border: 1px solid rgba(127,127,127,.25); border-radius: 7px; background: rgba(127,127,127,.055); }
    .collector-kpi strong { font-size: 1.35rem; line-height: 1; }
    .collector-kpi span { opacity: .68; font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; }
    .collector-kpi-saved strong { color: var(--rz-success); }
    .collector-kpi-unavailable strong { color: var(--rz-warning); }
    .collector-section-title { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: .45rem; border-bottom: 1px solid rgba(127,127,127,.25); font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
    .collector-workers { display: grid; }
    .collector-worker { display: grid; grid-template-columns: 125px 80px minmax(220px, 1fr) repeat(4, minmax(68px, auto)); align-items: center; gap: .7rem; padding: .7rem .25rem; border-bottom: 1px solid rgba(127,127,127,.16); min-width: 0; }
    .collector-worker-identity { display: grid; gap: .1rem; min-width: 0; }
    .collector-worker-identity span { opacity: .68; font-size: .72rem; overflow: hidden; text-overflow: ellipsis; }
    .collector-worker-identity .collector-worker-lane { color: var(--rz-primary); opacity: .92; font-weight: 700; text-transform: uppercase; letter-spacing: .035em; }
    .collector-worker-warp { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .collector-worker-warp code { color: var(--rz-primary); }
    .collector-worker-stat { display: grid; gap: .08rem; text-align: right; }
    .collector-worker-stat span { opacity: .6; font-size: .65rem; text-transform: uppercase; }
    .collector-worker-stat strong { font-size: .8rem; white-space: nowrap; }
    .collector-footer { display: flex; flex-wrap: wrap; gap: .65rem 1.25rem; margin-top: .8rem; font-size: .76rem; opacity: .82; }
    .bluemap-monitor { border-left: 3px solid rgba(33, 150, 243, .72); }
    .bluemap-current-job { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 0 0 1rem; padding: .85rem 1rem; border: 1px solid rgba(33,150,243,.38); border-radius: 8px; background: rgba(33,150,243,.075); }
    .bluemap-current-job > div { display: flex; align-items: baseline; flex-wrap: wrap; gap: .35rem .65rem; min-width: 0; }
    .bluemap-current-job a { font-weight: 700; overflow-wrap: anywhere; }
    .bluemap-current-job small { opacity: .68; }
    .bluemap-current-label { color: var(--rz-info); font-size: .7rem; font-weight: 700; letter-spacing: .045em; text-transform: uppercase; }
    .bluemap-dimension-title { margin-top: .25rem; }

    .mobile-admin-list { display: none; }
    .desktop-admin-grid { display: block; }
    .mobile-admin-card {
        display: grid;
        gap: .7rem;
        padding: .85rem;
        border: 1px solid rgba(127,127,127,.28);
        border-radius: 8px;
        background: rgba(127,127,127,.055);
        min-width: 0;
    }
    .mobile-admin-card.needs-attention { border-left: 4px solid var(--rz-warning); }
    .mobile-admin-card header,
    .mobile-admin-card footer,
    .mobile-admin-pager,
    .mobile-location-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .6rem;
    }
    .mobile-admin-card header > div { display: grid; gap: .15rem; min-width: 0; }
    .mobile-admin-card header a,
    .mobile-admin-card header strong { overflow-wrap: anywhere; }
    .mobile-admin-card header small { opacity: .66; font-size: .72rem; }
    .mobile-admin-card footer { justify-content: flex-start; flex-wrap: wrap; }
    .mobile-admin-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .45rem; }
    .mobile-admin-meta span {
        display: grid;
        gap: .08rem;
        padding: .45rem .55rem;
        border-radius: 5px;
        background: rgba(127,127,127,.09);
        min-width: 0;
        overflow-wrap: anywhere;
        font-size: .78rem;
    }
    .mobile-admin-meta strong { opacity: .65; font-size: .64rem; text-transform: uppercase; letter-spacing: .035em; }
    .mobile-location-counts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .mobile-location-counts span { text-align: center; }
    .mobile-location-counts strong { font-size: 1rem; opacity: 1; }
    .mobile-admin-code { display: block; overflow-wrap: anywhere; white-space: normal; color: var(--rz-primary); }
    .mobile-admin-note { margin: 0; font-size: .8rem; line-height: 1.4; opacity: .82; overflow-wrap: anywhere; }
    .mobile-admin-details { font-size: .78rem; }
    .mobile-admin-details summary { cursor: pointer; font-weight: 700; }
    .mobile-admin-limit { font-size: .74rem; opacity: .68; }
