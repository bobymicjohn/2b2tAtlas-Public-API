    /// <summary>Runs a batch enrichment pass and reports the outcome.</summary>
    private async Task RunEnrichment()
    {
        var priorRunId = enrichmentStatus?.Run.RunId;
        var priorWasRunning = enrichmentStatus?.Run.IsRunning == true;
        isRunningEnrichment = true;
        StateHasChanged();
        EnrichmentRunStatusDto? run = null;
        try
        {
            run = await EnrichmentService.RunAsync(new EnrichmentRunRequest
            {
                AutoApply = enrichAutoApply,
            });
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            // The status poll will recover automatically if the start reached the server but its response
            // was interrupted. Never leave the browser-local button spinner latched.
        }
        finally
        {
            isRunningEnrichment = false;
        }

        if (run is null)
        {
            Notify(NotificationSeverity.Error, "Enrichment failed", "The run could not be started.");
        }
        else
        {
            enrichmentStatus ??= new EnrichmentStatusDto();
            enrichmentStatus.Run = run;
            if (run.IsRunning)
            {
                var alreadyRunning = priorWasRunning && string.Equals(priorRunId, run.RunId, StringComparison.Ordinal);
                Notify(alreadyRunning ? NotificationSeverity.Warning : NotificationSeverity.Success,
                    alreadyRunning ? "Enrichment already active" : "Enrichment started",
                    alreadyRunning
                        ? "Another catalog run is already in progress. Its live status is shown below."
                        : "The server will continue processing even if you leave or refresh this page.");
            }
            else
            {
                Notify(NotificationSeverity.Warning, "Enrichment not started", run.Message ?? "The engine is unavailable.");
            }
        }
        StateHasChanged();
    }

    /// <summary>Polls server-owned run state so refreshes and other administrators see the same progress.</summary>
    private async Task PollEnrichmentAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                var wasRunning = enrichmentStatus?.Run.IsRunning == true;
                await Task.Delay(wasRunning ? TimeSpan.FromSeconds(3) : TimeSpan.FromSeconds(12), cancellationToken);
                EnrichmentStatusDto? latest;
                try
                {
                    latest = await EnrichmentService.GetStatusAsync();
                }
                catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
                {
                    continue;
                }
                if (latest is null) continue;

                var completed = wasRunning && !latest.Run.IsRunning;
                enrichmentStatus = latest;
                if (completed)
                {
                    enrichmentRevisions = await EnrichmentService.GetRevisionsAsync();
                    Notify(latest.Run.State == "completed" ? NotificationSeverity.Success : NotificationSeverity.Error,
                        latest.Run.State == "completed" ? "Enrichment complete" : "Enrichment stopped",
                        latest.Run.Message ?? "The catalog run ended.");
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

