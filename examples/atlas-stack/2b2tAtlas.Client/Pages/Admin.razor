    private async Task OnAttachmentsChanged(Location location, List<Atlas.Locations.Attachment> newAttachments)
    {
        try
        {
            var token = await AuthService.GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                await ShowErrorNotification("Authentication token not available");
                return;
            }

            HttpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            // Send the updated attachments to the server
            var response = await HttpClient.PutAsJsonAsync($"api/locations/{location.Rowid}/attachments", newAttachments);

            if (response.IsSuccessStatusCode)
            {
                await ShowSuccessNotification("Attachments updated successfully");

                // Update the local location object
                var locationIndex = locations.FindIndex(l => l.Rowid == location.Rowid);
                if (locationIndex >= 0)
                {
                    locations[locationIndex].Attachments = newAttachments;
                    StateHasChanged();
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error response: {error}");
                await ShowErrorNotification($"Failed to update attachments: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in OnAttachmentsChanged: {ex.Message}");
            await ShowErrorNotification($"An error occurred: {ex.Message}");
        }
    }

