    private async Task PollIngestionJobsAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        var ticks = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var changed = false;
                if (ingestionJobs.Any(job => job.Status is "queued" or "claimed" or "running"))
                {
                    await LoadIngestionJobs(false);
                    changed = true;
                }
                if (++ticks % 3 == 0)
                {
                    await LoadCollectorStatus(false);
                    await LoadBlueMapStatus(false);
                    changed = true;
                }
                if (changed) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

