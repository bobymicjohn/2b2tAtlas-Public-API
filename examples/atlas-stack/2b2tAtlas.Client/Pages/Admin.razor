    private async Task RefreshCurrentUser()
    {
        try
        {
            var token = await AuthService.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                HttpClient.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                var response = await HttpClient.GetAsync("api/auth/profile");
                if (response.IsSuccessStatusCode)
                {
                    currentUser = await response.Content.ReadFromJsonAsync<User>();

                    isAdmin = currentUser?.IsAdmin ?? false;

                    if (currentUser != null)
                    {
                        await LocalStorage.SetItemAsync("currentUser", currentUser);
                    }
                }
                else
                {
                    currentUser = await AuthService.GetCurrentUserAsync();
                }
            }
            else
            {
                currentUser = await AuthService.GetCurrentUserAsync();
            }
        }
        catch
        {
            currentUser = await AuthService.GetCurrentUserAsync();
        }
    }

    private Task ShowSuccessNotification(string message)
    {
        NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Success",
                Detail = message,
                Duration = 4000
            });

        return Task.CompletedTask;
    }

    private Task ShowErrorNotification(string message)
    {
        NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = message,
                Duration = 4000
            });

        return Task.CompletedTask;
    }

